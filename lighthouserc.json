{
  "$comment": "Lighthouse CI — warn-only until Phase 8 hardening flips these assertions to error at the blueprint §7.5 thresholds (≥95 performance, accessibility pass, ≥95 SEO).",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "categories:accessibility": ["warn", { "minScore": 1 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-report"
    }
  }
}
