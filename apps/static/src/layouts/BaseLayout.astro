---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/prose.css';
import '../styles/motion.css';
import '../styles/stations.css';
import SkipLink from '../components/SkipLink.astro';
import StationNav from '../components/StationNav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { ogSlugFor } from '../lib/og-cards';
import { personSchema } from '../lib/structured-data';
import type { StationId } from '../config/visual-world';

interface Props {
  title: string;
  description: string;
  /** Which station this page represents, for the nav's aria-current. */
  station?: StationId;
  /**
   * Set on the component-gallery route, which is excluded from search. Every
   * public page leaves it alone.
   */
  noindex?: boolean;
}

const { title, description, noindex = false, station } = Astro.props;

/*
 * Absolute URLs come from the configured production origin (blueprint §7.4),
 * never from the request. A canonical that varies by the host it was fetched
 * from is not a canonical.
 */
const origin = Astro.site;
if (!origin) {
  throw new Error(
    'BaseLayout: astro.config.mjs has no `site` configured, so canonical and Open Graph URLs ' +
      'cannot be absolute. Set it before building.',
  );
}

const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(`/og/${ogSlugFor(Astro.url.pathname)}.png`, origin).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0E14" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      /* A page excluded from discovery gets no share card. Emitting one would
         mean generating an image nobody can reach, and the machine-parity gate
         would rightly object to an og:image with no file behind it. */
      !noindex && (
        <Fragment>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Kishan Thorat" />
          <meta property="og:locale" content="en_GB" />
          <meta property="og:url" content={canonical} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${title} — Open Graph card`} />

          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage} />
        </Fragment>
      )
    }

    {/* Person, site-wide. Pages add their own node alongside it. */}
    <JsonLd data={personSchema(origin)} />
    {
      /*
        THE TWO FONTS ARE DELIBERATELY NOT PRELOADED.

        They were, and it cost the homepage its performance budget. `preload
        as="font"` fetches at High priority, so 88KB of Inter and JetBrains Mono
        left the wire in the same instant as the station plate — and the plate is
        the largest contentful element. On a simulated slow-4G link that is most
        of a second of contention for bytes that are not needed to paint
        anything, because both faces already declare `font-display: swap`: text
        is visible in the fallback from the first paint and swaps when the face
        arrives.

        Preloading a swap font buys a slightly earlier swap at the direct
        expense of LCP. Measured on the built output: dropping these took the
        homepage from 0.92 to a comfortable pass while FCP was unchanged, which
        is the correct trade for a page whose largest element is an image.

        Inter alone IS preloaded, below, and JetBrains Mono is not. Measured on
        the built output over three runs each: both preloaded scored 0.92,
        neither preloaded 0.96, Inter only 0.97. Inter sets the H1 and every
        line of body copy and is worth its 48KB on the critical path; JetBrains
        Mono sets eyebrows and labels at small sizes and is not.

        What this did NOT do is change CLS, and the first version of this comment
        claimed it did. Lighthouse reports 0.026 with or without either preload.
        Driving the built page in a real browser at 412x823, DPR 1.75, 1.6Mbps
        and 4x CPU throttling and reading `layout-shift` entries directly gives
        **0.0000 across zero entries**, so the residual is an artifact of
        Lighthouse's own emulation rather than a shift a visitor experiences. It
        is recorded rather than explained away, and it is inside the 0.05 budget
        either way.
      */
    }
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <script is:inline>
      /*
       * Reveal-on-scroll (blueprint §6). Inline and in <head> deliberately: a
       * deferred script would let content paint and then hide it, producing
       * exactly the flash that motion is supposed to prevent.
       *
       * It opts *in* to animation rather than out of it. A visitor who asked
       * for reduced motion, or a browser without IntersectionObserver, never
       * gets the `ready` attribute, so the CSS that hides content never
       * applies and the page simply renders. If observer setup throws, the
       * attribute is removed so content cannot be left hidden.
       */
      (function () {
        var root = document.documentElement;
        if (!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;
        /*
         * The root flag is `data-reveal-ready`, deliberately not `data-reveal`.
         * Sharing the name would make <html> itself match the `[data-reveal]`
         * selector the observer collects, so the root would be observed,
         * flipped to "in", and every reveal rule would stop matching. Caught
         * in a browser during Phase 3; see docs/PHASE_LOG.md.
         */
        root.dataset.revealReady = '';
        addEventListener('DOMContentLoaded', function () {
          try {
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  entry.target.dataset.reveal = 'in';
                  io.unobserve(entry.target);
                });
              },
              { rootMargin: '0px 0px -10% 0px' },
            );
            document.querySelectorAll('[data-reveal]').forEach(function (el) {
              io.observe(el);
            });
          } catch (error) {
            delete root.dataset.revealReady;
          }
        });
      })();
    </script>
  </head>
  <body>
    <SkipLink />
    <StationNav current={station} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      /*
       * Parallax and lazy plate loading. Loaded as a module so it defers by
       * default and never blocks first paint — and the page is complete
       * without it: no plate carries readable content, and every station is
       * fully laid out before this runs.
       */
      import { initVisualWorld } from '../scripts/visual-world';
      import { initLiveness } from '../scripts/liveness';
      initVisualWorld();
      /*
       * ONE measurement for the whole page. Every station instrument reads its
       * result rather than asking again — four readouts of one fact must not be
       * able to disagree with each other.
       */
      initLiveness();
    </script>
  </body>
</html>
