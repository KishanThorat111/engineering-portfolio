---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/prose.css';
import '../styles/motion.css';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { ogSlugFor } from '../lib/og-cards';
import { personSchema } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  /**
   * THIS LAYOUT KNOWS NOTHING ABOUT THE VISUAL WORLD, AND THAT IS THE FIX.
   *
   * The ten-station world was commissioned for the home page. It arrived here
   * instead: the station rail replaced `Header` for every route, `stations.css`
   * was imported in this frontmatter so its tokens loaded site-wide, and the
   * parallax and liveness scripts ran on the CV and on every case study. A
   * design meant for one page became the design of the site because it was
   * wired into the one file every page shares.
   *
   * Three separate mechanisms had to be undone, because each leaked on its own:
   *
   *   markup      the rail is now `<slot name="nav">`, whose FALLBACK is the
   *               ordinary `Header`. A page that supplies nothing gets the site
   *               it always had.
   *   stylesheet  `stations.css` is imported by the home page, not here. A bare
   *               import in layout frontmatter is unconditional — a boolean prop
   *               would have hidden the rail while still shipping its CSS.
   *   the import  even importing `StationNav` here was enough to drag its 26
   *               scoped rules into the shared stylesheet that every route
   *               downloads. Measured in the built output, not assumed. The slot
   *               means this file never names the component at all.
   *
   * There is deliberately no `world` boolean. A flag is something a future page
   * can set by accident; a slot is something a page has to hand content to.
   */
  /**
   * Set on the component-gallery route, which is excluded from search. Every
   * public page leaves it alone.
   */
  noindex?: boolean;
  /**
   * Whether this page declares itself canonical. True everywhere but the 404.
   *
   * `rel=canonical` means "this is the preferred URL for this content", which
   * every real page should say. The 404 is the one page that must not:
   * `wrangler.jsonc` sets `not_found_handling: "404-page"`, so that single file
   * is served at an unbounded number of addresses, and a self-canonical on it
   * tells a crawler the error page is a real destination — inviting /404/ into
   * the index. Dossier §15 has carried this as open since Phase 8.
   *
   * It is NOT tied to `noindex`: `/dev/components/` and the `/live/*` station
   * pages are noindex too, but each is one genuine destination a deep link
   * resolves to, and keeps its canonical.
   */
  canonical?: boolean;
}

const { title, description, noindex = false, canonical = true } = Astro.props;

/*
 * Absolute URLs come from the configured production origin (blueprint §7.4),
 * never from the request. A canonical that varies by the host it was fetched
 * from is not a canonical.
 */
const origin = Astro.site;
if (!origin) {
  throw new Error(
    'BaseLayout: astro.config.mjs has no `site` configured, so canonical and Open Graph URLs ' +
      'cannot be absolute. Set it before building.',
  );
}

const canonicalHref = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(`/og/${ogSlugFor(Astro.url.pathname)}.png`, origin).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0E14" />
    {canonical && <link rel="canonical" href={canonicalHref} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      /* A page excluded from discovery gets no share card. Emitting one would
         mean generating an image nobody can reach, and the machine-parity gate
         would rightly object to an og:image with no file behind it. */
      !noindex && (
        <Fragment>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Kishan Thorat" />
          <meta property="og:locale" content="en_GB" />
          <meta property="og:url" content={canonicalHref} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${title} — Open Graph card`} />

          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage} />
        </Fragment>
      )
    }

    {/* Person, site-wide. Pages add their own node alongside it. */}
    <JsonLd data={personSchema(origin)} />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <script is:inline>
      /*
       * Reveal-on-scroll (blueprint §6). Inline and in <head> deliberately: a
       * deferred script would let content paint and then hide it, producing
       * exactly the flash that motion is supposed to prevent.
       *
       * It opts *in* to animation rather than out of it. A visitor who asked
       * for reduced motion, or a browser without IntersectionObserver, never
       * gets the `ready` attribute, so the CSS that hides content never
       * applies and the page simply renders. If observer setup throws, the
       * attribute is removed so content cannot be left hidden.
       */
      (function () {
        var root = document.documentElement;
        if (!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;
        /*
         * The root flag is `data-reveal-ready`, deliberately not `data-reveal`.
         * Sharing the name would make <html> itself match the `[data-reveal]`
         * selector the observer collects, so the root would be observed,
         * flipped to "in", and every reveal rule would stop matching. Caught
         * in a browser during Phase 3; see docs/PHASE_LOG.md.
         */
        root.dataset.revealReady = '';
        addEventListener('DOMContentLoaded', function () {
          try {
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  entry.target.dataset.reveal = 'in';
                  io.unobserve(entry.target);
                });
              },
              { rootMargin: '0px 0px -10% 0px' },
            );
            document.querySelectorAll('[data-reveal]').forEach(function (el) {
              io.observe(el);
            });
          } catch (error) {
            delete root.dataset.revealReady;
          }
        });
      })();
    </script>
  </head>
  <body>
    <SkipLink />
    <slot name="nav"><Header /></slot>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
