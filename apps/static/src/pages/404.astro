---
/**
 * The not-found page, in the inner pages' language: the same opening as every
 * other route, so a mistyped address still lands somewhere that is plainly
 * this site, with the ways back as real controls rather than one small link.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title={`Page not found — ${SITE.name}`}
  description="This page does not exist. Navigation back to the portfolio."
  noindex
  canonical={false}
>
  <PageHero
    index="404"
    label="Not found"
    art={{ plate: 'end', focus: '62% 50%', focusNarrow: '66% 52%' }}
  >
    <Fragment slot="title">This page <em>doesn't exist.</em></Fragment>
    <p slot="lede">
      The address may be mistyped, or the page may not have shipped yet — this site is built in
      deployed phases.
    </p>
    <p class="ways">
      <Button href="/">Back to the start <span aria-hidden="true">→</span></Button>
      <Button href="/systems" variant="secondary">See the systems</Button>
    </p>
  </PageHero>
  <div class="spacer" aria-hidden="true"></div>
</BaseLayout>

<style>
  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .spacer {
    height: var(--space-16);
  }
</style>
