---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title={`Page not found — ${SITE.name}`}
  description="This page does not exist. Navigation back to the portfolio."
  noindex
  canonical={false}
>
  <section class="not-found">
    <div class="container">
      <p class="code">404</p>
      <h1>This page doesn't exist.</h1>
      <p class="hint">
        The address may be mistyped, or the page may not have shipped yet — this site is built in
        deployed phases.
      </p>
      <p><a href="/">Back to the start</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-24) var(--space-16);
  }

  /*
   * WCAG 2.2 AA, SC 2.5.8. This is the only way out of a 404 and it sat on a
   * 21px line box. The target grows with padding and the padding is undone with
   * an equal negative margin, so the hit area clears 24px and the layout does
   * not move.
   */
  .not-found a[href='/'] {
    display: inline-block;
    padding-block: 3px;
    margin-block: -3px;
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent-warm);
    margin-block-end: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .hint {
    margin-block-start: var(--space-4);
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .not-found p:last-child {
    margin-block-start: var(--space-6);
  }
</style>
