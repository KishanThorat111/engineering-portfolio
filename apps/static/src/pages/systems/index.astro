---
/**
 * /systems — the register.
 *
 * WHY THIS IS NOT THREE CARDS ANY MORE
 *
 * It was three tiles in a grid: title, status, one-line problem, stack, link.
 * Which is to say the page that the homepage's primary button leads to said
 * almost nothing the homepage had not already said, in a shape a visitor has
 * seen on every portfolio they have ever opened. Three equal tiles also assert
 * that the three systems are equivalent, and they are not — one runs in a
 * hospital, one takes money, one has no users at all.
 *
 * Each system now gets a full register entry: its number, its real status, the
 * sentence that says why it is interesting, its own measured figures, and —
 * the part no card grid can carry — the limitation it discloses about itself.
 *
 * PUTTING THE LIMITATION ON THE INDEX IS THE POINT.
 *
 * Every one of these already had a limitations section in its case study,
 * because constitution rule 3 requires it. Burying it three clicks in and
 * leading with a tidy card is how most portfolios would handle that
 * requirement. Surfacing it on the index — before a visitor has committed to
 * reading anything — is the single most distinguishing thing this page can do,
 * and it costs nothing but nerve. The text is the content collection's own,
 * unedited.
 *
 * Blueprint §4.4 still governs scope: the three platforms that get full case
 * studies, and no compact side-project cards mixed in.
 *
 * IN THE HOME PAGE'S LANGUAGE (Oct 2026). Every word above still holds; the
 * entries are now panels of the inner pages' glass, each lit in the colour its
 * island has on the home page, with the story on the left and its dated
 * figures stacked on the right.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import PlateImage from '../../components/PlateImage.astro';
import { SITE } from '../../config/site';
import { STATUS_LABELS } from '../../schemas/constitution';
import { SYSTEM_HUE, SYSTEM_ISLAND } from '../../config/system-hue';

const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);

const ordinal = (index: number) => String(index + 1).padStart(2, '0');
---

<BaseLayout
  title={`Systems — ${SITE.name}`}
  description="Three multi-tenant platforms, designed, built, and operated end to end: one in daily hospital production, one live with subscription billing, one pre-launch."
>
  <PageHero index="01" label="Systems" art={{ plate: 'systems', focus: '60% 42%' }}>
    <Fragment slot="title">Three platforms, one engineer, <em>no hand-offs</em></Fragment>
    <p slot="lede">
      Each of these was designed, built, secured, deployed, and then operated by me. Each case study
      says what it does, what it cost, and what is wrong with it — including the one running in a
      hospital with no test suite behind it.
    </p>
    <ul class="jump">
      {
        systems.map((system, index) => (
          <li>
            <a
              href={`#sys-${system.id}`}
              style={`--hue: ${SYSTEM_HUE[system.id] ?? 'var(--hue-blue)'}`}
            >
              <span class="jump-no">{ordinal(index)}</span>
              {system.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <div class="register">
    {
      systems.map((system, index) => {
        const status = STATUS_LABELS[system.data.status];
        const metrics = system.data.metrics.slice(0, 3);
        const limitation = system.data.limitations[0];
        const island = SYSTEM_ISLAND[system.id];
        return (
          <section
            class="entry"
            data-tone={status.tone}
            style={`--hue: ${SYSTEM_HUE[system.id] ?? 'var(--hue-blue)'}`}
            aria-labelledby={`sys-${system.id}`}
          >
            <div class="container">
              <div class="entry-card">
                {/* The system's own island from the home page's systems frame. */}
                {island && (
                  <PlateImage
                    id="systems"
                    sizes="(min-width: 1000px) 1150px, 170vw"
                    cx={island.cx}
                    cy={island.cy}
                    zoom={3.1}
                    class="entry-art"
                  />
                )}
                <div class="entry-main">
                  <p class="entry-status">
                    <span class="entry-no" aria-hidden="true">
                      {ordinal(index)}
                    </span>
                    <span class="entry-pill">
                      <span class="entry-dot" aria-hidden="true" />
                      {status.label}
                      {system.data.statusDetail ? ` · ${system.data.statusDetail}` : ''}
                    </span>
                  </p>

                  <h2 id={`sys-${system.id}`}>{system.data.title}</h2>
                  <p class="entry-problem">{system.data.problem}</p>

                  {/*
                    The disclosed limitation, verbatim from the collection. It is
                    marked in the fault colour and given a rule of its own, because
                    the register should not be able to show a system without
                    showing what is wrong with it.

                    A div, not an aside. It was an aside first, which made three
                    unnamed complementary landmarks on one page — html-validate
                    failed the build for it, correctly. A limitation a system
                    discloses about itself is not tangential to that entry; it is
                    the entry's most load-bearing sentence.
                  */}
                  <div class="entry-limit">
                    <p class="entry-limit-label">Disclosed limitation</p>
                    <p class="entry-limit-text">{limitation.limitation}</p>
                  </div>

                  <ul class="entry-stack">
                    {system.data.stack.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>

                  <p class="entry-go">
                    <Button href={`/systems/${system.id}`}>
                      Read the case study <span aria-hidden="true">→</span>
                    </Button>
                  </p>
                </div>

                {/* The system's own measured figures, each carrying its date. */}
                <dl class="entry-metrics">
                  {metrics.map((metric) => (
                    <div data-reveal>
                      <dt>{metric.caption}</dt>
                      <dd>
                        <span class="figure">{metric.value}</span>
                        <span class="when">{metric.qualifier}</span>
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  /* A quick index under the opening: the three systems, by number and colour. */
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border: var(--border-width) solid var(--glass-edge-strong);
    border-radius: 999px;
    background: var(--glass-bg);
    font-size: var(--text-sm);
    color: var(--text);
    transition: border-color var(--duration-micro) var(--ease-out);
  }

  /* A pill is identified by its outline, so it takes no link underline. */
  .jump a,
  .jump a:hover {
    background-image: none;
  }

  .jump a:hover {
    border-color: var(--hue);
  }

  .jump-no {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--hue);
  }

  .register {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-24);
  }

  .entry {
    scroll-margin-top: 5rem;
  }

  .entry[data-tone='accent'] {
    --tone: var(--signal);
  }

  .entry[data-tone='warm'] {
    --tone: var(--pending);
  }

  .entry[data-tone='muted'] {
    --tone: var(--text-faint);
  }

  /*
   * ONE PANEL PER SYSTEM, LIT IN ITS OWN COLOUR.
   *
   * Each system keeps the hue its island has on the home page as a soft light
   * in the panel's corner, along its top edge and on its number — the same
   * three systems, recognisably, from the front page to this one. The hue is
   * identity, not state: the status pill carries the state.
   */
  .entry-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-areas: 'art' 'main' 'metrics';
    gap: var(--space-8);
    padding: var(--space-8) var(--space-6);
    background: var(--glass-bg);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-xl);
  }

  .entry-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      60% 55% at 0% 0%,
      color-mix(in srgb, var(--hue) 11%, transparent),
      transparent 70%
    );
  }

  .entry-card::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--hue), transparent 60%);
    opacity: 0.8;
  }

  @media (min-width: 768px) {
    .entry-card {
      padding: var(--space-12);
    }
  }

  @media (min-width: 1000px) {
    .entry-card {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'main art' 'main metrics';
      gap: var(--space-6) var(--space-16);
      align-items: start;
    }
  }

  .entry-main {
    grid-area: main;
  }

  /*
   * THE ISLAND. The system's building from the home page's frame, framed and
   * lit in its own colour, so the three systems are recognisable by sight
   * from `/` to here. Decoration: the title beside it names the system.
   */
  .entry-card :global(.entry-art) {
    grid-area: art;
    aspect-ratio: 4 / 3;
    border: var(--border-width) solid color-mix(in srgb, var(--hue) 35%, transparent);
    border-radius: var(--radius-lg);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.03),
      0 30px 70px -40px color-mix(in srgb, var(--hue) 70%, transparent);
  }

  .entry-card :global(.entry-art)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 45%, transparent 55%, rgb(5 7 12 / 0.55));
    pointer-events: none;
  }

  @media (max-width: 999.98px) {
    .entry-card :global(.entry-art) {
      aspect-ratio: 16 / 10;
    }
  }

  .entry-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .entry-no {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--hue);
  }

  .entry-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.75rem;
    border: var(--border-width) solid var(--glass-edge-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--text);
  }

  .entry-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--tone);
  }

  .entry h2 {
    margin-block-start: var(--space-6);
    font-size: var(--text-mega);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 16ch;
  }

  /* The hook, at pull-quote scale — the sentence that says why this one is
     worth reading about. */
  .entry-problem {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--text-muted);
    max-width: 46ch;
  }

  /*
   * The limitation. Fault-coloured rule, not a fault-coloured block — this is
   * disclosure, not an error state, and colouring the whole panel red would
   * dramatise something that is here to be read plainly.
   */
  .entry-limit {
    margin-block-start: var(--space-8);
    padding: var(--space-4) var(--space-6);
    border-inline-start: 2px solid var(--fault);
    border-radius: 0 10px 10px 0;
    background: rgb(248 113 113 / 0.04);
    max-width: 64ch;
  }

  .entry-limit-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--fault);
  }

  .entry-limit-text {
    margin-block-start: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .entry-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .entry-stack li {
    padding: 0.3rem 0.65rem;
    border: var(--border-width) solid var(--glass-edge);
    border-radius: 6px;
    background: rgb(255 255 255 / 0.02);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .entry-go {
    margin-block-start: var(--space-8);
  }

  /* Figures stacked beside the story: number first, its date, then what it is. */
  .entry-metrics {
    grid-area: metrics;
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  @media (min-width: 640px) and (max-width: 999px) {
    .entry-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .entry-metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: var(--space-6);
    background: rgb(5 7 12 / 0.55);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-lg);
  }

  .entry-metrics dt {
    margin-block-start: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .entry-metrics dd {
    margin: 0;
  }

  .figure {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-metric);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
  }

  .when {
    display: block;
    margin-block-start: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
