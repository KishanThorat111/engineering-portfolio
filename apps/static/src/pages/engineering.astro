---
/**
 * /engineering — blueprint §4.5. The page where judgement is the content.
 *
 * Three things here appear exactly once on the whole site: the AI-assisted
 * ownership statement, and the two lessons. Repeating any of them would make
 * all three weaker.
 *
 * The six decision records are the same collection entries the case studies
 * render, selected by their `featured` flag — one source, two places, no way
 * for them to disagree (constitution rule 10).
 *
 * IN THE HOME PAGE'S LANGUAGE (Oct 2026). The inner pages' hero, numbered
 * sections, the principles as numbered panels of glass, and the ownership
 * statement as the one feature card on the page. Every word is unchanged.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import DecisionCard from '../components/DecisionCard.astro';
import PlateImage from '../components/PlateImage.astro';
import { SITE } from '../config/site';
import { PILLARS } from '../config/pillars';

const decisions = (await getCollection('decisions'))
  .filter((decision) => decision.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`How I work — ${SITE.name}`}
  description="Principles with evidence behind them, the architecture decisions that shaped three platforms, and two things I got wrong and what changed because of them."
>
  <PageHero
    index="03"
    label="How I work"
    art={{
      plate: 'think',
      focus: '66% 40%',
      focusNarrow: '74% 34%',
      alt: 'Kishan Thorat at his desk, working through an architecture drawing',
    }}
  >
    <Fragment slot="title">Judgement is the part <em>worth reading</em></Fragment>
    <p slot="lede">
      Anyone can list technologies. What is harder to fake is why a system is shaped the way it is,
      what each decision cost, and what happened the last time the call was wrong.
    </p>
  </PageHero>

  <!-- The five pillars, each with one concrete thing behind it. -->
  <section class="band">
    <div class="container">
      <SectionHeader
        index="01"
        kicker="Principles"
        title="Five things, and the evidence for each"
        emphasis="the evidence"
      />
      <ol class="pillars">
        {
          PILLARS.map((pillar, index) => (
            <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 240)}ms`}>
              <span class="pillar-no" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{pillar.title}</h3>
              <p class="pillar-line">{pillar.line}</p>
              <p class="pillar-evidence">{pillar.evidence}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The AI ownership statement. Its single appearance on the site. -->
  <section class="band">
    <div class="container">
      <SectionHeader index="02" kicker="Method" title="How AI fits into this" emphasis="AI" />
      <blockquote class="ownership" data-reveal>
        <p>
          I use AI tools to accelerate implementation; architecture, security, tenant isolation,
          compliance, and production operations are decisions I make and own.
        </p>
      </blockquote>
      <div class="prose body-copy narrow" data-reveal>
        <p>
          That is worth stating plainly rather than leaving to be inferred, because the obvious
          question about a timeline like mine is how much of it was typed by something else. The
          answer that matters is not how the code was written but who is accountable when it
          misbehaves at two in the morning — and for every system on this site, that is me.
        </p>
        <p>
          The evidence for the distinction is on the case-study pages: the decisions with their
          rejected alternatives, the limitations, and the parts that are wrong and still running.
          Those are not outputs. They are positions.
        </p>
      </div>
    </div>
  </section>

  <!-- Six decision records, rendered from the same entries the case studies use. -->
  <section class="band">
    <div class="container">
      <SectionHeader
        index="03"
        kicker="Decisions"
        title="Six calls worth defending"
        emphasis="worth defending"
      />
      <p class="section-note">
        Four are the recorded architecture decisions from the pre-launch platform; two are
        cross-cutting calls from the platforms already running. Each cites the document it came
        from.
      </p>
      <div class="decision-list">
        {
          decisions.map((decision, index) => (
            <div data-reveal style={`--reveal-delay: ${Math.min(index * 60, 180)}ms`}>
              <DecisionCard
                title={decision.data.title}
                decision={decision.data.decision}
                why={decision.data.why}
                tradeoff={decision.data.tradeoff}
                aged={decision.data.aged}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The two lessons. Rendered through the decision card, using its AGED row. -->
  <section class="band band--last">
    <div class="container">
      <SectionHeader index="04" kicker="Lessons" title="Two I got wrong" emphasis="got wrong" />
      {/* The lab from the home page's fifth frame: where the lessons were learned. */}
      <PlateImage
        id="lab"
        sizes="(min-width: 1120px) 1072px, 100vw"
        focus="50% 52%"
        class="lab-band"
      />
      <p class="section-note">
        Both of these are still true of systems described elsewhere on this site. They are here
        because a portfolio with no failures in it is not a portfolio of a person who has shipped
        anything.
      </p>
      <div class="decision-list">
        {
          lessons.map((lesson, index) => (
            <div
              class="lesson"
              data-reveal
              style={`--reveal-delay: ${Math.min(index * 60, 120)}ms`}
            >
              <DecisionCard
                title={lesson.data.title}
                decision={lesson.data.whatHappened}
                why={lesson.data.why}
                tradeoff={lesson.data.cost}
                aged={lesson.data.ruleChanged}
              />
              {lesson.data.crossLink && (
                <p class="cross-link">
                  <a href={lesson.data.crossLink.href}>{lesson.data.crossLink.label} →</a>
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .band {
    padding-block: var(--space-12);
  }

  @media (min-width: 768px) {
    .band {
      padding-block: var(--space-16);
    }
  }

  .band--last {
    padding-block-end: var(--space-24);
  }

  .section-note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
    margin-block-end: var(--space-8);
  }

  .narrow {
    max-width: var(--measure);
  }

  /*
   * THE PRINCIPLES, AS NUMBERED PANELS. Each number is set in the brand ramp,
   * as the home page sets its emphasis, and the evidence under each sits on a
   * violet rule — the record behind the principle.
   */
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Five panels: the last one takes the whole row rather than half of it. */
    .pillars > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .pillars > li {
    position: relative;
    padding: var(--space-6);
    background: var(--glass-bg);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-transition) var(--ease-out);
  }

  @media (min-width: 768px) {
    .pillars > li {
      padding: var(--space-8);
    }
  }

  .pillars > li:hover {
    border-color: var(--glass-edge-strong);
  }

  .pillar-no {
    display: block;
    margin-block-end: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--hue-violet);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .pillar-no {
      width: fit-content;
      background-image: var(--brand-ramp);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  @media (forced-colors: active) {
    .pillar-no {
      background: none;
      -webkit-text-fill-color: CanvasText;
    }
  }

  .pillars h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
  }

  .pillar-line {
    margin-block-start: var(--space-2);
    color: var(--text);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    max-width: var(--measure);
  }

  .pillar-evidence {
    margin-block-start: var(--space-4);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--hue-violet);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    max-width: var(--measure);
  }

  /*
   * THE ONE FEATURE CARD. The statement this page exists to make, framed in the
   * full brand ramp — the outline the home page gives its primary action.
   */
  .ownership {
    position: relative;
    margin: 0 0 var(--space-8);
    padding: var(--space-8);
    max-width: 52rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-xl);
    background:
      linear-gradient(rgb(12 14 24 / 0.96), rgb(12 14 24 / 0.96)) padding-box,
      var(--brand-ramp) border-box;
    box-shadow: 0 30px 80px -40px rgb(139 108 246 / 0.45);
  }

  @media (min-width: 768px) {
    .ownership {
      padding: var(--space-12);
    }
  }

  .ownership p {
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: var(--weight-medium);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .decision-list {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1040px) {
    .decision-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .lesson {
    display: flex;
    flex-direction: column;
  }

  /* A wide window onto the lab, framed like the home page's phone pictures. */
  .band :global(.lab-band) {
    aspect-ratio: 21 / 8;
    margin-block-end: var(--space-8);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-xl);
    box-shadow: 0 30px 80px -44px rgb(139 108 246 / 0.6);
  }

  .band :global(.lab-band)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 14 21 / 0.55), transparent 45%);
    pointer-events: none;
  }

  @media (max-width: 767.98px) {
    .band :global(.lab-band) {
      aspect-ratio: 16 / 10;
    }
  }

  .cross-link {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
  }

  .cross-link a {
    display: inline-block;
    padding-block: 4px;
    margin-block: -4px;
  }
</style>
