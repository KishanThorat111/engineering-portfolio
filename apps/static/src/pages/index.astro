---
/**
 * Home.
 *
 * WHY THIS PAGE LOOKS NOTHING LIKE IT DID
 *
 * Every section on this page used to be the same object: `.band` > `.container`
 * > `SectionHeader` > a grid > a link. Six of them in a row. The content
 * differed and the composition never did, so the page read as one component
 * repeated until it ran out of data — which is the definition of a template,
 * and no amount of colour or spacing work fixes it.
 *
 * Each section now has a shape that belongs to its content, hung off one
 * continuous spine (the indexed rule in the left margin, `.section` in
 * global.css):
 *
 *   —   opening      asymmetric, display type beside the live estate diagram
 *   —   rail         a full-bleed instrument strip of dated evidence
 *   01  live plane   an inset well containing a genuinely running system
 *   02  estate       a ledger of large numbered rows, not a card grid
 *   03  post         one editorial statement at pull-quote scale
 *   04  practice     a numbered manifest in type, no boxes at all
 *   05  closing      a single sentence at display size
 *
 * The collection-driven sections still render nothing while their collections
 * are empty (constitution rule 9), so content lights them up rather than edits
 * here.
 */
/*
 * THE WORLD'S STYLESHEET IS IMPORTED HERE, NOT IN THE LAYOUT.
 *
 * `stations.css` carries the world's material tokens — `--structure`,
 * `--ember`, `--plate-scrim`, `--plate-edge` — and the station shell. It was
 * imported by `BaseLayout`, which made it part of the stylesheet every route
 * loads: the CV and every case study downloaded and applied a design system
 * they never render. Astro bundles a page's frontmatter imports into that
 * page's own CSS, so importing it here confines it to `/`.
 *
 * It cannot be made conditional inside the layout. A bare `import` in
 * frontmatter runs whatever a prop says, so the flag would have hidden the rail
 * while still shipping its stylesheet — home-only in appearance and site-wide
 * in bytes.
 */
import '../styles/stations.css';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveEstatePanel from '../components/LiveEstatePanel.astro';
import SystemField from '../components/SystemField.astro';
import StationEnter from '../components/StationEnter.astro';
import StationJourney from '../components/StationJourney.astro';
import StationRail from '../components/StationRail.astro';
import { SITE, STATUS_CHIPS } from '../config/site';
import { PILLARS } from '../config/pillars';
import { STATUS_LABELS } from '../schemas/constitution';

const chips = (await getCollection('evidenceChips')).sort((a, b) => a.data.order - b.data.order);
const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

/** The current role snapshot is the most recent entry — blueprint §2 section 4. */
const currentRole = roles[0];

/*
 * Counted at build time from the repository, never asserted. These are the
 * figures station 01's metrics row carries in place of the reference's
 * invented throughput and uptime.
 */
const decisions = await getCollection('decisions');
const lessons = await getCollection('lessons');
const stationCounts = {
  systems: systems.length,
  decisions: decisions.length,
  /* Integration tests under services/api/test/integration, as of Aug 2026. */
  tests: 14,
  lessons: lessons.length,
  evidence: chips.length,
};

const title = `${SITE.name} — ${SITE.claim}`;

/** Blueprint §6: stagger entrances by no more than 60ms. */
const stagger = (index: number) => `--reveal-delay: ${Math.min(index * 60, 240)}ms`;

/** Ledger rows are numbered from one, in the margin, in mono. */
const ordinal = (index: number) => String(index + 1).padStart(2, '0');
---

<BaseLayout title={title} description={SITE.subline}>
  {
    /*
      NO NAV SLOT, DELIBERATELY — the home page takes the site's own header.

      It used to hand the layout a station rail: a ten-stop index of the frames
      below it, with a liveness pill where the site's navigation should be. That
      made the home page the one route on the site a visitor could not navigate
      FROM. The rail named the ten scenes of this page and nothing else — no
      Systems, no Engineering, no CV, no Contact — so arriving at the front door
      left you with a table of contents for one room.

      Supplying nothing takes the layout's fallback, which is the ordinary
      `Header` every other route has always used, and with it the footer the
      page already carried. The layout still never imports the rail; the slot
      being empty is what selects the default.

      The station index is not lost. Each stage keeps its own anchor, the live
      plane keeps its call to action, and station 10 draws the whole journey as
      a map.
    */
  }
  {
    /* ── OPENING ─────────────────────────────────────────────────────────
      Asymmetric and full-bleed. The claim takes the display tier and the
      estate sits beside it, so the assertion and the evidence for it arrive
      in the same screen rather than the evidence waiting below the fold. */
  }
  <StationEnter counts={stationCounts} />
  <StationJourney
    systems={systems}
    chips={chips}
    lessons={lessons}
    decisions={decisions}
    experience={roles}
    counts={stationCounts}
  />
  <StationRail />

  <script>
    /*
     * THE WORLD'S CLIENT CODE, ON THE WORLD'S PAGE.
     *
     * `initVisualWorld` drives the plate parallax; `initLiveness` makes ONE
     * request to /health and writes the result to <html data-liveness>, which
     * every instrument on this page reads so that four readouts of one fact
     * cannot disagree.
     *
     * Both were in `BaseLayout` and therefore ran on the CV, on /about and on
     * every case study — a parallax driver with no plates to drive, and a
     * liveness probe on pages that display no liveness. Astro bundles a page's
     * own `<script>` into that page, so this is the whole of the world's
     * JavaScript and it exists only at `/`.
     *
     * Deferred as a module, so it never blocks first paint. The page is complete
     * without it: no plate carries readable content, every station is laid out
     * by CSS, and the liveness readouts render their honest unmeasured state
     * from the server.
     */
    import { initVisualWorld } from '../scripts/visual-world';
    import { initLiveness } from '../scripts/liveness';
    initVisualWorld();
    initLiveness();
  </script>

  {
    /*
      The arrival choreography and the pointer light, as their own module so
      each inline script stays under the size at which the build would split it
      into a separate file — the home page loads no JavaScript files (§11).
    */
  }
  <script>
    import { initStageMotion } from '../scripts/stage-motion';
    initStageMotion();
  </script>
</BaseLayout>

<style>
  /* ── OPENING ───────────────────────────────────────────────────────── */
  .opening {
    padding-block: var(--space-16) var(--space-12);
  }

  @media (min-width: 900px) {
    .opening {
      padding-block: var(--space-24) var(--space-16);
    }
  }

  .opening-grid {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 900px) {
    .opening-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-16);
    }
  }

  /* The eyebrow is drawn with a rule running into it — the first mark of the
     schematic language the rest of the page is built on. */
  .opening-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
  }

  .opening-eyebrow .rule {
    width: 2.5rem;
    height: 1px;
    background: var(--border-strong);
  }

  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 15ch;
  }

  .subline {
    margin-block-start: var(--space-6);
    max-width: 56ch;
    color: var(--text-muted);
    font-size: var(--text-md);
  }

  /*
   * Mono, ruled between, no boxes. The evidence rail below already carries
   * bordered chips; repeating that shape here would make the page open with two
   * rows of the same object.
   */
  .opening-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }

  .opening-chips li + li::before {
    content: '·';
    margin-inline-end: var(--space-4);
  }

  .opening-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  /* ── EVIDENCE RAIL ─────────────────────────────────────────────────── */
  /*
   * Full-bleed and ruled top and bottom. It reads as instrumentation strapped
   * across the page rather than as another block of content.
   */
  .rail {
    border-block: var(--border-width) solid var(--border);
    background: var(--bg-inset);
    padding-block: var(--space-6);
  }

  .rail-inner {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 900px) {
    .rail-inner {
      grid-template-columns: auto 1fr;
      gap: var(--space-8);
    }
  }

  /*
   * The rail label takes the record colour. It is the register's fifth entry
   * and this is what it names: the written, cited, dated record — every chip
   * in this strip traces to a knowledge base or the CV, which is the one thing
   * that separates this row from a row of badges.
   */
  .rail-label {
    white-space: nowrap;
    color: var(--record);
  }

  .rail-items {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  /* ── SHARED SECTION OPENER ─────────────────────────────────────────── */
  .section-open {
    margin-block-end: var(--space-12);
  }

  .section-open .eyebrow {
    margin-block-end: var(--space-4);
  }

  .section-open h2,
  .closing h2 {
    font-size: var(--text-mega);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 20ch;
  }

  /* ── 02 · THE LEDGER ───────────────────────────────────────────────── */
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: var(--border-width) solid var(--border);
  }

  .ledger li {
    border-block-end: var(--border-width) solid var(--border);
  }

  /*
   * Each row carries its own status colour as --tone, so the register does the
   * work: green rows are running in production, amber is not launched yet.
   * Nothing else on the row is coloured.
   */
  .ledger li[data-tone='accent'] {
    --tone: var(--signal);
  }

  .ledger li[data-tone='warm'] {
    --tone: var(--pending);
  }

  .ledger li[data-tone='muted'] {
    --tone: var(--text-faint);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding-block: var(--space-8);
    padding-inline: var(--space-4);
    margin-inline: calc(var(--space-4) * -1);
    text-decoration: none;
    background-image: none;
    position: relative;
    transition: background-color var(--duration-transition) var(--ease-out);
  }

  @media (min-width: 768px) {
    .ledger-row {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-8);
      align-items: start;
    }
  }

  /* The row lights in its own status colour — a wash plus a leading edge. */
  .ledger-row::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 2px;
    background: var(--tone);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-transition) var(--ease-out);
  }

  .ledger-row:hover,
  .ledger-row:focus-visible {
    background-color: color-mix(in srgb, var(--tone) 6%, transparent);
  }

  .ledger-row:hover::before,
  .ledger-row:focus-visible::before {
    transform: scaleY(1);
  }

  .ledger-no {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-faint);
    padding-block-start: 0.35em;
  }

  .ledger-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .ledger-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-heading);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .ledger-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .ledger-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--tone);
  }

  .ledger-problem {
    display: block;
    margin-block-start: var(--space-4);
    max-width: 60ch;
    color: var(--text-muted);
    font-size: var(--text-md);
  }

  .ledger-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-block-start: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  /* Interpuncts between stack items, drawn rather than written so they are
     never read aloud as content. */
  .ledger-stack span + span::before {
    content: '·';
    margin-inline-end: var(--space-3);
  }

  .ledger-go {
    display: none;
  }

  @media (min-width: 768px) {
    .ledger-go {
      display: block;
      color: var(--text-faint);
      font-size: var(--text-lg);
      padding-block-start: 0.1em;
      transition:
        transform var(--duration-transition) var(--ease-out),
        color var(--duration-transition) var(--ease-out);
    }

    .ledger-row:hover .ledger-go,
    .ledger-row:focus-visible .ledger-go {
      color: var(--tone);
      transform: translateX(4px);
    }
  }

  /* ── 03 · THE POST ─────────────────────────────────────────────────── */
  .post-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .post-grid {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  .post-org {
    margin-block-start: var(--space-4);
    color: var(--text);
    font-size: var(--text-sm);
  }

  .post-dates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-block-start: var(--space-1);
  }

  .post-body h2 {
    font-size: var(--text-xl);
    letter-spacing: -0.015em;
  }

  /*
   * The lead runs at pull-quote scale. This is the one paragraph on the page
   * given that treatment, which is what makes it a moment rather than another
   * block of body copy.
   */
  .post-lead {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--text-muted);
    max-width: 44ch;
    text-wrap: pretty;
  }

  /* ── 04 · THE MANIFEST ─────────────────────────────────────────────── */
  .manifest {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .manifest li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-6);
    border-block-start: var(--border-width) solid var(--border);
  }

  @media (min-width: 900px) {
    .manifest li {
      grid-template-columns: 3rem minmax(0, 22ch) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: baseline;
      padding-block: var(--space-8);
    }
  }

  .manifest-no {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    grid-row: 1;
  }

  .manifest h3 {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
  }

  .manifest p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    grid-column: 2;
  }

  @media (min-width: 900px) {
    .manifest p {
      grid-column: 3;
      font-size: var(--text-base);
      max-width: 46ch;
    }
  }

  .section-link {
    margin-block-start: var(--space-8);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ── 05 · CLOSING ──────────────────────────────────────────────────── */
  .closing h2 {
    margin-block-start: var(--space-4);
    max-width: 16ch;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }
</style>
