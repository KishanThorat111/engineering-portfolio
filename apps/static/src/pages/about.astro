---
/**
 * /about — the career-transfer narrative, blueprint §1.
 *
 * What is deliberately NOT here: the AI-assisted ownership statement. Blueprint
 * §3.3 gives it exactly one appearance on the whole site, on /engineering, and
 * Phase 6 owns it. Repeating it here would weaken it in both places.
 *
 * IN THE HOME PAGE'S LANGUAGE (Oct 2026). The inner pages' hero, the story in
 * one reading column, and the facts a recruiter scans for — where, when, which
 * languages, how to reach me — in a glass card that stays beside it. Every
 * sentence is unchanged; the closing paragraph's two links had lost the spaces
 * before them to HTML compression ("them.The CV", "isa PDF"), and have them
 * back as explicit spaces.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import PlateImage from '../components/PlateImage.astro';
import JsonLd from '../components/JsonLd.astro';
import { profilePageSchema } from '../lib/structured-data';
import { SITE } from '../config/site';

const description =
  'How an electrical engineering degree, operations supervision, and teaching became a software career spent operating production systems.';

const facts = [
  { label: 'Based in', value: SITE.location },
  { label: 'Availability', value: SITE.availability },
  { label: 'Languages', value: SITE.languages.join(', ') },
];

const reach = [
  { label: 'Email', href: `mailto:${SITE.email}`, rel: undefined },
  { label: 'LinkedIn', href: SITE.linkedin, rel: 'me noopener' },
  { label: 'GitHub', href: SITE.github, rel: 'me noopener' },
];
---

<BaseLayout title={`About — ${SITE.name}`} description={description}>
  <Fragment slot="head">
    <JsonLd data={profilePageSchema(Astro.site!, '/about', `About ${SITE.name}`, description)} />
  </Fragment>

  <PageHero
    index="04"
    label="About"
    compact
    art={{
      plate: 'build',
      focus: '80% 42%',
      focusNarrow: '84% 38%',
      alt: 'Kishan Thorat looking out over a city at night',
    }}
  >
    <Fragment slot="title">
      I came to software from somewhere else, <em>and it shows in how I build.</em>
    </Fragment>
  </PageHero>

  <section class="band">
    <div class="container about-layout">
      <div class="body-copy prose story">
        <p>
          I studied electrical and electronics engineering, and then spent four years not writing
          software. I supervised operations, and I taught. Both left marks. Running operations is
          where I learned that a system is not finished when it works — it is finished when someone
          can keep it running on a bad day. Teaching is where the documentation habit came from: if
          you cannot explain a thing plainly, you do not yet understand it.
        </p>

        <p>
          I moved into software deliberately, over 2022 and 2023, not as a pivot away from something
          but towards this. The first work was freelance full-stack delivery for a UK company,
          building and shipping applications end to end. From November 2025 I have been delivering
          enterprise AI workflow automation for a UK client, on an operations platform used across
          their teams.
        </p>

        <p>
          Alongside that, since February 2026, I have designed, built, and run three multi-tenant
          SaaS platforms as the sole engineer on each: architecture, security, tenant isolation,
          payments, compliance, deployment, and the operations afterwards. One is in daily use
          inside a hospital. One takes real money through payment code I wrote and carry. One is
          pre-launch, and says so.
        </p>

        <p class="pull">
          That last part matters more to me than the count. Anyone can ship something. Staying on
          the hook for it — being the person who finds out first when it breaks — is a different
          job, and it is the one I have chosen.
        </p>

        <h2>Away from the keyboard</h2>
        <p>
          I speak four languages, and I competed in acrobatic yoga to national level, reaching the
          semi-finals of India's Got Talent in 2016 — which turns out to be decent training for
          staying composed while people watch you work. I also built an offline-capable donations
          app for my community's Ganesh Chaturthi festival, because the alternative was a
          spreadsheet and a lot of shouting.
        </p>
      </div>

      <aside class="side" aria-label="At a glance">
        {
          /*
           * THE PORTRAIT. This slot used to ask the owner for a headshot
           * photograph. On 3 Oct 2026 the owner asked for the picture of him
           * already in the site's artwork to be used here instead (PHASE_LOG
           * S11), so the card opens on him at his desk — the home page's
           * seventh frame, held on his face. src/components/Headshot.astro is
           * still the way to swap in a photograph if he supplies one.
           */
        }
        <div class="card">
          <PlateImage
            id="think"
            alt="Kishan Thorat"
            sizes="(min-width: 960px) 1150px, 170vw"
            cx={0.725}
            cy={0.36}
            zoom={3.2}
            class="card-photo"
          />
          <p class="card-mark" aria-hidden="true">KT</p>
          <p class="card-name">{SITE.name}</p>
          <p class="card-role">{SITE.role}</p>

          <dl class="facts">
            {
              facts.map((fact) => (
                <div class="fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>

          <ul class="reach">
            {
              reach.map((r) => (
                <li>
                  <a href={r.href} rel={r.rel}>
                    {r.label} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="band band--last">
    <div class="container">
      <div class="next" data-reveal>
        <SectionHeader kicker="Next" title="The engineering is the evidence" emphasis="evidence" />
        <p class="body-copy narrow">
          The systems above are described in full, including what is wrong with them.{' '}
          <a href="/cv">The CV</a> has the short version, and there is{' '}
          <a href="/cv.pdf" download>a PDF</a> if you would rather read it offline.
        </p>
        <p class="next-actions">
          <Button href="/systems">See the systems <span aria-hidden="true">→</span></Button>
          <Button href="/cv" variant="secondary">Read the CV</Button>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .band {
    padding-block: var(--space-12);
  }

  .band--last {
    padding-block-end: var(--space-24);
  }

  .about-layout {
    display: grid;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 960px) {
    .about-layout {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: var(--space-16);
    }
  }

  .story {
    font-size: var(--text-md);
    line-height: 1.75;
  }

  /* The paragraph the page turns on, given the weight it carries. */
  .pull {
    padding: var(--space-6);
    background: var(--glass-bg);
    border: var(--border-width) solid var(--glass-edge);
    border-inline-start: 2px solid var(--hue-violet);
    border-radius: var(--radius-lg);
    color: var(--text);
  }

  .story h2 {
    margin-block-start: var(--space-12);
    font-size: var(--text-xl);
    letter-spacing: -0.015em;
  }

  /* The card that stays beside the story on a wide screen. */
  @media (min-width: 960px) {
    .side {
      position: sticky;
      inset-block-start: 6rem;
    }
  }

  .card {
    position: relative;
    overflow: hidden;
    padding: var(--space-6);
    background: var(--glass-bg);
    background-image: radial-gradient(80% 60% at 0% 0%, rgb(76 134 255 / 0.12), transparent 70%);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-xl);
  }

  .card::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 2px;
    background: var(--brand-ramp);
  }

  /* The portrait across the head of the card, fading into it; the mark
     overlaps its foot as the header's mark sits on its bar. */
  .card :global(.card-photo) {
    aspect-ratio: 1 / 1;
    margin: calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) 0;
    background: transparent;
    mask-image: linear-gradient(to bottom, #000 62%, transparent);
  }

  .card-photo + .card-mark,
  .card :global(.card-photo) + .card-mark {
    position: relative;
    margin-block-start: -1.5rem;
  }

  .card-mark {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    background:
      linear-gradient(rgb(12 14 24), rgb(12 14 24)) padding-box,
      var(--brand-ramp) border-box;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .card-name {
    margin-block-start: var(--space-4);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .card-role {
    color: var(--hue-blue);
    font-size: var(--text-sm);
  }

  .facts {
    margin: var(--space-6) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-width) solid var(--glass-edge);
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .fact dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .reach {
    display: flex;
    flex-direction: column;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    list-style: none;
    border-block-start: var(--border-width) solid var(--glass-edge);
  }

  .reach a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 2.5rem;
    font-size: var(--text-sm);
    background-image: none;
    color: var(--text);
  }

  .reach a:hover {
    color: var(--hue-violet);
  }

  .next {
    position: relative;
    padding: var(--space-8);
    background: var(--glass-bg);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 768px) {
    .next {
      padding: var(--space-12);
    }
  }

  .next :global(.section-header) {
    margin-block-end: var(--space-6);
  }

  .narrow {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
  }
</style>
