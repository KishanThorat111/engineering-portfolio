---
/**
 * THE CHAPTER RAIL — where you are among the ten stations, and a way to jump.
 *
 * The home page is one continuous take of ten frames, and nothing told a
 * reader how far through it they were or let them go straight to the frame
 * they wanted. The references number every frame ("01 / ENTER", "02 /
 * SYSTEMS"…) along their top edge; the site header is the site's own
 * navigation and stays that way, so the station index lives here instead: a
 * slim rail on the right edge, wide composition only.
 *
 * It is plain links to each station's anchor, so it works with no script at
 * all. The motion script marks the station in view (`aria-current="location"`,
 * which is what a screen reader announces) and fills the rail up to it.
 */
const STATIONS = [
  { id: 'enter', name: 'Enter' },
  { id: 'systems', name: 'Systems' },
  { id: 'dissection', name: 'Dissection' },
  { id: 'data', name: 'Data' },
  { id: 'lab', name: 'Lab' },
  { id: 'live', name: 'Live' },
  { id: 'think', name: 'Think' },
  { id: 'contact', name: 'Build' },
  { id: 'proof', name: 'Proof' },
  { id: 'end', name: 'End' },
];
---

<nav class="chapters" aria-label="Stations on this page" data-chapters>
  <ol>
    {
      STATIONS.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-chapter={s.id}>
            <span class="chapters__name">{s.name}</span>
            <span class="chapters__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="chapters__tick" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .chapters {
    display: none;
  }

  @media (min-width: 1025px) {
    .chapters {
      display: block;
      position: fixed;
      z-index: 30;
      right: clamp(8px, 1vw, 18px);
      top: 50%;
      translate: 0 -50%;
      --done: 0;
    }

    .chapters ol {
      position: relative;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* The track, and the ramp filling it down to the station in view. */
    .chapters ol::before,
    .chapters ol::after {
      content: '';
      position: absolute;
      right: 7px;
      top: 12px;
      width: 1px;
      height: calc(100% - 24px);
      background: rgb(255 255 255 / 0.12);
    }

    .chapters ol::after {
      background: linear-gradient(var(--hue-blue), var(--hue-violet), var(--hue-ember));
      transform-origin: top;
      scale: 1 calc(var(--done) / 9);
      transition: scale 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .chapters a {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      min-height: 26px;
      padding-right: 1px;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      background-image: none;
      color: var(--text-muted);
    }

    .chapters__tick {
      position: relative;
      z-index: 1;
      width: 15px;
      height: 1px;
      background: rgb(255 255 255 / 0.35);
      transition:
        width 0.35s ease,
        background 0.35s ease;
    }

    .chapters__num,
    .chapters__name {
      opacity: 0;
      translate: 6px 0;
      transition:
        opacity 0.3s ease,
        translate 0.3s ease;
      white-space: nowrap;
      text-shadow: 0 0 8px rgb(3 5 10 / 0.95);
    }

    .chapters__name {
      padding: 3px 8px;
      border-radius: 4px;
      background: rgb(10 14 21 / 0.86);
      color: var(--text);
    }

    /* The station in view shows its number; hover or focus shows its name. */
    .chapters a[aria-current='location'] .chapters__num,
    .chapters a:hover .chapters__num,
    .chapters a:focus-visible .chapters__num,
    .chapters a:hover .chapters__name,
    .chapters a:focus-visible .chapters__name {
      opacity: 1;
      translate: 0 0;
    }

    .chapters a[aria-current='location'] {
      color: var(--text);
    }

    .chapters a[aria-current='location'] .chapters__tick {
      width: 26px;
      height: 2px;
      background: linear-gradient(90deg, var(--hue-blue), var(--hue-violet), var(--hue-ember));
    }

    .chapters a:hover .chapters__tick {
      width: 22px;
      background: var(--text);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapters *,
    .chapters ol::after {
      transition: none !important;
    }
  }
</style>
