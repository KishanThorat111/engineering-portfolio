---
/**
 * THE CHAPTER RAIL — where you are among the ten stations, and a way to jump.
 *
 * The home page is one continuous take of ten frames, and nothing told a
 * reader how far through it they were or let them go straight to the frame
 * they wanted. The references number every frame ("01 / ENTER", "02 /
 * SYSTEMS"…) along their top edge; the site header is the site's own
 * navigation and stays that way, so the station index lives here instead: a
 * slim rail on the left edge, wide composition only.
 *
 * LEFT, AND ONLY AS WIDE AS ITS TICKS. It sat on the right edge first, where
 * station 01 and station 04 hang labels to within a few pixels of the frame:
 * its ticks drew across "Redis 7" and "Row-level security", and each link's
 * box — tick, number and an invisible name, about 100px wide — caught the
 * pointer over those labels and opened a station name on top of them. Every
 * frame's left 4.8% is margin, so the rail lives there, its links are the
 * tick zone alone, and the number and name are drawn beside it only on
 * hover or keyboard focus, never taking space or a pointer.
 *
 * It is plain links to each station's anchor, so it works with no script at
 * all. The motion script marks the station in view (`aria-current="location"`,
 * which is what a screen reader announces) and fills the rail up to it.
 */
const STATIONS = [
  { id: 'enter', name: 'Enter' },
  { id: 'systems', name: 'Systems' },
  { id: 'dissection', name: 'Dissection' },
  { id: 'data', name: 'Data' },
  { id: 'lab', name: 'Lab' },
  { id: 'live', name: 'Live' },
  { id: 'think', name: 'Think' },
  { id: 'contact', name: 'Build' },
  { id: 'proof', name: 'Proof' },
  { id: 'end', name: 'End' },
];
---

<nav class="chapters" aria-label="Stations on this page" data-chapters>
  <ol>
    {
      STATIONS.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-chapter={s.id}>
            <span class="chapters__tick" aria-hidden="true" />
            <span class="chapters__label">
              <span class="chapters__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="chapters__name">{s.name}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .chapters {
    display: none;
  }

  @media (min-width: 1025px) {
    .chapters {
      display: block;
      position: fixed;
      z-index: 30;
      left: clamp(8px, 1vw, 18px);
      top: 50%;
      translate: 0 -50%;
      --done: 0;
    }

    .chapters ol {
      position: relative;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* The track, and the ramp filling it down to the station in view. */
    .chapters ol::before,
    .chapters ol::after {
      content: '';
      position: absolute;
      left: 7px;
      top: 12px;
      width: 1px;
      height: calc(100% - 24px);
      background: rgb(255 255 255 / 0.12);
    }

    .chapters ol::after {
      background: linear-gradient(var(--hue-blue), var(--hue-violet), var(--hue-ember));
      transform-origin: top;
      scale: 1 calc(var(--done) / 9);
      transition: scale 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* The link is the tick zone and nothing more: 32 × 26px, clear of 2.5.8. */
    .chapters a {
      position: relative;
      display: flex;
      align-items: center;
      width: 32px;
      min-height: 26px;
      text-decoration: none;
      background-image: none;
      color: var(--text-muted);
    }

    .chapters__tick {
      position: relative;
      z-index: 1;
      width: 15px;
      height: 1px;
      background: rgb(255 255 255 / 0.35);
      transition:
        width 0.35s ease,
        background 0.35s ease;
    }

    /* Drawn beside the tick on hover or focus; takes no space and no pointer. */
    .chapters__label {
      position: absolute;
      left: 34px;
      top: 50%;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 3px 9px;
      border-radius: 4px;
      background: rgb(10 14 21 / 0.9);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      translate: -6px -50%;
      transition:
        opacity 0.3s ease,
        translate 0.3s ease;
    }

    .chapters__name {
      color: var(--text);
    }

    .chapters a:hover .chapters__label,
    .chapters a:focus-visible .chapters__label {
      opacity: 1;
      translate: 0 -50%;
    }

    .chapters a[aria-current='location'] .chapters__tick {
      width: 26px;
      height: 2px;
      background: linear-gradient(90deg, var(--hue-blue), var(--hue-violet), var(--hue-ember));
    }

    .chapters a:hover .chapters__tick {
      width: 22px;
      background: var(--text);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapters *,
    .chapters ol::after {
      transition: none !important;
    }
  }
</style>
