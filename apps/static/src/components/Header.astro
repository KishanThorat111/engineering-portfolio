---
import { SITE } from '../config/site';

/*
 * Navigation carries only destinations that exist. Blueprint §2 specifies five
 * internal items — Systems · Experience · Engineering · About · CV — and they
 * join this list as their routes ship: About and CV in Phase 3, Systems in
 * Phase 5, Experience and Engineering in Phase 6. The constitution forbids
 * links to pages that do not exist, and the CI link gate enforces it.
 *
 * GitHub and LinkedIn were carried here in Phase 1 only because nothing
 * internal existed yet. Phase 1 recorded that they move to footer-only once
 * internal items land; that has now happened, and the footer still carries
 * both (blueprint §2 puts them there).
 */
/*
 * All five blueprint §2 items now exist, plus the live surface.
 *
 * `Live` is the sixth and is a deliberate addition rather than a restoration:
 * the 3D demonstration plane is the most unusual thing this site has, and until
 * now the only route to it was a link partway down the home page. A visitor who
 * landed on /about or a case study had no way to reach it at all.
 *
 * It is last on purpose — the five blueprint items are the site's spine and
 * keep their order — and it is a plain nav item rather than a highlighted call
 * to action, because the page it leads to labels itself a demonstration and the
 * nav should not oversell it (rule 11).
 */
const navLinks = [
  { label: 'Systems', href: '/systems' },
  { label: 'Experience', href: '/experience' },
  { label: 'Engineering', href: '/engineering' },
  { label: 'About', href: '/about' },
  { label: 'CV', href: '/cv' },
  { label: 'Live', href: '/live/' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">{SITE.name}</a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line class="bar-top" x1="4" y1="8" x2="20" y2="8"></line>
        <line class="bar-bottom" x1="4" y1="16" x2="20" y2="16"></line>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Site">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a class="contact-cta" href={`mailto:${SITE.email}`}>Contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--border-width) solid var(--border);
    background: var(--bg);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.5rem;
    position: relative;
  }

  .brand {
    color: var(--text);
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    padding: var(--space-2);
    cursor: pointer;
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }

  /*
   * WCAG 2.2 AA, SC 2.5.8 Target Size (Minimum).
   *
   * These are the site's primary navigation and they sat on a 17px line box —
   * under the 24px minimum on every page, at every width. They are standalone
   * controls in a list, not links inside a sentence, so the criterion's inline
   * exception does not apply to them.
   *
   * The target is grown with padding and the padding undone with an equal
   * negative margin, so the hit area clears 24px and the header does not move
   * by a pixel. `.contact-cta` already clears it through its own button
   * padding and is excluded so its filled background does not grow.
   */
  .site-nav a:not(.contact-cta) {
    /* inline-flex + min-width so short labels like "CV" also clear 24px wide. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    padding-block: 4px;
    margin-block: -4px;
  }

  .site-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--duration-micro) var(--ease-out);
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .contact-cta {
    display: inline-block;
    background: var(--accent);
    color: var(--bg) !important;
    font-weight: var(--weight-medium);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-4);
    transition: transform var(--duration-micro) var(--ease-out);
  }

  .contact-cta:active {
    transform: scale(0.98);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      background: var(--bg);
      border-block-end: var(--border-width) solid var(--border);
      padding: var(--space-4);
      z-index: 50;
    }

    .site-header[data-open] .site-nav {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }

    .site-nav a {
      display: block;
      padding: var(--space-3);
      font-size: var(--text-base);
      border-radius: var(--radius);
    }

    .site-nav a:hover {
      background: var(--bg-raised);
    }

    .contact-cta {
      text-align: center;
      margin-block-start: var(--space-2);
    }
  }
</style>

<script>
  // Mobile nav disclosure — the only client JS on the site in Phase 1.
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.hasAttribute('data-open'));
    });

    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // A resize past the breakpoint must not leave the panel stuck open.
    matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  }
</script>
