---
/**
 * Buttons — blueprint §5: primary (accent background, dark text) and secondary
 * (bordered). Radius 6px, 1px borders, no shadow.
 *
 * Renders an <a> when given an href and a <button> otherwise. A link that
 * navigates must never be a <button>: keyboard and screen-reader users rely on
 * the distinction, and the site's only interactive elements should behave
 * exactly as their semantics promise.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  download?: boolean;
  rel?: string;
}

const { href, variant = 'primary', type = 'button', download, rel } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class="button"
  data-variant={variant}
  href={href}
  rel={rel}
  download={download}
  type={href ? undefined : type}
>
  <slot />
</Tag>

<style>
  /*
   * THE HOME PAGE'S CALL TO ACTION, EVERYWHERE.
   *
   * The primary button was a filled blue slab — blue is the register's "live
   * in production", so a download button was borrowing a state it does not
   * have, and it looked like no other control on the site. It is now the
   * home page's own call to action: a dark plate with the brand ramp as its
   * outline, uppercase and tracked, lighting to the full ramp on hover. The
   * secondary is the same shape in plain glass.
   */
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: 0.8rem 1.4rem;
    border: var(--border-width) solid transparent;
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
    background-image: none;
    color: var(--text);
    cursor: pointer;
    transition:
      box-shadow var(--duration-micro) var(--ease-out),
      border-color var(--duration-micro) var(--ease-out);
  }

  .button[data-variant='primary'] {
    background:
      linear-gradient(rgb(8 10 17 / 0.94), rgb(8 10 17 / 0.94)) padding-box,
      linear-gradient(
          90deg,
          rgb(124 146 255 / 0.75),
          rgb(176 132 220 / 0.6) 55%,
          rgb(242 135 92 / 0.75)
        )
        border-box;
  }

  .button[data-variant='primary']:hover {
    background:
      linear-gradient(rgb(14 14 26 / 0.94), rgb(14 14 26 / 0.94)) padding-box,
      var(--brand-ramp) border-box;
    box-shadow: 0 0 24px rgb(139 108 246 / 0.28);
  }

  .button[data-variant='secondary'] {
    background: var(--glass-bg);
    border-color: var(--glass-edge-strong);
  }

  .button[data-variant='secondary']:hover {
    border-color: var(--text-muted);
  }

  @media (forced-colors: active) {
    .button {
      border-color: ButtonText;
    }
  }
</style>
