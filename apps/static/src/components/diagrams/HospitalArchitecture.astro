---
/**
 * Architecture diagram for the hospital housekeeping platform — hand-authored
 * SVG, redrawn from the knowledge base's own component diagram.
 *
 * Styling moved to the shared src/styles/diagrams.css in Phase 5, when three
 * more diagrams arrived and four copies of the same style block became four
 * chances to drift apart. Sizes are unchanged; re-measured after the move.
 *
 * The claim: everything hangs off one process, which is why the accent is
 * spent there and nowhere else.
 */
import ArrowMarker from './ArrowMarker.astro';
---

<svg
  class="dg"
  viewBox="0 0 300 372"
  role="img"
  aria-labelledby="arch-title arch-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="arch-title">Request path through the hospital housekeeping platform</title>
  <desc id="arch-desc">
    Browsers and QR scans reach a Caddy reverse proxy, which terminates TLS and forwards to a single
    Fastify process bound to localhost. That process authenticates the request, scopes every query
    to one organisation, and serves both the HTML pages and the JSON API. It reads and writes one
    PostgreSQL database, stores photographs in Cloudflare R2, and calls a configured AI provider
    only when a question cannot be answered from the database.
  </desc>

  <rect x="6" y="6" width="288" height="52" rx="6" class="dg-box"></rect>
  <text x="150" y="26" class="dg-label" text-anchor="middle">Browsers and QR scans</text>
  <text x="150" y="42" class="dg-sub" text-anchor="middle">admin · supervisor · patient</text>
  <text x="150" y="53" class="dg-sub" text-anchor="middle">nurse · worker — no account needed</text>

  <line x1="150" y1="58" x2="150" y2="76" class="dg-flow" marker-end="url(#hosp-arrow)"></line>

  <rect x="6" y="80" width="288" height="38" rx="6" class="dg-box"></rect>
  <text x="150" y="99" class="dg-label" text-anchor="middle">Caddy 2 — TLS, security headers</text>
  <text x="150" y="112" class="dg-sub" text-anchor="middle">the only route inward</text>

  <line x1="150" y1="118" x2="150" y2="136" class="dg-flow" marker-end="url(#hosp-arrow)"></line>

  <rect x="6" y="140" width="288" height="72" rx="6" class="dg-box dg-key"></rect>
  <text x="150" y="160" class="dg-label" text-anchor="middle">Fastify — one process, one VM</text>
  <text x="150" y="176" class="dg-sub" text-anchor="middle"
    >verify token → reload user → check org</text
  >
  <text x="150" y="188" class="dg-sub" text-anchor="middle"
    >every query scoped to one organisation</text
  >
  <text x="150" y="204" class="dg-sub" text-anchor="middle">serves the HTML pages and /api/*</text>

  <line x1="76" y1="212" x2="76" y2="238" class="dg-flow" marker-end="url(#hosp-arrow)"></line>
  <line x1="224" y1="212" x2="224" y2="238" class="dg-flow" marker-end="url(#hosp-arrow)"></line>

  <rect x="6" y="242" width="140" height="44" rx="6" class="dg-box"></rect>
  <text x="76" y="262" class="dg-label" text-anchor="middle">PostgreSQL 15</text>
  <text x="76" y="277" class="dg-sub" text-anchor="middle">localhost only</text>

  <rect x="154" y="242" width="140" height="44" rx="6" class="dg-box"></rect>
  <text x="224" y="262" class="dg-label" text-anchor="middle">Cloudflare R2</text>
  <text x="224" y="277" class="dg-sub" text-anchor="middle">photos, never public</text>

  <line
    x1="150"
    y1="212"
    x2="150"
    y2="316"
    class="dg-flow dg-flow-dashed"
    marker-end="url(#hosp-arrow)"></line>

  <rect x="6" y="320" width="288" height="46" rx="6" class="dg-box"></rect>
  <text x="150" y="339" class="dg-label" text-anchor="middle"
    >Vertex AI · Gemini · Azure OpenAI</text
  >
  <text x="150" y="355" class="dg-sub" text-anchor="middle"
    >reached only when SQL cannot answer</text
  >

  <ArrowMarker id="hosp-arrow" />
</svg>
