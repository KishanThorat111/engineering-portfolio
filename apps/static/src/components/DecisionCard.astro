---
/**
 * Decision card — blueprint §5: three labelled rows, DECISION / WHY /
 * TRADE-OFF, plus an optional AGED row used by the lessons treatment.
 *
 * Marked up as a description list because that is what it is: three terms and
 * their definitions. The labels are therefore real structure a screen reader
 * announces, not styled text that only looks like structure.
 */
interface Props {
  title: string;
  decision: string;
  why: string;
  tradeoff: string;
  /** How the decision looks with hindsight — the lessons treatment. */
  aged?: string;
  /** See SectionHeader: a prop named `as` breaks prop typing in this toolchain. */
  level?: 'h3' | 'h4';
}

const { title, decision, why, tradeoff, aged, level: Tag = 'h3' } = Astro.props;

const rows = [
  { label: 'Decision', value: decision },
  { label: 'Why', value: why },
  { label: 'Trade-off', value: tradeoff },
];
---

<article class="decision-card" data-aged={aged ? '' : undefined}>
  <Tag>{title}</Tag>
  <dl>
    {
      rows.map((row) => (
        <div class="row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
    {
      aged && (
        <div class="row row-aged">
          <dt>Aged</dt>
          <dd>{aged}</dd>
        </div>
      )
    }
  </dl>
</article>

<style>
  /*
   * GLASS, IN THE HOME PAGE'S LANGUAGE.
   *
   * It was --bg-raised with a 1px border — the card every dark template ships.
   * Now the inner pages' material (tokens.css, GLASS): translucent over the
   * page's ambient light, a hairline edge that brightens under the pointer,
   * and the brand ramp drawn along its top edge as the one mark of identity.
   * Only colour and shadow change on hover; nothing moves.
   */
  .decision-card {
    position: relative;
    height: 100%;
    padding: var(--space-6);
    background: var(--glass-bg);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--duration-transition) var(--ease-out),
      box-shadow var(--duration-transition) var(--ease-out);
  }

  .decision-card::before {
    content: '';
    position: absolute;
    inset-inline: var(--space-6);
    inset-block-start: -1px;
    height: 1px;
    background: var(--brand-ramp);
    opacity: 0.55;
  }

  .decision-card:hover {
    border-color: var(--glass-edge-strong);
    box-shadow: 0 24px 60px -34px rgb(76 134 255 / 0.45);
  }

  @media (min-width: 768px) {
    .decision-card {
      padding: var(--space-8);
    }

    .decision-card::before {
      inset-inline: var(--space-8);
    }
  }

  h3,
  h4 {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
    margin-block-end: var(--space-6);
  }

  dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .row {
    display: grid;
    gap: var(--space-1);
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: 7rem 1fr;
      gap: var(--space-4);
    }
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    padding-block-start: 0.2em;
  }

  dd {
    margin: 0;
    color: var(--text);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  /* The aged row is the admission, so it is set apart with the caution token
     rather than blended into the decision it revises. */
  .row-aged {
    border-block-start: var(--border-width) solid var(--glass-edge);
    padding-block-start: var(--space-4);
  }

  .row-aged dt {
    color: var(--accent-warm);
  }
</style>
