---
import { SITE } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <ul class="footer-links">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={SITE.github} rel="me noopener">GitHub</a></li>
    </ul>
    <p class="footer-note">
      Built and operated by {SITE.name} — <a href={SITE.repo} rel="noopener">source on GitHub</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-width) solid var(--border);
    padding-block: var(--space-8);
    margin-block-start: var(--space-24);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /*
   * WCAG 2.2 AA, SC 2.5.8 Target Size (Minimum): a control that is not inline
   * in a sentence needs a 24x24 CSS-pixel target. These links sit on a ~19px
   * line box, so the hit area is grown with padding and the padding is undone
   * with an equal negative margin — the target grows, the layout does not move
   * by a pixel. Links that genuinely sit inside a sentence are exempt under the
   * same criterion and are left alone.
   */
  .footer-links li a {
    display: inline-block;
    padding-block: 3px;
    margin-block: -3px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .footer-note {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
