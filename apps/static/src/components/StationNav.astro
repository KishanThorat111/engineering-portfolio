---
/**
 * THE PERSISTENT STATION INDEX — the references' numbered top rail.
 *
 * Replaces the previous text navigation. Every reference in the set carries
 * this exact object: a wordmark, ten numbered stations, and a status pill on
 * the right. It is the single strongest signal that the ten frames are one
 * world, so it is identical on every page and never restyled per section.
 *
 * REAL LINKS, NOT SCROLL HIJACKING.
 * The static site is a set of real pages. Each station points at a real route
 * or anchor, so the whole index works with JavaScript disabled, is keyboard
 * reachable in source order, and every station is deep-linkable — which is
 * what the approved navigation requires and what a scroll-jacked nav cannot
 * offer.
 */
import { STATIONS, type StationId } from '../config/visual-world';

interface Props {
  /** Which station this page represents, for aria-current. */
  current?: StationId;
}

const { current } = Astro.props;
---

<header class="station-nav">
  <a class="station-nav__mark" href="/">
    KT<span aria-hidden="true">.</span>
    <span class="visually-hidden">Kishan Thorat — home</span>
  </a>

  <nav class="station-nav__index" aria-label="Stations">
    <ol>
      {
        STATIONS.map((s) => (
          <li>
            <a
              class="station-nav__link"
              href={s.href}
              aria-current={s.id === current ? 'page' : undefined}
            >
              <span class="station-nav__num">{s.index}</span>
              <span class="station-nav__slash" aria-hidden="true">
                /
              </span>
              <span class="station-nav__label">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    /*
      THE STATUS PILL.

      Every one of the ten reference frames carries this object in the top right,
      reading SYSTEM STATUS / ALL SYSTEMS OPERATIONAL. The decomposition §3 table
      rules on it directly: that banner "must be derived, never asserted; if the
      live plane is down, this banner is the first thing that must say so."

      So it is derived. It renders as "not yet measured" from the server, and the
      one measurement the page makes moves it to responding or to not answering.
      It is never "all systems operational" as a decoration, and today — with the
      tunnel down — it is the first thing on the page that says so.
    */
  }
  <p class="station-nav__status">
    <span class="station-nav__status-dot" aria-hidden="true"></span>
    <span class="station-nav__status-label">Control plane</span>
    <span class="station-nav__status-value" data-live-value="state">not measured</span>
  </p>

  <a class="station-nav__cta" href="/cv">CV</a>
</header>

<style>
  .station-nav {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(0.875rem, 2vh, 1.25rem) var(--station-pad-x);
    border-bottom: 1px solid var(--border);
    /* Translucent over the world, like every panel. */
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(12px);
  }

  .station-nav__mark {
    flex: none;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }

  /* Structure, not a register colour: a wordmark carries no state. */
  .station-nav__mark span[aria-hidden] {
    color: var(--structure);
  }

  /*
   * THE TEN STATIONS COME FIRST WHEN SPACE RUNS OUT.
   *
   * The status pill was added to this rail after the index was laid out, and it
   * is `flex: none` — so at 1440 it took its width first and "10 / END" was
   * clipped off the end of the scroller. The index is the site's structure and
   * the pill is a readout; when they compete the structure wins the pixels.
   *
   * `flex: 1 1 auto` with `min-width: 0` lets the index take what is left after
   * the wordmark, the pill and the CV link, and it still scrolls rather than
   * wrapping when that is genuinely not enough.
   */
  .station-nav__index {
    flex: 1 1 auto;
    min-width: 0;
  }

  /*
   * THE RAIL NEVER WRAPS. IT SCROLLS.
   *
   * `flex-wrap: wrap` put "10 / END" alone on a second row at phone widths —
   * the index that is supposed to say "these ten frames are one world" was the
   * first thing on the page to fall apart, and it did so on the device most
   * visitors arrive on. Wrapping also changed the header's height between
   * breakpoints, which moves everything below it.
   *
   * A single non-wrapping row that scrolls horizontally keeps all ten in one
   * line at every width, keeps the header one fixed height, and keeps every
   * station reachable. Scroll-snap makes the numbers land cleanly rather than
   * stopping mid-glyph, and the scrollbar is hidden because the numbers
   * themselves are the affordance — a station index is not a document.
   */
  .station-nav__index ol {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(0.6rem, 1.6vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    /*
     * `contain: paint` stops this scroller's overflow propagating to the page.
     *
     * Giving each station link a 24px minimum target (SC 2.5.8) made the row's
     * content wider than its box, which is exactly what a horizontal scroller is
     * for — but the browser still grew the DOCUMENT's scrollWidth by 17px at
     * 390, so the whole page could be dragged sideways. `overflow-x: auto`
     * clipped the paint and not the propagation.
     *
     * Found by elimination in a real browser: `min-width: 0`, `max-width: 100%`,
     * `overflow: hidden` on the parent and disabling scroll-snap all left it at
     * 407px; `contain: paint` returned it to 390. The rail still scrolls and all
     * ten stations stay reachable — verified, not assumed.
     */
    contain: paint;
    /* Room for the focus ring of the first and last items. */
    padding-inline: 2px;
  }

  .station-nav__index ol::-webkit-scrollbar {
    display: none;
  }

  .station-nav__index li {
    flex: none;
    scroll-snap-align: start;
  }

  /*
   * WCAG 2.2 AA, SC 2.5.8 Target Size (Minimum).
   *
   * Below 720px the rail hides each station's word and shows only its number,
   * which left a 16x27px target — under the 24px minimum on the axis that
   * matters, and on the device where a finger is doing the tapping. The rail
   * scrolls horizontally, so widening each item costs nothing but scroll
   * distance.
   */
  .station-nav__link {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    gap: 0.3rem;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-out);
  }

  .station-nav__link:hover {
    color: var(--text-muted);
  }

  /*
   * "Where you are" is not one of the five registers and must not borrow one,
   * so the active station takes text colour plus a structure rule.
   */
  .station-nav__link[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--structure);
  }

  .station-nav__num {
    font-variant-numeric: tabular-nums;
  }

  .station-nav__slash {
    color: var(--text-faint);
  }

  .station-nav__status {
    flex: 0 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .station-nav__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    /* Unlit until measured — nothing glows without a reading behind it. */
    background: var(--text-faint);
  }

  /*
   * THE WIDTH IS RESERVED, AND THIS IS NOT A DETAIL.
   *
   * This pill is the one element on the page whose text is replaced by a network
   * result, and it sits in the header's flex row. Letting it resize when the
   * measurement lands moved the entire header — and because everything below a
   * shifted header counts as shifted, one 4.5px change in this pill measured
   * **CLS 0.178** against a 0.05 budget. It was the single layout shift on the
   * whole page.
   *
   * `em`, NOT `ch`, and that distinction is the whole fix. `ch` is the advance
   * width of "0" IN THE CURRENT FACE, so a `ch`-based reservation is re-measured
   * when the font swaps — and JetBrains Mono is deliberately not preloaded, so it
   * always swaps. The first version of this used 12ch and the shift survived
   * untouched at 0.178, because the box it reserved changed size at exactly the
   * moment it was supposed to be holding still.
   *
   * `em` resolves against font-size, which is fixed here, so the reservation is
   * the same box before and after the swap. 7.6em holds the longest state this
   * can carry ("not answering") at this size; every shorter state sits inside it.
   * The arrival of a real reading now changes a colour and a word, and moves
   * nothing.
   */
  .station-nav__status-value {
    display: inline-block;
    min-width: 7.6em;
  }

  :global(:root[data-liveness='live']) .station-nav__status-dot {
    background: var(--signal);
    box-shadow: 0 0 8px var(--signal);
  }

  :global(:root[data-liveness='live']) .station-nav__status-value {
    color: var(--signal);
  }

  :global(:root[data-liveness='down']) .station-nav__status-dot {
    background: var(--fault);
  }

  :global(:root[data-liveness='down']) .station-nav__status-value {
    color: var(--fault);
  }

  .station-nav__cta {
    flex: none;
    /* SC 2.5.8: "CV" is a 16x19px target on its own. */
    display: inline-flex;
    align-items: center;
    min-width: 24px;
    min-height: 24px;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--text-faint);
    text-underline-offset: 5px;
  }

  .station-nav__cta:hover {
    text-decoration-color: var(--signal);
  }

  /* Below 720px the ten labels cannot fit; the numbers alone still navigate,
     and each link keeps its accessible name from the visually-hidden label. */
  /*
   * The pill keeps its label only where there is genuinely room for it.
   *
   * Measured at 1440: the index needs 967px and was being given 923px, so
   * "10 / END" fell off the end of the scroller — the last station, the one
   * that closes the arc, was the one that disappeared. The label costs about
   * 94px and the shortfall was 44px, so dropping it below 1600 gives the ten
   * stations room at every width a laptop actually has.
   *
   * Nothing about the STATE is dropped: the dot carries its colour and the
   * value still reads "live" or "no answer" in words. Only the word
   * "control plane" goes, and a status pill in a navigation rail is not
   * ambiguous about what it is describing.
   */
  @media (max-width: 1600px) {
    .station-nav__status-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (max-width: 720px) {
    .station-nav__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .station-nav__slash {
      display: none;
    }

    .station-nav__index ol {
      gap: 0.75rem;
    }

    /*
     * The pill keeps its dot and its reading and loses only the word "control
     * plane", which the dot's colour and the reading already carry. The state
     * itself is never dropped: a phone is exactly where a visitor is most
     * likely to be told a system is fine when it is not.
     */
    .station-nav__status-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .station-nav__status {
      padding-inline: 0.45rem;
    }
  }
</style>
