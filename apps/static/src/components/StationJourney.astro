---
/**
 * STATIONS 02–10 — the rest of the reference world, on the fixed-ratio stage.
 *
 * Each station is a `Stage` locked to the plate's 3:2 ratio with its overlay
 * positioned in percentages of that frame, so a label naming a thing in the
 * artwork keeps naming it at every width. Below 1024px each one swaps to a
 * separate stacked composition rather than shrinking the cinematic one.
 *
 * WHAT EACH REFERENCE CONTRIBUTES, AND WHAT REPLACED ITS INVENTED FIGURES
 * The decomposition's §3 table ruled on every number baked into the artwork.
 * The compositions survive intact; the contents are repository facts.
 *
 *   02 SYSTEMS     three real systems with real statuses. The reference's
 *                  "12 Services Online", "TOTAL REGIONS 7" and "TOTAL SERVICES
 *                  128" are cut — rule 4, an unpublished figure is unpublished.
 *   03 DISSECTION  the layer stack of the flagship, with the case study's own
 *                  six sections as the index. "KUBERNETES" and "AMS AP-SOUTH-1"
 *                  are replaced by what this system actually runs on.
 *   04 DATA        one request path. No per-hop timings, because none are
 *                  measured; one measured total, in the reader's own browser.
 *   05 LAB         what did not work. The reference's FPS 119 / PARTICLES 15.4M
 *                  telemetry is cut entirely and the two written-up lessons
 *                  take the frame.
 *   06 LIVE        the control room, and the globe problem resolved in the open.
 *   07 THINK       the five pillars in the reference's numbered treatment, and
 *                  an empty chair where the reference has a generated face.
 *   08 BUILD       availability and contact. STATE: UNDEFINED, which is true.
 *   09 PROOF       the archive, counted at build time. Two-digit real numbers,
 *                  which the decomposition explicitly tells this station to be
 *                  designed for rather than the reference's fabricated 14.6K.
 *   10 END         the closing line, and the ten stations named on one map.
 */
import Stage from './stage/Stage.astro';
import Callout from './stage/Callout.astro';
import Panel from './stage/Panel.astro';
import Chip from './stage/Chip.astro';
import MetricCard from './stage/MetricCard.astro';
import Donut, { type Slice } from './stage/Donut.astro';
import RankedList, { type Row } from './stage/RankedList.astro';
import Feed, { type Entry } from './stage/Feed.astro';
import StageTimeline, { type Stage as TLStage } from './stage/StageTimeline.astro';
import FlowDiagram from './stage/FlowDiagram.astro';
import DecisionTree from './stage/DecisionTree.astro';
import Inspector from './stage/Inspector.astro';
import DissectionIndex from './stage/DissectionIndex.astro';
import Legend from './stage/Legend.astro';
import StatusBar from './stage/StatusBar.astro';
import Note from './stage/Note.astro';
import StatRow, { type Stat } from './stage/StatRow.astro';
import TraceRail, { type Hop } from './stage/TraceRail.astro';
import { SITE } from '../config/site';
import { PILLARS } from '../config/pillars';
import { STATUS_LABELS } from '../schemas/constitution';
import type { CollectionEntry } from 'astro:content';

interface Props {
  systems: CollectionEntry<'systems'>[];
  experience: CollectionEntry<'experience'>[];
  chips: CollectionEntry<'evidenceChips'>[];
  lessons: CollectionEntry<'lessons'>[];
  decisions: CollectionEntry<'decisions'>[];
  counts: { systems: number; decisions: number; tests: number; lessons: number; evidence: number };
}

const { systems, chips, lessons, decisions, experience, counts } = Astro.props;

/*
 * Status to register entry.
 *
 * `undefined` for CONFIDENTIAL is deliberate and is the rule rather than a gap:
 * a panel gets a state dot only when it is carrying a state, and "confidential"
 * describes what may be said about a system, not what the system is doing. The
 * previous mapping sent it to `--structure`, which is a material token and not a
 * register entry — colouring a state dot with it would have been exactly the
 * confusion §3.4 forbids.
 */
type Register = 'signal' | 'pending' | 'isolation' | 'record' | 'fault';
const TONE: Record<string, Register | undefined> = {
  IN_PRODUCTION_HOSPITAL: 'signal',
  LIVE: 'signal',
  PRE_LAUNCH: 'pending',
  CONFIDENTIAL: undefined,
};

/** The sections a case study actually has, so each is a real destination. */
const DISSECTION = [
  { index: '01', label: 'Problem' },
  { index: '02', label: 'Architecture' },
  { index: '03', label: 'Data flow' },
  { index: '04', label: 'Security' },
  { index: '05', label: 'Deployment' },
  { index: '06', label: 'Impact' },
] as const;

/*
 * Counted, not claimed. Every one of these is a `length` over a collection or a
 * directory in this repository, and the decomposition measured the same set on
 * 22 Aug 2026 precisely so that the panels could be designed for two-digit
 * numbers instead of the reference's fabricated thousands.
 */
const ARCHIVE = [
  { label: 'Systems', value: counts.systems },
  { label: 'Decisions', value: counts.decisions },
  { label: 'Evidence', value: counts.evidence },
  { label: 'Lessons', value: counts.lessons },
  { label: 'Integration tests', value: counts.tests },
] as const;

/** The three statuses, derived rather than typed out. */
const live = systems.filter(
  (s) => s.data.status === 'IN_PRODUCTION_HOSPITAL' || s.data.status === 'LIVE',
).length;
const prelaunch = systems.filter((s) => s.data.status === 'PRE_LAUNCH').length;

/** The flagship, for station 03's dissection. Falls back to the first entry. */
const flagship = systems.find((s) => s.id === 'hospital-operations') ?? systems[0];

/*
 * STATION 02'S ESTATE RING.
 *
 * The reference's bottom-right panel carries SYSTEMS OVERVIEW: 3 Primary
 * Systems / 12 Services Online over a faint world map. §3 ruled on both: the
 * three is real and publishable, the twelve is not, and no region is published
 * anywhere on this site, so there is no map to draw.
 *
 * The ring is drawn from the one split that IS real and IS checkable — how many
 * of the platforms are in production and how many are pre-launch — with the
 * cut figures named in the panel rather than quietly omitted.
 */
const ESTATE_MIX: Slice[] = (
  [
    { label: 'In production', value: live, tone: 'signal' },
    { label: 'Pre-launch', value: prelaunch, tone: 'pending' },
  ] satisfies Slice[]
).filter((sl) => sl.value > 0);

/*
 * THE SHARED PATTERN.
 *
 * The reference labels this corner ENGINEERING CORE / "Shared foundations
 * powering all systems", which is a claim about shared infrastructure and is
 * false: the three platforms run separately, on separate machines, for separate
 * organisations. What is genuinely shared is the ORDER a new platform is built
 * in, which is a sequence, which is exactly what a stage rail draws.
 *
 * Every stage here is a decision recorded in this repository, so each one is
 * `done` because it has actually been applied — not because a pipeline reported
 * success.
 */
/*
 * THE DISCLOSED LIMITATIONS, ON THE FRAME THAT PROMISES THEM.
 *
 * Station 02's lede says every system below "discloses the thing it does worst,
 * before you read anything else about it". That promise was made on this frame
 * and kept somewhere else — the reader had to open a case study to see a single
 * one. A claim the page makes about itself and does not show is the weakest
 * kind of copy there is.
 *
 * So the first disclosed limitation of each system is printed here, VERBATIM.
 * Not summarised and not trimmed to fit: these sentences carry their own date
 * qualifiers and their own precision, and a shortened limitation is a softened
 * one. If they do not fit, the panel gets bigger.
 */
const DISCLOSED: Entry[] = systems.slice(0, 3).flatMap((system) => {
  const first = system.data.limitations?.[0];
  return first
    ? [
        {
          stamp: system.data.title,
          text: first.limitation,
          meta: STATUS_LABELS[system.data.status].label,
          tone: TONE[system.data.status] ?? 'structure',
          href: `/systems/${system.id}`,
        } satisfies Entry,
      ]
    : [];
});

/*
 * WHY THE LESSONS HAPPENED — the field this frame never published.
 *
 * Each lesson records what happened, what it cost, what changed, AND why it
 * happened in the first place. The first three are on the record panels; the
 * fourth is the analytical one, and it is the reason the collection is worth
 * reading rather than just honest. It gets its own panel.
 */
const LESSON_CAUSES: Entry[] = lessons.slice(0, 2).map((lesson) => ({
  stamp: lesson.data.title,
  text: lesson.data.why,
  href: '/engineering#lessons',
}));

/*
 * THE CAREER TIMELINE reference 07 specifies, from the experience collection
 * rather than from a written-out list. Every role, organisation and date here
 * is a field in a record that /cv and the machine layer read from the same
 * place, so the three cannot disagree (rule 10).
 *
 * `state` is what is TRUE of each row, not a decoration: the role being worked
 * now is `pending` because it is still running, and a finished one is `done`
 * because it finished. Nothing is marked `failed`, because nothing was.
 */
const CAREER: TLStage[] = [...experience]
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((role) => {
    /*
     * The current role's `to` is the STRING "Present", not an absent value, so
     * a truthiness test marked it finished and both rows rendered as done. A
     * role still being worked is `pending` — the register is meant to say what
     * is true of the thing it marks, and "done" on a job someone is doing today
     * is simply wrong.
     */
    const ongoing = !role.data.to || /^present$/i.test(role.data.to.trim());
    return {
      name: role.data.role,
      detail: `${role.data.organisation} · ${role.data.from} – ${role.data.to ?? 'present'}`,
      state: ongoing ? ('pending' as const) : ('done' as const),
    };
  });

/*
 * THE CLOSING FRAME'S ROUTES OUT.
 *
 * Station 10 asked "What's next?", offered one link, and left the bottom half
 * of the frame empty. A closing frame whose job is to send the reader somewhere
 * should name the places, and each of these is a page that exists on this site
 * with the thing described actually on it.
 */
const ROUTES: Entry[] = [
  {
    stamp: 'The register',
    text: 'Every system, with what it does worst stated before anything it does well.',
    href: '/systems',
  },
  {
    stamp: 'The engineering record',
    text: 'The decisions, what each one cost, and the lessons that changed the next system.',
    href: '/engineering',
  },
  {
    stamp: 'The live plane',
    text: 'A real tenant in a real multi-tenant system, and an invitation to attack it.',
    href: '/live/',
  },
  {
    stamp: 'The CV',
    text: 'Roles, dates and scope, in the form a hiring engineer reads first.',
    href: '/cv',
  },
];

/*
 * STATION 02'S STACK LABELS, DERIVED RATHER THAN WRITTEN.
 *
 * Reference 02 rings its core and its islands with small labels — WORKFLOWS,
 * STAFF, ROOMS, TICKETS, SUBSCRIPTIONS — most of them invented product
 * features. The composition is right and the words are not ours to use.
 *
 * What the repository does state, for every system, is its stack. So the
 * labels around the CORE are the items all three systems declare (computed as
 * the intersection, so a system that drops one removes it here), and the labels
 * beside each ISLAND are what only that system declares. Nothing on the frame
 * is typed by hand.
 */
const stackOf = (s: CollectionEntry<'systems'>) => [...(s.data.stack ?? [])];
const STACK_SHARED = systems.length
  ? stackOf(systems[0]).filter((item) => systems.every((s) => stackOf(s).includes(item)))
  : [];
const stackOwn = (s: CollectionEntry<'systems'>) =>
  stackOf(s).filter((item) => !STACK_SHARED.includes(item));

/*
 * Where each system's card and own labels hang, measured off the rendered plate
 * with a percentage grid: the hospital island spans x 34-55% / y 10-33%, the
 * menu island x 63-84% / y 14-34%, the electrical island x 63-85% / y 53-74%,
 * and the core ring is centred at x 58.5% / y 42%. Cards go BESIDE islands.
 */
const ISLAND: Record<
  string,
  { hue: string; card: [number, number, number]; chips: [number, number][] }
> = {
  'hospital-operations': {
    hue: 'blue',
    card: [26, 9.5, 8.2],
    chips: [
      [42, 6.6],
      [52.5, 7.6],
    ],
  },
  'menu-platform': {
    hue: 'ember',
    card: [86.4, 9.5, 10.6],
    chips: [
      [68.5, 9.8],
      [78.5, 10.6],
    ],
  },
  'electrical-platform': {
    hue: 'violet',
    card: [86.4, 59, 10.6],
    chips: [
      [58.6, 61.6],
      [59.6, 66.4],
    ],
  },
};

/* The shared stack's places around the core: two on each side of the ring. */
const CORE_CHIPS: [number, number][] = [
  [44.2, 38.4],
  [43.6, 44.6],
  [72.4, 38.4],
  [72, 47],
];

/* The five patterns, as name/value rows for the bottom panel. */
const PATTERN_ROWS = [
  { label: 'Tenancy', value: 'Multi-tenant from the first migration' },
  { label: 'Shape', value: 'A modular monolith, not services' },
  { label: 'Isolation', value: 'Row-level security in the database' },
  { label: 'Record', value: 'An audit row for every write' },
  { label: 'Limit', value: 'The worst behaviour written down' },
];

const PATTERNS: TLStage[] = [
  { name: 'Tenancy', detail: 'multi-tenant from the first migration', state: 'done' },
  { name: 'Shape', detail: 'a modular monolith, not services', state: 'done' },
  { name: 'Isolation', detail: 'row-level security in the database', state: 'done' },
  { name: 'Record', detail: 'an audit row for every write', state: 'done' },
  { name: 'Limit', detail: 'the worst behaviour written down', state: 'done' },
];

/** The layer stack of the flagship. Real architecture, from its own case study. */
/*
 * STATION 03'S LAYER LABELS, ON THE SLABS THEY NAME.
 *
 * Measured off the rendered plate with a percentage grid (Oct 2026), once the
 * whole stack was visible again. `x` is where the slab's own edge is: upper
 * layers are named from the LEFT margin, their rule running into the slab's
 * left edge; the two lowest tiers are wider than the frame's left column
 * allows, so they are named from their RIGHT edge, reading outward. That
 * zig-zag is also what keeps the left of the frame free for the decisions.
 */
const LAYERS = [
  {
    x: 35.4,
    y: 11.2,
    side: 'right',
    label: 'Client',
    lines: ['Web and mobile browsers', 'QR entry, no account needed'],
  },
  {
    x: 35.4,
    y: 21.4,
    side: 'right',
    label: 'Edge',
    lines: ['Caddy, TLS termination', 'Security boundary'],
  },
  {
    x: 36.4,
    y: 31.6,
    side: 'right',
    label: 'API',
    lines: ['Fastify routes', 'Auth, rate limit, routing'],
  },
  {
    x: 32.6,
    y: 43.4,
    side: 'right',
    label: 'Services',
    lines: ['Feature modules', 'One process, one database'],
  },
  {
    x: 74.6,
    y: 63.2,
    side: 'left',
    label: 'Data',
    lines: ['PostgreSQL', 'Tenant-scoped by policy'],
  },
  {
    x: 82.8,
    y: 76.4,
    side: 'left',
    label: 'Observability',
    lines: ['OpenTelemetry', 'Spans, logs, audit records'],
  },
] as const;

/*
 * STATION 03'S DECISIONS.
 *
 * The frame's own lede ends "Understand the decisions." and then showed the
 * reader none. The flagship has four architecture records in this repository,
 * each one with the field most such records leave out — what the choice cost —
 * so the frame prints the choice and the cost together and links to the full
 * record.
 *
 * Reference 03 puts a request trace with per-stage timings along this band.
 * There are no per-stage timings anywhere in this system, and station 04 owns
 * the one trace this site can honestly draw, so a second trace here would be
 * both invented and duplicated. This is the component of equal weight that
 * takes its place, and it is the one the lede already promised.
 */
const FLAGSHIP_DECISIONS: Entry[] = decisions
  .filter((d) => d.data.system === flagship?.id)
  .slice(0, 4)
  .map((d) => ({
    stamp: d.data.title,
    text: d.data.tradeoff,
    meta: 'what it cost',
    tone: 'fault' as const,
    href: `/engineering#${d.id}`,
  }));

/*
 * The sidebar's quick stats — real counts for this one system, not for the
 * estate. Reference 03's sidebar carries index, metadata, quick stats and a
 * documentation link; this is the third of those four.
 */
const FLAGSHIP_STATS: Stat[] = [
  {
    label: 'Decisions',
    value: String(decisions.filter((d) => d.data.system === flagship?.id).length),
  },
  { label: 'Disclosed', value: String(flagship?.data.limitations?.length ?? 0) },
  { label: 'Layers', value: String(LAYERS.length) },
];

/*
 * Reference 04's stage labels, one above each object in the artwork, numbered
 * in the order a request meets them. Positions measured off the rendered plate
 * with a percentage grid (Oct 2026): laptop screen x 15-24, the box marked API
 * GATEWAY x 27-35, the lock x 37-45, the service cabinet x 50-65, the cache
 * x 66-73, the database x 77-85.
 *
 * The words are the demo plane's own architecture as the rest of the site
 * states it (station 01's estate): Caddy at the edge, Redis 7 for rate limits
 * and presence, PostgreSQL with row-level security. No timing on any stage,
 * because none is measured.
 */
const STAGES = [
  { x: 15.6, y: 33.6, label: '01 · Browser', lines: ['A request leaves'] },
  { x: 26.4, y: 26.2, label: '02 · Gateway', lines: ['Caddy, TLS termination'] },
  { x: 37.2, y: 21.4, label: '03 · Auth / policy', lines: ['Verify, then scope', 'to the tenant'] },
  { x: 51, y: 15.4, label: '04 · Service', lines: ['Fastify, business logic'] },
  { x: 66, y: 17.4, label: '05 · Cache', lines: ['Redis 7, rate limits'] },
  { x: 86, y: 45.6, label: '06 · Data', lines: ['PostgreSQL', 'Row-level security'] },
] as const;

/* The trace inspector's rows: what the one measured request is, and what it found. */
const TRACE_ROWS = [
  { label: 'Request', value: 'GET /health', mono: true },
  { label: 'Path', value: 'Browser → Edge → Tunnel → Caddy → Fastify' },
  { label: 'Control plane', live: 'state' as const },
  { label: 'Round trip, ms', live: 'rtt' as const, mono: true },
];

const TRACE_HOPS: Hop[] = [
  { name: 'Browser', detail: 'your device', tone: 'structure' },
  { name: 'Edge', detail: 'Cloudflare', tone: 'structure' },
  { name: 'Tunnel', detail: 'no inbound port', tone: 'isolation' },
  { name: 'Caddy', detail: 'reverse proxy', tone: 'structure' },
  { name: 'Fastify', detail: '/health', tone: 'signal' },
  { name: 'Response', detail: 'back to you', tone: 'signal' },
];

/** Station 06's readouts. Two measured, one counted, none invented. */
const LIVE_STATS: Stat[] = [
  { label: 'Round trip', value: null, unit: 'ms', live: 'rtt' },
  { label: 'Control plane', value: null, live: 'state' },
  { label: 'Demonstrations', value: '5' },
];

/*
 * STATION 09'S DATA. Every figure is a `length` over a collection or a directory
 * in this repository, computed at build time. Nothing here is sampled, averaged
 * or estimated, which is why the numbers are small and why that is correct.
 */

/** The donut's slices — this repository's real record types. */
const RECORD_MIX: Slice[] = [
  { label: 'Integration tests', value: counts.tests, tone: 'signal' },
  { label: 'Decisions', value: counts.decisions, tone: 'record' },
  { label: 'Evidence chips', value: counts.evidence, tone: 'isolation' },
  { label: 'Systems', value: counts.systems, tone: 'ember' },
  { label: 'Lessons', value: counts.lessons, tone: 'fault' },
];

/** The ranked list. Same facts, ordered by magnitude, each one openable. */
const TOP_RECORDS: Row[] = [
  { label: 'Integration tests', value: counts.tests, display: `${counts.tests}`, tone: 'signal' },
  {
    label: 'Architecture decisions',
    value: counts.decisions,
    display: `${counts.decisions}`,
    tone: 'record',
    href: '/engineering#decisions',
  },
  {
    label: 'Evidence chips',
    value: counts.evidence,
    display: `${counts.evidence}`,
    tone: 'isolation',
    href: '/engineering',
  },
  { label: 'Database migrations', value: 4, display: '4', tone: 'ember' },
  {
    label: 'Systems documented',
    value: counts.systems,
    display: `${counts.systems}`,
    tone: 'pending',
    href: '/systems',
  },
  {
    label: 'Lessons published',
    value: counts.lessons,
    display: `${counts.lessons}`,
    tone: 'fault',
    href: '/engineering#lessons',
  },
];

/**
 * The verification chain, in the order `npm run verify` runs it.
 *
 * These are the real gate names from package.json and the CI workflow. They are
 * `done` because this build passed them — a page that shipped is a page whose
 * gates went green, so the state is not an assertion about the future.
 */
const GATES: TLStage[] = [
  { name: 'Typecheck', detail: '0 errors', state: 'done' },
  { name: 'Build', detail: 'both surfaces', state: 'done' },
  { name: 'Copy', detail: 'banned words', state: 'done' },
  { name: 'Links', detail: 'no dead refs', state: 'done' },
  { name: 'Contrast', detail: 'WCAG 2.2 AA', state: 'done' },
  { name: 'Parity', detail: 'machine vs pages', state: 'done' },
  { name: 'Stations', detail: 'world stays on /', state: 'done' },
];

/**
 * THE DECISION THE TREE DRAWS, PINNED BY ID.
 *
 * The first version took `decisions.find(d => d.data.featured)`, which returns
 * whichever featured record sorts first — the modular-monolith ADR — while the
 * three option branches below are written from the TENANCY record's own text.
 * The panel rendered a decision whose alternatives belonged to a different
 * decision. The options and the trade-off read as plausible, which is exactly
 * what makes that class of mistake dangerous: nothing looked wrong.
 *
 * The branches are a hand-written reading of one specific record, so the record
 * is named. If it is ever removed the panel falls back to the first featured
 * entry and the branches are dropped rather than shown against the wrong
 * decision — a tree with no branches is honest; a tree with someone else's is
 * not.
 */
const TENANCY_ID = 'eles-org-scoped-tenancy';
const TENANCY = decisions.find((d) => d.id === TENANCY_ID);
const FEATURED_ENTRY = TENANCY ?? decisions.find((d) => d.data.featured) ?? decisions[0];
const FEATURED = {
  title: FEATURED_ENTRY?.data.title ?? 'No decision record found',
  tradeoff: FEATURED_ENTRY?.data.tradeoff ?? '',
  /** Branches are only shown against the record they were read from. */
  branchesValid: Boolean(TENANCY),
};

/*
 * Station 10's map: the ten stations, named on one frame.
 *
 * It said ten in its own comment and listed seven. 01, 07 and 10 were missing,
 * which made the closing frame a map of most of the journey — and the one the
 * reader is standing on was the most conspicuous omission of the three.
 */
const MAP = [
  { x: 27, y: 74, label: '01 · Enter', lines: ['Where you came in'] },
  { x: 36, y: 20, label: '02 · Systems', lines: ['Three platforms'] },
  { x: 48, y: 29, label: '03 · Dissection', lines: ['Architecture layers'] },
  { x: 33, y: 43, label: '04 · Data', lines: ['One request path'] },
  { x: 70, y: 56, label: '05 · Lab', lines: ['What did not work'] },
  { x: 55, y: 50, label: '06 · Live', lines: ['The control plane'] },
  { x: 63, y: 35, label: '07 · Think', lines: ['The judgment'] },
  { x: 76, y: 44, label: '08 · Build', lines: ['The next system'] },
  { x: 38, y: 60, label: '09 · Proof', lines: ['The archive'] },
  { x: 92, y: 68, label: '10 · End', lines: ['You are here'] },
] as const;
---

{/* ══ 02 SYSTEMS ═══════════════════════════════════════════════════ */}
<Stage id="systems" depth={1.1} plate={0.95} labelledby="st-systems">
  {
    /*
      THE LEFT COLUMN, as reference 02 draws it: eyebrow, claim, lede, the call
      to action, and the dissection list under its own heading. It is narrower
      than it was so the first system card can sit between it and the hospital
      island, which is where the reference hangs that card.
    */
  }
  <div class="col sys__col">
    <p class="eyebrow">02 / Systems</p>
    <h2 class="claim" id="st-systems">
      <span>Explore the</span>
      <span><em>systems</em> I build.</span>
    </h2>
    <p class="lede">
      Production systems built to solve real problems. Each one discloses the thing it does worst,
      before you read anything else about it.
    </p>
    <a class="cta" href="/systems">Explore the systems <span aria-hidden="true">→</span></a>

    {
      /*
        THE SAME SIX PARTS APPEAR ON STATION 03, AND MUST NOT LOOK THE SAME.
        Here the reader is shown the structure itself — what opening any of
        these systems gets them — so no part is marked. On 03 the same component
        marks the part that frame is actually showing.
      */
    }
    <p class="sys__dxHead">System dissection <span aria-hidden="true">●</span></p>
    <DissectionIndex parts={DISSECTION} class="sys__dx" />
  </div>

  {
    /*
      THE THREE SYSTEM CARDS, BESIDE THEIR ISLANDS.

      They were laid ON the islands — each card covered the very building it
      described, and the frame's three subjects were hidden behind three boxes.
