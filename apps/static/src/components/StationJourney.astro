<style>
  /* ── Shared stage typography ───────────────────────────────────── */
  /*
   * THE COLUMN'S FLOOR.
   *
   * Measured, not assumed: with the glyphs made transparent and the true
   * background sampled under each block, the lede on station 02 came out at
   * 4.33:1 and the eyebrow on station 06 at 3.84:1 against the brightest pixel
   * behind them. AA wants 4.5. The token gate cannot see this, because it
   * compares token to token and these are token against artwork.
   *
   * The same device the live surface's hero uses: a radial wash of the page
   * background that reaches zero well before any edge, so it reads as depth in
   * the plate rather than as a panel under the type. It is centred on the text,
   * not on the box, because the claim is what has to survive.
   */
  .col {
    position: absolute;
    left: 4.8%;
    top: 13%;
    width: 26%;
    /* Keeps the floor's negative z-index inside this column, behind its own
       text and in front of the plate. */
    isolation: isolate;
  }

  /*
   * THE FLOOR CANNOT HAVE AN EDGE, BY CONSTRUCTION.
   *
   * The first version painted the gradient as the column's own background, with
   * an ellipse larger than the box. The box clipped it while the gradient was
   * still at half opacity, so once the plates ran at full strength it showed as
   * a dark rectangle with hard sides behind every station heading.
   *
   * Now it is a separate layer much larger than the text, and the gradient is
   * sized `closest-side`: it reaches zero at the nearest edge of its own box,
   * so there is no point on any edge where it is still visible. The text sits
   * in the dense middle; the edges are mathematically transparent.
   */
  .col::before {
    content: '';
    position: absolute;
    inset: -22% -30%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgb(8 11 17 / 0.84) 0%,
      rgb(8 11 17 / 0.66) 52%,
      rgb(8 11 17 / 0.28) 80%,
      rgb(8 11 17 / 0) 100%
    );
  }

  .col--wide {
    width: 31%;
  }

  .eyebrow {
    margin: 0 0 calc(22 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(17 * var(--u));
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* Muted, not faint: at full plate strength the faint tone measured 4.31:1
       on station 08 and 4.49:1 on 09, under AA. */
    color: var(--text-muted);
  }

  .claim {
    margin: 0;
    font-size: calc(70 * var(--u));
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.026em;
    color: var(--text);
    text-shadow: 0 calc(2 * var(--u)) calc(16 * var(--u)) rgb(0 0 0 / 0.85);
  }

  .claim span {
    display: block;
  }

  /*
   * The emphasised word carries the brand ramp, exactly as station 01's does.
   *
   * It was the "live" register colour, which was a status colour used as
   * decoration: "works.", "request", "Prove." are not things running in
   * production. The ramp is the site speaking as itself, it starts at blue and
   * never passes through cyan (locked to tenancy boundaries), and every stop
   * clears 5:1 on the ground. Forced-colours mode restores the system colour,
   * because a clipped background would otherwise take the word with it.
   */
  .claim em {
    font-style: normal;
    color: var(--hue-violet);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .claim em {
      background-image: var(--brand-ramp);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
  }

  @media (forced-colors: active) {
    .claim em {
      background: none;
      -webkit-text-fill-color: CanvasText;
      color: CanvasText;
    }
  }

  .lede {
    margin: calc(26 * var(--u)) 0 0;
    font-size: calc(19 * var(--u));
    line-height: 1.6;
    color: var(--text-muted);
    text-shadow: 0 calc(1 * var(--u)) calc(10 * var(--u)) rgb(0 0 0 / 0.9);
  }

  /*
   * EVERY STATION'S CALL TO ACTION IS STATION 01'S, AT STATION SCALE.
   *
   * It was a square, mono, grey-outlined box — a different button from the one
   * on the opening frame, which the references draw as a rounded outline that
   * warms from blue to ember with the label in sans capitals. One button, one
   * shape, everywhere the site asks the reader to go somewhere.
   */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: calc(30 * var(--u));
    margin-top: calc(34 * var(--u));
    padding: calc(18 * var(--u)) calc(32 * var(--u));
    border: 1px solid transparent;
    border-radius: calc(10 * var(--u));
    background:
      linear-gradient(rgb(8 10 17 / 0.94), rgb(8 10 17 / 0.94)) padding-box,
      linear-gradient(
          90deg,
          rgb(124 146 255 / 0.75),
          rgb(176 132 220 / 0.6) 55%,
          rgb(242 135 92 / 0.75)
        )
        border-box;
    font-family: var(--font-sans);
    font-size: calc(19 * var(--u));
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--text);
    transition: box-shadow var(--duration-micro) var(--ease-out);
  }

  .cta:hover {
    background:
      linear-gradient(rgb(14 14 26 / 0.94), rgb(14 14 26 / 0.94)) padding-box,
      var(--brand-ramp) border-box;
    box-shadow: 0 0 calc(24 * var(--u)) rgb(139 108 246 / 0.28);
  }

  /* ── 05's composition ──────────────────────────────────────────── */

  .lab__col {
    top: 8%;
    width: 22%;
  }

  .lab__title {
    margin: 0 0 calc(10 * var(--u));
    font-size: calc(19 * var(--u));
    font-weight: 500;
    line-height: 1.3;
    color: var(--hue-ember);
  }

  /* Two short sections side by side in the wide bottom cards, as the
     reference's selector band is a row rather than a stack. */
  .lab__card :global(.lesson) {
    gap: calc(10 * var(--u));
  }

  /* ── 06's composition ──────────────────────────────────────────── */

  .live__col {
    top: 8%;
    width: 17%;
  }

  .live__core {
    position: absolute;
    left: 42.6%;
    top: 28.6%;
    width: 14.8%;
    padding: calc(14 * var(--u)) calc(18 * var(--u));
    border: 1px solid color-mix(in srgb, var(--hue-blue) 45%, transparent);
    border-radius: calc(8 * var(--u));
    background: rgb(6 9 16 / 0.86);
    box-shadow: 0 0 calc(30 * var(--u)) rgb(76 134 255 / 0.18);
    text-align: center;
  }

  .live__coreHead {
    margin: 0 0 calc(10 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(20 * var(--u));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hue-blue);
  }

  .live__coreList {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: calc(6 * var(--u));
    font-size: calc(15 * var(--u));
    line-height: 1.3;
    color: var(--text);
  }

  .live__sys {
    margin: calc(2 * var(--u)) 0 calc(6 * var(--u));
    font-size: calc(19 * var(--u));
    font-weight: 500;
    line-height: 1.25;
    color: var(--text);
  }

  .live__sysNote {
    margin: calc(6 * var(--u)) 0 0;
    font-family: var(--font-mono);
    font-size: calc(12 * var(--u));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ── 04's composition ──────────────────────────────────────────── */

  /* The reference's TOTAL TIME strip: figures large, in one row. */
  .rq__strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  /* The state cell carries words ("no answer"), so it gets the room; equal
     thirds ran it into the next figure. */
  .rq__strip--3 {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr) minmax(0, 0.7fr);
  }

  .rq__strip--3 .rq__word {
    font-size: calc(22 * var(--u));
  }

  .rq__strip--3 > div {
    padding-inline: calc(12 * var(--u));
  }

  .rq__strip > div {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
    padding: calc(2 * var(--u)) calc(16 * var(--u));
    border-left: 1px solid var(--plate-edge);
    min-width: 0;
  }

  .rq__strip > div:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .rq__strip dt {
    font-family: var(--font-mono);
    font-size: calc(13 * var(--u));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .rq__strip dd {
    margin: 0;
    font-size: calc(34 * var(--u));
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  /* Words, not figures: set a size down, as station 01's "no answer" is. */
  .rq__strip .rq__word {
    font-size: calc(26 * var(--u));
    line-height: calc(37 * var(--u));
  }

  .rq__stripNote {
    margin-top: calc(14 * var(--u));
    padding-top: calc(12 * var(--u));
    border-top: 1px solid var(--plate-edge);
  }

  /* Up, as the reference sets it: the top band was empty above the claim. */
  .rq__col {
    top: 8%;
  }

  /* Sits on the plate's brightest pipe (measured 2.13:1 bare), so it gets the
     same edgeless floor the headline column has. */
  .rq__go {
    position: absolute;
    left: 4.8%;
    top: 75%;
    width: 15.5%;
    isolation: isolate;
  }

  .rq__go::before {
    content: '';
    position: absolute;
    inset: -30% -40%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgb(6 9 14 / 0.92) 0%,
      rgb(6 9 14 / 0.8) 55%,
      rgb(6 9 14 / 0.35) 82%,
      rgb(6 9 14 / 0) 100%
    );
  }

  .rq__goHead {
    margin: 0 0 calc(12 * var(--u));
    font-size: calc(30 * var(--u));
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .rq__goLine {
    margin: 0;
    font-size: calc(16 * var(--u));
    line-height: 1.5;
    color: var(--text-muted);
  }

  .rq__go .cta {
    margin-top: calc(22 * var(--u));
    padding: calc(14 * var(--u)) calc(22 * var(--u));
    font-size: calc(15 * var(--u));
    gap: calc(18 * var(--u));
  }

  /* ── 03's composition ──────────────────────────────────────────── */

  /* Narrow enough that the upper layer labels sit between it and the stack. */
  .dx3__col {
    width: 19.5%;
  }

  .dx3__facts {
    margin: calc(14 * var(--u)) 0 calc(4 * var(--u));
    padding-top: calc(12 * var(--u));
    border-top: 1px solid var(--plate-edge);
    display: grid;
    gap: calc(9 * var(--u));
  }

  .dx3__facts div {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
  }

  .dx3__facts dt {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .dx3__facts dd {
    margin: 0;
    font-size: calc(14 * var(--u));
    line-height: 1.35;
    color: var(--text);
  }

  .dx3__live {
    color: var(--signal) !important;
  }

  /* ── 02's composition ──────────────────────────────────────────── */

  /* Narrower than the default column, so the first card fits between the
     claim and the hospital island, as reference 02 places it. */
  .sys__col {
    width: 19.8%;
  }

  /* The reference's lede is two short lines under the claim. */
  .sys__col .lede {
    max-width: calc(480 * var(--u));
  }

  .sys__dxHead {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--u));
    margin: calc(54 * var(--u)) 0 calc(14 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(16 * var(--u));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hue-blue);
  }

  .sys__dxHead span {
    font-size: calc(8 * var(--u));
  }

  /* The six parts at the reference's scale: a column of type, not a footnote. */
  .col :global(.sys__dx) {
    margin-top: 0;
    max-width: calc(300 * var(--u));
  }

  .col :global(.sys__dx .dx__row) {
    padding-block: calc(11 * var(--u));
  }

  .col :global(.sys__dx .dx__num) {
    font-size: calc(15 * var(--u));
    text-decoration: underline;
    text-underline-offset: calc(5 * var(--u));
    text-decoration-color: color-mix(in srgb, var(--text-faint) 70%, transparent);
  }

  .col :global(.sys__dx .dx__label) {
    font-family: var(--font-mono);
    font-size: calc(16 * var(--u));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* The cards. Name in the island's light; state in its register colour. */
  .sys__name {
    margin: calc(4 * var(--u)) 0 calc(10 * var(--u));
    font-size: calc(21 * var(--u));
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .sys__name--blue {
    color: var(--hue-blue);
  }
  .sys__name--ember {
    color: var(--hue-ember);
  }
  .sys__name--violet {
    color: var(--hue-violet);
  }

  .sys__state {
    margin: 0 0 calc(12 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(13 * var(--u));
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sys__state--signal {
    color: var(--signal);
  }
  .sys__state--pending {
    color: var(--pending);
  }
  .sys__state--plain,
  .sys__state--fault {
    color: var(--text-muted);
  }

  /* SC 2.5.8: a standalone link, so it clears 24px on its own. */
  .sys__more {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--u));
    min-height: 24px;
    margin-top: calc(10 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(13 * var(--u));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--text-faint);
  }

  .sys__more:hover {
    text-decoration-color: var(--hue-violet);
  }

  /* The core's label: under the ring, centred, the reference's size. */
  .sys__core {
    position: absolute;
    left: 58.5%;
    top: 51.5%;
    width: 11%;
    transform: translateX(-50%);
    padding: calc(12 * var(--u)) calc(16 * var(--u));
    border: 1px solid var(--plate-edge);
    border-radius: calc(8 * var(--u));
    background: var(--plate-scrim);
    text-align: center;
  }

  .sys__coreHead {
    margin: 0 0 calc(6 * var(--u));
    font-size: calc(18 * var(--u));
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .sys__coreLine {
    margin: 0;
    font-size: calc(14 * var(--u));
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* The three parts of a lesson, spaced so each reads as its own statement. */
  .lesson {
    display: flex;
    flex-direction: column;
    gap: calc(14 * var(--u));
    margin-top: calc(4 * var(--u));
  }

  /*
   * A UNIT WITHOUT ITS READING IS A CLAIM.
   *
   * "— ms" says there is a millisecond figure and it is merely absent. There is
   * no figure: the control plane did not answer. The unit is therefore bound to
   * the same state as the reading it belongs to, and appears only once one has
   * actually landed.
   */
  .unit {
    display: none;
  }

  :global(:root[data-liveness='live']) .unit {
    display: inline;
  }

  /*
   * A link inside a panel. Standalone, so SC 2.5.8's inline-in-sentence
   * exception does not cover it and it clears 24px on its own.
   */
  .panelLink {
    display: inline-flex;
    align-items: center;
    gap: calc(7 * var(--u));
    min-height: 24px;
    margin-top: calc(12 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--text-faint);
  }

  .panelLink:hover {
    color: var(--signal);
    text-decoration-color: var(--signal);
  }

  /* The left column's index sets its own measure so the six parts stay a
     column of type rather than stretching to the frame. */
  .col :global(.dx) {
    max-width: calc(430 * var(--u));
    margin-top: calc(32 * var(--u));
  }

  .sys__title {
    margin: 0 0 calc(10 * var(--u));
    font-size: calc(22 * var(--u));
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
  }

  .sys__title--signal {
    color: var(--signal);
  }
  .sys__title--pending {
    color: var(--pending);
  }
  .sys__title--fault,
  .sys__title--plain {
    color: var(--text);
  }

  .sys__line {
    margin: 0;
    font-size: calc(15 * var(--u));
    line-height: 1.55;
    color: var(--text-muted);
  }

  /*
   * A NOTE IS A DISCLOSURE, SO IT IS NOT THE FAINTEST THING ON THE PAGE.
   *
   * These carry the sentences that say what was cut, what is not measured, and
   * what the reference claimed that this site will not. Set in --text-faint
   * they measured 3.11:1 and 3.37:1 inside panels over the brighter parts of
   * the plates — the panel scrim is 92% opaque, so 8% of a bright plate comes
   * through, and the gate's --text-faint-on-plate-scrim pairing is computed
   * against the SOLID equivalent and cannot see it.
   *
   * Raising the scrim's alpha would have fixed the number by making every panel
   * on the site opaque, which is the plate the panels are supposed to sit in
   * front of. Raising the text is the smaller change and the better one: the
   * honest caveat should not be the hardest line on the frame to read.
   */
  .note {
    margin: calc(16 * var(--u)) 0 0;
    font-size: calc(13 * var(--u));
    line-height: 1.55;
    color: var(--text-muted);
  }

  .facts div {
    display: flex;
    justify-content: space-between;
    gap: calc(12 * var(--u));
    padding: calc(8 * var(--u)) 0;
    border-bottom: 1px solid var(--plate-edge);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: calc(13 * var(--u));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .facts dd {
    margin: 0;
    font-size: calc(14 * var(--u));
    color: var(--text);
    text-align: right;
  }

  .demos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demos li {
    display: flex;
    justify-content: space-between;
    gap: calc(14 * var(--u));
    padding: calc(8 * var(--u)) 0;
    border-bottom: 1px solid var(--plate-edge);
    font-size: calc(14 * var(--u));
    color: var(--text);
  }

  .demos li span:last-child {
    color: var(--text-faint);
    text-align: right;
  }

  .chips {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: calc(9 * var(--u)) 0;
    border-bottom: 1px solid var(--plate-edge);
  }

  .chips__fact {
    display: block;
    font-size: calc(15 * var(--u));
    line-height: 1.45;
    color: var(--text);
  }

  .chips__qual {
    display: block;
    margin-top: calc(4 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(12 * var(--u));
    letter-spacing: 0.08em;
    color: var(--record);
  }

  /* ── 08's pillar list ──────────────────────────────────────────── */
  .build__pillars {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .build__pillars li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: calc(12 * var(--u));
    align-items: baseline;
    padding: calc(8 * var(--u)) 0;
    border-bottom: 1px solid var(--plate-edge);
    font-size: calc(13 * var(--u));
    line-height: 1.35;
    color: var(--text);
  }

  .build__pillars li:last-child {
    border-bottom: 0;
  }

  .build__pillarNum {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* ── 09's layout ───────────────────────────────────────────────── */

  /*
   * Six metric cards across the archive bar. `auto-fit` rather than a fixed six
   * columns so the row reflows on the narrower stage widths instead of crushing
   * each figure to four characters.
   */
  .proof__bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(92 * var(--u)), 1fr));
    gap: calc(14 * var(--u)) calc(18 * var(--u));
  }

  /* The ring and its legend, shared by stations 02 and 09. The legend itself
     is a kit component; this is only how the two sit beside each other. */
  .ring {
    display: flex;
    align-items: center;
    gap: calc(16 * var(--u));
  }

  /* ── 07's serif register ───────────────────────────────────────── */

  /*
   * The only serif on the site, on the only frame the decomposition asks for
   * one. Serif carries judgment, sans carries explanation, mono carries record,
   * and this frame is the one that is about judgment.
   *
   * Tracking goes back to normal and the weight comes down: the sans display
   * needs -0.03em and 600 to hold together at 96px, and a serif at the same
   * settings looks compressed and shouted rather than considered.
   */
  .claim--serif {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.012em;
    line-height: 1.04;
  }

  .claim--serif :global(em) {
    font-style: normal;
  }

  .lede--serif {
    font-family: var(--font-serif);
    font-size: calc(30 * var(--u));
    line-height: 1.42;
    letter-spacing: 0;
    color: var(--text-muted);
    max-width: calc(560 * var(--u));
  }

  /* ── 07's five principles ──────────────────────────────────────── */

  .pillars {
    display: flex;
    flex-direction: column;
    gap: calc(13 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillars li {
    display: flex;
    gap: calc(12 * var(--u));
    padding-top: calc(11 * var(--u));
    border-top: 1px solid var(--plate-edge);
  }

  .pillars li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .pillars__num {
    flex: none;
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    line-height: 1.5;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .pillars__body {
    display: flex;
    flex-direction: column;
    gap: calc(3 * var(--u));
    min-width: 0;
  }

  .pillars__title {
    font-family: var(--font-mono);
    font-size: calc(12 * var(--u));
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* The statement that was in the config all along and never rendered. */
  .pillars__line {
    font-size: calc(12 * var(--u));
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ── 07's what-I-got-wrong list ────────────────────────────────── */

  .wrongs {
    display: flex;
    flex-direction: column;
    gap: calc(9 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wrongs li {
    padding-left: calc(11 * var(--u));
    border-left: 2px solid var(--fault);
  }

  .wrongs a {
    /* SC 2.5.8: standalone, so it clears 24px on its own. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: calc(13 * var(--u));
    line-height: 1.4;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--text-faint);
  }

  .wrongs a:hover {
    color: var(--signal);
    text-decoration-color: var(--signal);
  }

  /* ── 07's portrait slot ────────────────────────────────────────── */

  /*
   * AN EMPTY SLOT THAT LOOKS DELIBERATE.
   *
   * The alternative to a generated face is not a hole. This is a drawn box in
   * the frame's own proportions with a dashed edge and a stated reason, so a
   * reader sees a decision rather than a missing asset — and so that when an
   * owned photograph arrives it drops in here and nothing around it moves.
   */
  .portrait {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 5 / 4;
    margin-bottom: calc(14 * var(--u));
    border: 1px dashed var(--plate-edge);
    border-radius: calc(4 * var(--u));
    background: var(--bg-inset);
  }

  .portrait__mark {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-align: center;
    padding: 0 calc(16 * var(--u));
  }

  /* ── 08's availability line ────────────────────────────────────── */
  .available {
    display: flex;
    align-items: center;
    gap: calc(11 * var(--u));
    margin: calc(28 * var(--u)) 0 0;
    font-family: var(--font-mono);
    font-size: calc(15 * var(--u));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .available__dot {
    width: calc(8 * var(--u));
    height: calc(8 * var(--u));
    border-radius: 50%;
    background: var(--signal);
  }

  .state {
    margin: 0;
    font-family: var(--font-mono);
    font-size: calc(19 * var(--u));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pending);
  }

  /* ── 10's closing state ────────────────────────────────────────── */
  .endstate {
    display: flex;
    gap: calc(40 * var(--u));
    margin: calc(40 * var(--u)) 0 0;
    padding-top: calc(18 * var(--u));
    border-top: 1px solid var(--plate-edge);
  }

  .endstate dt {
    font-family: var(--font-mono);
