---
/**
 * STATIONS 02–10 — the rest of the reference world, on the fixed-ratio stage.
 *
 * Each station is a `Stage` locked to the plate's 3:2 ratio with its overlay
 * positioned in percentages of that frame, so a label naming a thing in the
 * artwork keeps naming it at every width. Below 1024px each one swaps to a
 * separate stacked composition rather than shrinking the cinematic one.
 *
 * WHAT EACH REFERENCE CONTRIBUTES, AND WHAT REPLACED ITS INVENTED FIGURES
 * The decomposition's §3 table ruled on every number baked into the artwork.
 * The compositions survive intact; the contents are repository facts.
 *
 *   02 SYSTEMS     three real systems with real statuses. The reference's
 *                  "12 Services Online", "TOTAL REGIONS 7" and "TOTAL SERVICES
 *                  128" are cut — rule 4, an unpublished figure is unpublished.
 *   03 DISSECTION  the layer stack of the flagship, with the case study's own
 *                  six sections as the index. "KUBERNETES" and "AMS AP-SOUTH-1"
 *                  are replaced by what this system actually runs on.
 *   04 DATA        one request path. No per-hop timings, because none are
 *                  measured; one measured total, in the reader's own browser.
 *   05 LAB         what did not work. The reference's FPS 119 / PARTICLES 15.4M
 *                  telemetry is cut entirely and the two written-up lessons
 *                  take the frame.
 *   06 LIVE        the control room, and the globe problem resolved in the open.
 *   07 THINK       the five pillars in the reference's numbered treatment, and
 *                  an empty chair where the reference has a generated face.
 *   08 BUILD       availability and contact. STATE: UNDEFINED, which is true.
 *   09 PROOF       the archive, counted at build time. Two-digit real numbers,
 *                  which the decomposition explicitly tells this station to be
 *                  designed for rather than the reference's fabricated 14.6K.
 *   10 END         the closing line, and the ten stations named on one map.
 */
import Stage from './stage/Stage.astro';
import Callout from './stage/Callout.astro';
import Panel from './stage/Panel.astro';
import Chip from './stage/Chip.astro';
import MetricCard from './stage/MetricCard.astro';
import Donut, { type Slice } from './stage/Donut.astro';
import RankedList, { type Row } from './stage/RankedList.astro';
import Feed, { type Entry } from './stage/Feed.astro';
import StageTimeline, { type Stage as TLStage } from './stage/StageTimeline.astro';
import FlowDiagram from './stage/FlowDiagram.astro';
import DecisionTree from './stage/DecisionTree.astro';
import Inspector from './stage/Inspector.astro';
import StatRow, { type Stat } from './stage/StatRow.astro';
import TraceRail, { type Hop } from './stage/TraceRail.astro';
import { SITE } from '../config/site';
import { PILLARS } from '../config/pillars';
import { STATUS_LABELS } from '../schemas/constitution';
import type { CollectionEntry } from 'astro:content';

interface Props {
  systems: CollectionEntry<'systems'>[];
  chips: CollectionEntry<'evidenceChips'>[];
  lessons: CollectionEntry<'lessons'>[];
  decisions: CollectionEntry<'decisions'>[];
  counts: { systems: number; decisions: number; tests: number; lessons: number; evidence: number };
}

const { systems, chips, lessons, decisions, counts } = Astro.props;

/*
 * Status to register entry.
 *
 * `undefined` for CONFIDENTIAL is deliberate and is the rule rather than a gap:
 * a panel gets a state dot only when it is carrying a state, and "confidential"
 * describes what may be said about a system, not what the system is doing. The
 * previous mapping sent it to `--structure`, which is a material token and not a
 * register entry — colouring a state dot with it would have been exactly the
 * confusion §3.4 forbids.
 */
type Register = 'signal' | 'pending' | 'isolation' | 'record' | 'fault';
const TONE: Record<string, Register | undefined> = {
  IN_PRODUCTION_HOSPITAL: 'signal',
  LIVE: 'signal',
  PRE_LAUNCH: 'pending',
  CONFIDENTIAL: undefined,
};

/** The sections a case study actually has, so each is a real destination. */
const DISSECTION = [
  { index: '01', label: 'Problem' },
  { index: '02', label: 'Architecture' },
  { index: '03', label: 'Data flow' },
  { index: '04', label: 'Security' },
  { index: '05', label: 'Deployment' },
  { index: '06', label: 'Impact' },
] as const;

/*
 * Counted, not claimed. Every one of these is a `length` over a collection or a
 * directory in this repository, and the decomposition measured the same set on
 * 22 Aug 2026 precisely so that the panels could be designed for two-digit
 * numbers instead of the reference's fabricated thousands.
 */
const ARCHIVE = [
  { label: 'Systems', value: counts.systems },
  { label: 'Decisions', value: counts.decisions },
  { label: 'Evidence', value: counts.evidence },
  { label: 'Lessons', value: counts.lessons },
  { label: 'Integration tests', value: counts.tests },
] as const;

/** The three statuses, derived rather than typed out. */
const live = systems.filter(
  (s) => s.data.status === 'IN_PRODUCTION_HOSPITAL' || s.data.status === 'LIVE',
).length;
const prelaunch = systems.filter((s) => s.data.status === 'PRE_LAUNCH').length;

/** The flagship, for station 03's dissection. Falls back to the first entry. */
const flagship = systems.find((s) => s.id === 'hospital-operations') ?? systems[0];

/** The layer stack of the flagship. Real architecture, from its own case study. */
const LAYERS = [
  { y: 13.5, label: 'Client', lines: ['Web and mobile browsers', 'QR entry, no account needed'] },
  { y: 24.5, label: 'Edge', lines: ['Caddy, TLS termination', 'Security boundary'] },
  { y: 35.5, label: 'API', lines: ['Fastify routes', 'Auth, rate limit, routing'] },
  { y: 46.5, label: 'Services', lines: ['Feature modules', 'One process, one database'] },
  { y: 57.5, label: 'Data', lines: ['PostgreSQL', 'Tenant-scoped by policy'] },
  { y: 68.5, label: 'Observability', lines: ['OpenTelemetry', 'Spans, logs, audit records'] },
] as const;

/** Reference 04's stage labels, carrying architecture rather than timings. */
const STAGES = [
  { x: 20, y: 30, label: 'Browser', lines: ['A request leaves'] },
  { x: 35, y: 22, label: 'Edge', lines: ['TLS, WAF'] },
  { x: 50, y: 30, label: 'Gateway', lines: ['Auth, rate limit'] },
  { x: 64, y: 22, label: 'Service', lines: ['Business logic'] },
  { x: 78, y: 30, label: 'Data', lines: ['Row-level security'] },
] as const;

const TRACE_HOPS: Hop[] = [
  { name: 'Browser', detail: 'your device', tone: 'structure' },
  { name: 'Edge', detail: 'Cloudflare', tone: 'structure' },
  { name: 'Tunnel', detail: 'no inbound port', tone: 'isolation' },
  { name: 'Caddy', detail: 'reverse proxy', tone: 'structure' },
  { name: 'Fastify', detail: '/health', tone: 'signal' },
  { name: 'Response', detail: 'back to you', tone: 'signal' },
];

/** Station 06's readouts. Two measured, one counted, none invented. */
const LIVE_STATS: Stat[] = [
  { label: 'Round trip', value: null, unit: 'ms', live: 'rtt' },
  { label: 'Control plane', value: null, live: 'state' },
  { label: 'Demonstrations', value: '5' },
];

/*
 * STATION 09'S DATA. Every figure is a `length` over a collection or a directory
 * in this repository, computed at build time. Nothing here is sampled, averaged
 * or estimated, which is why the numbers are small and why that is correct.
 */

/** The donut's slices — this repository's real record types. */
const RECORD_MIX: Slice[] = [
  { label: 'Integration tests', value: counts.tests, tone: 'signal' },
  { label: 'Decisions', value: counts.decisions, tone: 'record' },
  { label: 'Evidence chips', value: counts.evidence, tone: 'isolation' },
  { label: 'Systems', value: counts.systems, tone: 'ember' },
  { label: 'Lessons', value: counts.lessons, tone: 'fault' },
];

/** The ranked list. Same facts, ordered by magnitude, each one openable. */
const TOP_RECORDS: Row[] = [
  { label: 'Integration tests', value: counts.tests, display: `${counts.tests}`, tone: 'signal' },
  {
    label: 'Architecture decisions',
    value: counts.decisions,
    display: `${counts.decisions}`,
    tone: 'record',
    href: '/engineering#decisions',
  },
  {
    label: 'Evidence chips',
    value: counts.evidence,
    display: `${counts.evidence}`,
    tone: 'isolation',
    href: '/engineering',
  },
  { label: 'Database migrations', value: 4, display: '4', tone: 'ember' },
  {
    label: 'Systems documented',
    value: counts.systems,
    display: `${counts.systems}`,
    tone: 'pending',
    href: '/systems',
  },
  {
    label: 'Lessons published',
    value: counts.lessons,
    display: `${counts.lessons}`,
    tone: 'fault',
    href: '/engineering#lessons',
  },
];

/**
 * The verification chain, in the order `npm run verify` runs it.
 *
 * These are the real gate names from package.json and the CI workflow. They are
 * `done` because this build passed them — a page that shipped is a page whose
 * gates went green, so the state is not an assertion about the future.
 */
const GATES: TLStage[] = [
  { name: 'Typecheck', detail: '0 errors', state: 'done' },
  { name: 'Build', detail: 'both surfaces', state: 'done' },
  { name: 'Copy', detail: 'banned words', state: 'done' },
  { name: 'Links', detail: 'no dead refs', state: 'done' },
  { name: 'Contrast', detail: 'WCAG 2.2 AA', state: 'done' },
  { name: 'Parity', detail: 'machine vs pages', state: 'done' },
  { name: 'Stations', detail: 'world stays on /', state: 'done' },
];

/**
 * THE DECISION THE TREE DRAWS, PINNED BY ID.
 *
 * The first version took `decisions.find(d => d.data.featured)`, which returns
 * whichever featured record sorts first — the modular-monolith ADR — while the
 * three option branches below are written from the TENANCY record's own text.
 * The panel rendered a decision whose alternatives belonged to a different
 * decision. The options and the trade-off read as plausible, which is exactly
 * what makes that class of mistake dangerous: nothing looked wrong.
 *
 * The branches are a hand-written reading of one specific record, so the record
 * is named. If it is ever removed the panel falls back to the first featured
 * entry and the branches are dropped rather than shown against the wrong
 * decision — a tree with no branches is honest; a tree with someone else's is
 * not.
 */
const TENANCY_ID = 'eles-org-scoped-tenancy';
const TENANCY = decisions.find((d) => d.id === TENANCY_ID);
const FEATURED_ENTRY = TENANCY ?? decisions.find((d) => d.data.featured) ?? decisions[0];
const FEATURED = {
  title: FEATURED_ENTRY?.data.title ?? 'No decision record found',
  tradeoff: FEATURED_ENTRY?.data.tradeoff ?? '',
  /** Branches are only shown against the record they were read from. */
  branchesValid: Boolean(TENANCY),
};

/** Station 10's map labels: the ten stations, named on one frame. */
const MAP = [
  { x: 36, y: 20, label: '02 · Systems', lines: ['Three platforms'] },
  { x: 48, y: 29, label: '03 · Dissection', lines: ['Architecture layers'] },
  { x: 33, y: 43, label: '04 · Data', lines: ['One request path'] },
  { x: 55, y: 50, label: '06 · Live', lines: ['The control plane'] },
  { x: 70, y: 56, label: '05 · Lab', lines: ['What did not work'] },
  { x: 76, y: 44, label: '08 · Build', lines: ['The next system'] },
  { x: 38, y: 60, label: '09 · Proof', lines: ['The archive'] },
] as const;
---

{/* ══ 02 SYSTEMS ═══════════════════════════════════════════════════ */}
<Stage id="systems" depth={1.1} plate={0.95} labelledby="st-systems">
  <div class="col col--wide">
    <p class="eyebrow">02 / Systems</p>
    <h2 class="claim" id="st-systems">
      <span>Explore the</span>
      <span><em>systems</em> I build.</span>
    </h2>
    <p class="lede">
      Production systems built to solve real problems. Each one below discloses the thing it does
      worst, before you read anything else about it.
    </p>
    <a class="cta" href="/systems">Open the register <span aria-hidden="true">→</span></a>

    <ol class="index">
      {
        DISSECTION.map((row) => (
          <li>
            <span class="index__num">{row.index}</span>
            <span>{row.label}</span>
          </li>
        ))
      }
    </ol>
  </div>

  {/* The three systems, over the plate, where the reference hangs its cards. */}
  {
    systems.slice(0, 3).map((system, i) => (
      <Panel
        x={[37, 68, 68][i] ?? 37}
        y={[9, 9, 55][i] ?? 9}
        w={22}
        title={`0${i + 1}`}
        note={STATUS_LABELS[system.data.status].label}
        status={TONE[system.data.status]}
      >
        <p class={`sys__title sys__title--${TONE[system.data.status] ?? 'plain'}`}>
          {system.data.title}
        </p>
        <p class="sys__line">{system.data.problem}</p>
      </Panel>
    ))
  }

  {
    /*
    The reference's centre label reads ENGINEERING CORE / "Shared foundations
    powering all systems". That is a claim about shared infrastructure, and it is
    not true: these three systems run separately, on separate machines, for
    separate organisations. What they actually share is one operator and one set
    of patterns, which is a more specific and more checkable statement, so it is
    the one that ships.
  */
  }
  <Panel x={40} y={42} w={20} title="What is shared" dense>
    <p>
      Not infrastructure. These three run separately, for separate organisations. What is shared is
      one operator, and the same patterns applied each time: multi-tenant from the first migration,
      a modular monolith, and the limitation written down.
    </p>
  </Panel>

  {/* Real node names, from the systems' own declared stacks. */}
  {
    /*
      Chips name nodes in the field, so they belong ON the field. The first
      positions put three of them at x=28–31, inside the left text column, where
      they read as stray labels floating over the headline rather than as names
      attached to anything. Moved onto the plate and kept clear of the three
      system panels and the estate readout.
    */
  }
  <Chip x={45} y={30} label="Multi-tenant" />
  <Chip x={38} y={52} label="PostgreSQL" />
  <Chip x={47} y={70} label="Row-level security" />
  <Chip x={62} y={82} label="Audit records" quiet />
  <Chip x={90} y={38} label="Object storage" quiet />

  <Panel x={72} y={78} w={25} title="Estate" note="as of Sep 2026">
    <StatRow
      items={[
        { label: 'Platforms', value: String(counts.systems) },
        { label: 'In production', value: String(live) },
        { label: 'Pre-launch', value: String(prelaunch) },
      ]}
    />
    <p class="note">
      No service, region or tenant count is published. Those figures are not measured anywhere a
      reader could check, so they are not printed anywhere a reader could believe them.
    </p>
  </Panel>

  <div slot="mobile" class="m">
    <p class="m__eyebrow">02 / Systems</p>
    <h2 class="m__claim">Explore the systems I build.</h2>
    <p class="m__lede">
      Each one discloses the thing it does worst, before you read anything else about it.
    </p>
    <ul class="m__cards">
      {
        systems.slice(0, 3).map((system) => (
          <li>
            <p class="m__cardTitle">{system.data.title}</p>
            <p class="m__cardStatus" data-tone={TONE[system.data.status]}>
              {STATUS_LABELS[system.data.status].label}
            </p>
            <p class="m__cardLine">{system.data.problem}</p>
          </li>
        ))
      }
    </ul>
    <a class="cta cta--m" href="/systems">Open the register <span aria-hidden="true">→</span></a>
  </div>
</Stage>

{/* ══ 03 DISSECTION ════════════════════════════════════════════════ */}
<Stage id="dissection" anchor="dissection" depth={1} plate={0.95} labelledby="st-dissect">
  <div class="col">
    <p class="eyebrow">System / {flagship?.data.title}</p>
    <h2 class="claim" id="st-dissect">
      <span>How the system</span>
      <span>actually <em>works</em>.</span>
    </h2>
    <p class="lede">Open the architecture. Follow the data. Understand the decisions.</p>
  </div>

  {
    LAYERS.map((layer) => (
      <Callout
        x={30}
        y={layer.y}
        side="left"
        label={layer.label}
        lines={[...layer.lines]}
        lead={8}
        w={13}
      />
    ))
  }

  <Callout
    x={97}
    y={22}
    side="right"
    label="Tenant isolation"
    lines={['Server-derived org scope', 'plus row-level security']}
    lead={5}
    tone="isolation"
    w={15}
  />

  <Panel x={76} y={40} w={21} title="System" status="signal">
    <dl class="facts">
      <div><dt>Type</dt><dd>Multi-tenant platform</dd></div>
      <div><dt>Status</dt><dd>In production</dd></div>
      <div><dt>Deployment</dt><dd>Docker Compose, one VM</dd></div>
      <div><dt>Isolation</dt><dd>Two layers, independent</dd></div>
    </dl>
    <p class="note">
      The reference names a region and a Kubernetes cluster here. This system runs on neither, and
      its region is not published.
    </p>
  </Panel>

  <Panel x={4.8} y={62} w={22} title="Dissection" dense>
    <ol class="index index--tight">
      {
        DISSECTION.map((row) => (
          <li>
            <span class="index__num">{row.index}</span>
            <span>{row.label}</span>
          </li>
        ))
      }
    </ol>
  </Panel>

  <div slot="mobile" class="m">
    <p class="m__eyebrow">03 / Dissection</p>
    <h2 class="m__claim">How the system actually works.</h2>
    <p class="m__lede">Open the architecture. Follow the data. Understand the decisions.</p>
    <ol class="m__layers">
      {
        LAYERS.map((l) => (
          <li>
            <span>{l.label}</span>
            <span>{l.lines[1]}</span>
          </li>
        ))
      }
    </ol>
    <a class="cta cta--m" href={`/systems/${flagship?.id}`}>
      Read the case study <span aria-hidden="true">→</span>
    </a>
  </div>
</Stage>

{/* ══ 04 DATA ══════════════════════════════════════════════════════ */}
<Stage id="data" anchor="data" depth={1.05} plate={0.95} labelledby="st-data">
  <div class="col">
    <p class="eyebrow">04 / Request trace</p>
    <h2 class="claim" id="st-data">
      <span>Follow a <em>request</em></span>
      <span>through the system.</span>
    </h2>
    <p class="lede">
      From browser to data and back. One request crosses boundaries, services and data layers before
      a response reaches the reader.
    </p>
  </div>

  {
    STAGES.map((s) => (
      <Callout x={s.x} y={s.y} side="left" label={s.label} lines={[...s.lines]} lead={0} w={11} />
    ))
  }

  <Panel x={38} y={72} w={57} title="Live request trace" note="measured in your browser">
    <TraceRail hops={TRACE_HOPS} request="GET /health" />
  </Panel>

  <Panel x={4.8} y={58} w={24} title="Why no per-hop timings" dense>
    <p>
      The reference labels every hop with a millisecond figure. This site measures one number — the
      round trip your own browser just made — and publishes that. Seven invented splits would look
      more detailed and mean less.
    </p>
  </Panel>

  <div slot="mobile" class="m">
    <p class="m__eyebrow">04 / Request trace</p>
    <h2 class="m__claim">Follow a request through the system.</h2>
    <p class="m__lede">
      One request crosses boundaries, services and data layers before a response reaches you.
    </p>
    <ol class="m__layers">
      {
        TRACE_HOPS.map((h) => (
          <li>
            <span>{h.name}</span>
            <span>{h.detail}</span>
          </li>
        ))
      }
    </ol>
    <p class="m__note">
      Round trip measured here: <span data-live-value="rtt">—</span> ms.
    </p>
  </div>
</Stage>

{/* ══ 05 LAB ═══════════════════════════════════════════════════════ */}
<Stage id="lab" anchor="lab" depth={1.1} plate={0.95} labelledby="st-lab">
  <div class="col">
    <p class="eyebrow">05 / Lab</p>
    <h2 class="claim" id="st-lab">
      <span>Not everything ships.</span>
      <span><em>Everything</em> teaches.</span>
    </h2>
    <p class="lede">
      Written up in full, with what each one cost. A portfolio that only lists wins is a portfolio
      you cannot calibrate.
    </p>
    <a class="cta" href="/engineering#lessons">Read the lessons <span aria-hidden="true">→</span></a
    >
  </div>

  {
    lessons.slice(0, 2).map((lesson, i) => (
      <Panel x={40} y={i === 0 ? 14 : 44} w={34} title={`Lesson 0${i + 1}`} status="fault">
        <p class="sys__title sys__title--fault">{lesson.data.title}</p>
        <p class="sys__line">{lesson.data.whatHappened}</p>
      </Panel>
    ))
  }

  <Panel x={78} y={70} w={18} title="What is measured here" dense>
    <p>
      {counts.lessons} lessons published, {counts.decisions} decisions recorded. The reference puts frame
      rates and particle counts in this frame; none of them exist, so none of them ship.
    </p>
  </Panel>

  <div slot="mobile" class="m">
    <p class="m__eyebrow">05 / Lab</p>
    <h2 class="m__claim">Not everything ships. Everything teaches.</h2>
    <ul class="m__cards">
      {
        lessons.slice(0, 2).map((lesson) => (
          <li>
            <p class="m__cardTitle">{lesson.data.title}</p>
            <p class="m__cardLine">{lesson.data.whatHappened}</p>
          </li>
        ))
      }
    </ul>
    <a class="cta cta--m" href="/engineering#lessons">
      Read the lessons <span aria-hidden="true">→</span>
    </a>
  </div>
</Stage>

{/* ══ 06 LIVE ══════════════════════════════════════════════════════ */}
<Stage id="live" depth={1} plate={0.95} labelledby="st-live">
  <div class="col">
    <p class="eyebrow">06 / Live</p>
    <h2 class="claim" id="st-live">
      <span>The control</span>
      <span><em>room</em>.</span>
    </h2>
    <p class="lede">
      Observe what is happening. Follow the signal. See the system respond. Nothing here is
      simulated for appearance.
    </p>
    <a class="cta" href="/live/">Enter the live plane <span aria-hidden="true">→</span></a>
  </div>

  {
    /*
    THE GLOBE, RESOLVED IN THE OPEN.

    Reference 06's earth is covered in city lights across every continent — a
    picture of a global footprint that does not exist. The 3D scene refused to
    render it for exactly that reason and shipped a bare graticule instead
    (PHASE_LOG, 04–10, 22 Aug 2026). The static plate is a finished render and
    cannot be un-lit without looking broken, so the two surfaces would otherwise
    disagree about the same fact — which is the disagreement rule 10 exists to
    prevent, arriving through a channel no gate watches.

    The resolution is the same ruling applied to a different medium: the claim is
    withdrawn in text, on the artwork, where the artwork makes it. One marker, on
    the one real location, and a panel that says plainly what the lit continents
    are. An honest caption on an illustration is not a workaround; it is what a
    caption is for.
  */
  }
  <Panel x={62} y={11} w={26} title="About this map" status="fault">
    <p>
      The lit continents in this artwork are illustration. This system runs in one region, on one
      virtual machine. No global footprint, no multi-region deployment and no edge fleet is claimed
      anywhere on this site.
    </p>
    <p class="note">
      The only measured point on this map is your own round trip, below — and it is measured from
      wherever you are, not from anywhere shown here.
    </p>
  </Panel>

  <Panel x={62} y={44} w={26} title="Live metrics" note="derived, never asserted">
    <StatRow items={LIVE_STATS} />
    <p class="note">
      The reference reads ALL SYSTEMS OPERATIONAL here. That banner is derived on this site, and
      when the plane is down it is the first thing that says so.
    </p>
  </Panel>

  <Panel x={33} y={62} w={26} title="What it hosts" note="five, CI-asserted">
    <ol class="demos">
      <li><span>Tenant isolation</span><span>the break-out attempt</span></li>
      <li><span>Idempotent payments</span><span>a double-fired activation</span></li>
      <li><span>Fraud evidence</span><span>a duplicate photograph</span></li>
      <li><span>AI cost control</span><span>a query answered without a model</span></li>
      <li><span>Rate limiting</span><span>two layers, both named</span></li>
    </ol>
  </Panel>

  <Panel x={4.8} y={62} w={24} title="The demo plane" status="isolation">
    <p>
      A demonstration, labelled a demonstration. It provisions you a real tenant in a real
