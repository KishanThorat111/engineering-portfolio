---
/**
 * Stat block — blueprint §5: mono number, caption, qualifier.
 *
 * The qualifier is not optional in this component, mirroring
 * `qualifiedMetricSchema`: a stat block exists to display a measurement, and
 * constitution rule 2 says a measurement without its date is not publishable.
 * Making the prop required means the omission is a type error at the call
 * site, not a missing line a reviewer has to notice.
 */
interface Props {
  value: string;
  caption: string;
  qualifier: string;
}

const { value, caption, qualifier } = Astro.props;
---

<div class="stat-block">
  <p class="value">{value}</p>
  <p class="caption">{caption}</p>
  <p class="qualifier">{qualifier}</p>
</div>

<style>
  /* A figure tile: the number leads, the caption explains it, the date
     qualifier — which every number on this site carries — closes it. */
  .stat-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    background: var(--glass-bg);
    border: var(--border-width) solid var(--glass-edge);
    border-radius: var(--radius-lg);
  }

  .value {
    font-family: var(--font-mono);
    font-size: var(--text-metric);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text);
  }

  .caption {
    color: var(--text);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .qualifier {
    margin-block-start: auto;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
</style>
