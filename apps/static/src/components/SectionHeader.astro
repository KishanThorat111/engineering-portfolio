---
/**
 * Section header — blueprint §5: kicker plus title.
 *
 * The kicker is a paragraph, never a heading. It is a label, and promoting it
 * to a heading would put a meaningless rung in the document outline that
 * screen-reader users navigate by.
 */
interface Props {
  kicker?: string;
  title: string;
  /**
   * Heading level, so a section sits correctly in the page outline.
   *
   * Named `level` rather than the more idiomatic `as`: in this toolchain a
   * prop literally named `as` silently collapses `Astro.props` to `any`,
   * disabling prop typechecking for the whole component. Verified by bisect in
   * Phase 2 — see docs/PHASE_LOG.md.
   */
  level?: 'h2' | 'h3';
  id?: string;
}

const { kicker, title, level: Tag = 'h2', id } = Astro.props;
---

<header class="section-header">
  {
    kicker && (
      <p class="kicker">
        <span class="rule" aria-hidden="true" />
        {kicker}
      </p>
    )
  }
  <Tag id={id}>{title}</Tag>
</header>

<style>
  /*
   * Brought onto the redesign's type and eyebrow system.
   *
   * This component sets the opening of nearly every section on /about,
   * /engineering, /experience and the case studies. It was a small grey kicker
   * over a --text-xl heading, which is why those pages read a full tier quieter
   * than the pages that were rebuilt by hand — same site, two different voices.
   * Changing it here rather than page by page is what makes the whole surface
   * agree, and it is the reason those pages needed no edits of their own.
   *
   * The leading rule is the same mark the home and register openings carry: it
   * is how a section announces itself across this site.
   */
  .section-header {
    margin-block-end: var(--space-12);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-block-end: var(--space-4);
  }

  .kicker .rule {
    width: 2.5rem;
    height: 1px;
    flex: none;
    background: var(--border-strong);
  }

  h2 {
    font-size: var(--text-mega);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 20ch;
  }

  /* h3 stays a subsection: it sits INSIDE a section that already opened at the
     display tier, so matching that size would flatten the hierarchy again. */
  h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }
</style>
