---
/**
 * Section header — blueprint §5: kicker plus title.
 *
 * The kicker is a paragraph, never a heading. It is a label, and promoting it
 * to a heading would put a meaningless rung in the document outline that
 * screen-reader users navigate by.
 */
interface Props {
  kicker?: string;
  title: string;
  /**
   * Heading level, so a section sits correctly in the page outline.
   *
   * Named `level` rather than the more idiomatic `as`: in this toolchain a
   * prop literally named `as` silently collapses `Astro.props` to `any`,
   * disabling prop typechecking for the whole component. Verified by bisect in
   * Phase 2 — see docs/PHASE_LOG.md.
   */
  level?: 'h2' | 'h3';
  id?: string;
  /** Two-digit position in the page, shown before the kicker. */
  index?: string;
  /**
   * A word or phrase of the title to set in the brand ramp, as the home
   * page's headlines do. Must appear verbatim in `title`; the title's text is
   * unchanged either way.
   */
  emphasis?: string;
}

const { kicker, title, level: Tag = 'h2', id, index, emphasis } = Astro.props;

const at = emphasis ? title.indexOf(emphasis) : -1;
if (emphasis && at < 0) {
  throw new Error(`SectionHeader: emphasis "${emphasis}" is not in the title "${title}".`);
}
const parts =
  at >= 0
    ? [
        title.slice(0, at),
        title.slice(at, at + emphasis!.length),
        title.slice(at + emphasis!.length),
      ]
    : null;
---

<header class="section-header">
  {
    kicker && (
      <p class="kicker">
        {index && <span class="no">{index}</span>}
        <span class="rule" aria-hidden="true" />
        {kicker}
      </p>
    )
  }
  <Tag id={id}>
    {
      parts ? (
        <Fragment>
          {parts[0]}
          <em>{parts[1]}</em>
          {parts[2]}
        </Fragment>
      ) : (
        title
      )
    }
  </Tag>
</header>

<style>
  .section-header {
    margin-block-end: var(--space-12);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-block-end: var(--space-4);
  }

  .no {
    color: var(--text);
  }

  /* The ramp, short — the same mark that opens every page. */
  .kicker .rule {
    width: 2.5rem;
    height: 1px;
    flex: none;
    background: var(--brand-ramp);
  }

  h2 {
    font-size: var(--text-mega);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 20ch;
  }

  /* h3 stays a subsection: it sits INSIDE a section that already opened at the
     display tier, so matching that size would flatten the hierarchy again. */
  h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }

  em {
    font-style: normal;
    color: var(--hue-violet);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    em {
      background-image: var(--brand-ramp);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
  }

  @media (forced-colors: active) {
    em {
      background: none;
      -webkit-text-fill-color: CanvasText;
      color: CanvasText;
    }
  }
</style>
