---
/**
 * THE OPENING OF EVERY PAGE BEYOND THE HOME PAGE.
 *
 * The home page opens on a lit frame; the other routes opened on a small grey
 * kicker and a heading, in the site's earlier, plainer voice, so following a
 * link from `/` felt like arriving on a different website. This is the home
 * page's opening, rebuilt from what the inner pages carry: the numbered mono
 * eyebrow, a display headline whose emphasis takes the brand ramp, the lede,
 * and — where config/page-art.ts declares one — the scene that page is about.
 *
 * WITH ART (Oct 2026, owner direction; PHASE_LOG S11). On a wide screen the
 * scene fills the right two-thirds of the opening and the type sits on the
 * dark third it fades into; on a phone it is a full-width picture under the
 * header with the type rising out of its foot. The scene settles into place
 * as the page opens and drifts slower than the page as it scrolls away —
 * decoration over a page that is complete without it, and absent entirely
 * under reduced motion or where the browser has no scroll timeline.
 *
 * The headline arrives through a slot so a page can mark its own emphasis
 * with `<em>`; nothing here rewords a claim.
 */
import PlateImage from './PlateImage.astro';
import type { StationId } from '../config/visual-world';
import { HERO_SIZES } from '../config/page-art';

interface Props {
  /** Two-digit position, shown before the label, as the stations number theirs. */
  index?: string;
  label: string;
  /** Tints the ambient light, e.g. a case study's own system colour. */
  hue?: string;
  /** Sets the headline a size down, for pages whose title is a sentence. */
  compact?: boolean;
  /** The page's scene, declared for this route in config/page-art.ts. */
  art?: {
    plate: StationId;
    /** Focal point on a wide screen (CSS object-position). */
    focus: string;
    /** Focal point on a phone, where the frame is taller; defaults to `focus`. */
    focusNarrow?: string;
    /** Set when the picture is content (the owner), empty for a scene. */
    alt?: string;
  };
}

const { index, label, hue, compact = false, art } = Astro.props;
const style = [hue && `--ph-hue:${hue}`, art && `--ph-focus-narrow:${art.focusNarrow ?? art.focus}`]
  .filter(Boolean)
  .join('; ');
---

<header class:list={['ph', compact && 'ph--compact', art && 'ph--art']} style={style || undefined}>
  <div class="ph-sky" aria-hidden="true"></div>
  {
    art && (
      <div class="ph-scene">
        {/* 70vw on a phone, not 100vw: it selects the 768px file on a
             typical phone instead of the 1280px one — measured, that kept
             LCP under the 1.8s static budget; the scene fades behind the type,
             so the difference does not show. */}
        <PlateImage
          id={art.plate}
          alt={art.alt ?? ''}
          priority="eager"
          sizes={HERO_SIZES}
          focus={art.focus}
          class="ph-plate"
        />
        <span class="ph-sweep" aria-hidden="true" />
      </div>
    )
  }
  <div class="container ph-inner">
    <p class="ph-eyebrow">
      {index && <span class="ph-no">{index}</span>}
      <span class="ph-rule" aria-hidden="true"></span>
      <span>{label}</span>
    </p>
    <h1 class="ph-title"><slot name="title" /></h1>
    {
      Astro.slots.has('lede') && (
        <div class="ph-lede">
          <slot name="lede" />
        </div>
      )
    }
    {
      Astro.slots.has('default') && (
        <div class="ph-meta">
          <slot />
        </div>
      )
    }
  </div>
</header>

<style>
  .ph {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4.5rem, 11vw, 8.5rem) clamp(3rem, 6vw, 5rem);
    --ph-hue: var(--hue-blue);
  }

  /* The hairline the header and footer draw, closing the opening. */
  .ph::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: var(--brand-ramp);
    opacity: 0.35;
    mask-image: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
  }

  /*
   * The frames' light, without a frame: two soft pools in the ramp's own hues
   * and a fine technical grid fading out from the top-left, where the headline
   * sits. Kept dim — the faintest text on it still clears 4.5:1.
   */
  .ph-sky {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(
        55% 70% at 12% 0%,
        color-mix(in srgb, var(--ph-hue) 13%, transparent),
        transparent 70%
      ),
      radial-gradient(45% 65% at 88% 8%, rgb(139 108 246 / 0.1), transparent 70%),
      radial-gradient(40% 60% at 70% 110%, rgb(242 135 92 / 0.06), transparent 70%);
  }

  .ph-sky::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 90% at 20% 0%, #000, transparent 75%);
  }

  .ph-inner {
    position: relative;
  }

  .ph-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ph-no {
    color: var(--text);
  }

  .ph-rule {
    width: 2.5rem;
    height: 1px;
    flex: none;
    background: var(--brand-ramp);
  }

  .ph-title {
    max-width: 18ch;
    font-size: clamp(2.4rem, 6.2vw, 4.6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.032em;
  }

  .ph--compact .ph-title {
    max-width: 22ch;
    font-size: clamp(2.1rem, 4.8vw, 3.6rem);
    line-height: 1.06;
  }

  /* The home page's emphasis: the brand ramp, never through cyan. */
  .ph-title :global(em) {
    font-style: normal;
    color: var(--hue-violet);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .ph-title :global(em) {
      background-image: var(--brand-ramp);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
  }

  @media (forced-colors: active) {
    .ph-title :global(em) {
      background: none;
      -webkit-text-fill-color: CanvasText;
      color: CanvasText;
    }
  }

  .ph-lede {
    margin-block-start: var(--space-6);
    max-width: 60ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .ph-meta {
    margin-block-start: var(--space-8);
  }

  /* ── The scene ────────────────────────────────────────────────────── */

  .ph-scene {
    position: relative;
    z-index: -1;
    pointer-events: none;
  }

  .ph-scene :global(.ph-plate) {
    width: 100%;
    height: 100%;
    background: transparent;
  }

  /* The floor the type stands on: the scene falls away into the page. */
  .ph-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* One pass of light across the scene as the page opens, as the home
     page's frames are swept on arrival. */
  .ph-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      100deg,
      transparent 35%,
      rgb(176 150 255 / 0.12) 48%,
      rgb(255 255 255 / 0.06) 50%,
      transparent 62%
    );
    background-size: 250% 100%;
  }

  /* Phones and small tablets: the scene is a picture under the header and
     the type rises out of its foot. */
  @media (max-width: 899.98px) {
    .ph--art {
      padding-block-start: 0;
    }

    .ph--art .ph-scene {
      aspect-ratio: 4 / 3;
      max-height: 62svh;
      width: 100%;
    }

    .ph--art .ph-scene :global(.ph-plate img) {
      object-position: var(--ph-focus-narrow);
    }

    .ph--art .ph-scene::after {
      background:
        linear-gradient(to bottom, rgb(10 14 21 / 0.45) 0%, transparent 22%),
        linear-gradient(to top, var(--bg) 2%, rgb(10 14 21 / 0.7) 22%, transparent 55%);
    }

    .ph--art .ph-inner {
      margin-block-start: -3.5rem;
    }
  }

  /* Wide screens: the scene fills the right two-thirds, the type the left. */
  @media (min-width: 900px) {
    .ph--art {
      display: flex;
      align-items: center;
      min-height: clamp(540px, 80svh, 860px);
      padding-block: clamp(5rem, 9vw, 7.5rem) clamp(3.5rem, 6vw, 5rem);
    }

    .ph--art .ph-scene {
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0;
      width: 68%;
      /*
       * Feathered, not cut: the scene fades to nothing at its left edge, so
       * the opening's light and grid run under it unbroken. A solid fill there
       * drew a hard vertical line a third of the way across the page.
       */
      mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
    }

    .ph--art .ph-scene::after {
      background:
        linear-gradient(90deg, rgb(10 14 21 / 0.7) 0%, rgb(10 14 21 / 0.35) 34%, transparent 58%),
        linear-gradient(to top, var(--bg) 0%, rgb(10 14 21 / 0.55) 16%, transparent 40%),
        linear-gradient(to bottom, rgb(10 14 21 / 0.6) 0%, transparent 18%);
    }

    .ph--art .ph-inner {
      width: 100%;
    }

    /* Pills and tags stay in the type's column, on the dark side of the scene. */
    .ph--art .ph-meta {
      max-width: min(50vw, 40rem);
    }

    .ph--art .ph-title,
    .ph--art .ph-lede {
      max-width: min(44vw, 36rem);
    }

    .ph--art .ph-title {
      text-shadow: 0 2px 28px rgb(5 7 12 / 0.65);
    }

    .ph--art .ph-lede {
      text-shadow: 0 1px 14px rgb(5 7 12 / 0.9);
    }

    .ph--art.ph--compact .ph-title {
      max-width: min(46vw, 40rem);
    }
  }

  /*
   * MOTION — decoration over a page complete without it.
   *
   * The scene settles from a slight push-in as the page opens and one band of
   * light crosses it; then, where the browser runs scroll timelines, it drifts
   * slower than the page as the opening scrolls away. Only `scale` and
   * `translate` move, so nothing is laid out again.
   */
  @media (prefers-reduced-motion: no-preference) {
    .ph--art .ph-scene :global(.ph-plate img) {
      animation: ph-settle 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .ph-sweep {
      animation: ph-sweep 1.5s cubic-bezier(0.4, 0, 0.2, 1) 0.2s 1 both;
    }

    @supports (animation-timeline: scroll()) {
      .ph--art .ph-scene :global(.ph-plate) {
        animation: ph-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes ph-settle {
    from {
      scale: 1.07;
    }

    to {
      scale: 1;
    }
  }

  @keyframes ph-sweep {
    0% {
      opacity: 0;
      background-position: 120% 0;
    }

    15%,
    80% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      background-position: -60% 0;
    }
  }

  @keyframes ph-drift {
    from {
      translate: 0 0;
    }

    to {
      translate: 0 14%;
    }
  }
</style>
