---
/**
 * 01 / ENTER — reconstructed on the fixed-ratio stage.
 *
 * REFERENCE 01'S COMPOSITION, MEASURED AND REBUILT
 * Positions below are read off the reference frame and expressed as percentages
 * of it, so the callout naming the API gateway tier sits on the API gateway
 * tier at every width the stage survives at:
 *
 *   left column   eyebrow, four-line display claim, lede, chips, two controls,
 *                 a state line, the stat strip, the scroll cue
 *   left margin   six callouts down the request path, leaders reaching right
 *   right margin  five callouts naming the supporting estate, reaching left
 *   bottom centre the LIVE REQUEST TRACE panel
 *
 * WHAT THE REFERENCE PUTS IN THE STRIP, AND WHAT SHIPS INSTEAD
 * Reference 01 reads REQUESTS/MIN 2,487 · AVG LATENCY 32ms · UPTIME 99.99% ·
 * ERROR RATE 0.02%, and the decomposition §3 table rules on every one: rule 7
 * names uptime, tenant, user and throughput figures as not existing in
 * evidence, and rule 4 forbids estimating the rest. The strip's geometry is
 * kept exactly. Its contents are four things this site can stand behind:
 *
 *   ROUND TRIP        measured in the reader's own browser, this second
 *   CONTROL PLANE     the real state of a real service, including "not answering"
 *   DEMONSTRATIONS    counted from the API's registry; CI asserts it is five
 *   ISOLATION LAYERS  architecture, true whether or not anything is running
 *
 * The first two render as em dashes from the server and are filled only by a
 * successful measurement. An unmeasured figure stays a dash — never a zero, and
 * never a plausible number.
 *
 * THE CALLOUTS NAME THIS SYSTEM, NOT A GENERIC ONE
 * Every label below is a component in `infra/compose.yml` or a dependency in a
 * `package.json` in this repository. The reference's own callouts read "23
 * Regions", "128 Services" and "2.4M Eventers" — inventions, and two of them
 * misspelled, which is the standing reminder that words baked into the artwork
 * are never a source of truth.
 */
import Stage, { type Pin } from './stage/Stage.astro';
import Callout from './stage/Callout.astro';
import Panel from './stage/Panel.astro';
import Feed, { type Entry } from './stage/Feed.astro';
import TraceRail, { type Hop } from './stage/TraceRail.astro';
import { SITE, STATUS_CHIPS } from '../config/site';

interface Props {
  counts: { systems: number; decisions: number; tests: number; lessons: number };
}
const { counts } = Astro.props;

/*
 * The locked claim, broken for the reference's stacked display composition.
 * Read down it is exactly SITE.claim, which blueprint §1 locks and which the
 * unbroken copy below repeats for anything that reads rather than looks.
 */
const CLAIM_LINES = ['I design,', 'build,', 'and operate'] as const;
const CLAIM_TAIL = 'production systems.';

/**
 * The request path, down the left margin.
 *
 * Every entry is a real component of the running stack: `infra/compose.yml`
 * lines 47–171 and `services/api/package.json`. No version number is published
 * that the repository does not pin.
 */
/*
 * THE LABEL ROWS ARE THE ARTWORK'S OWN POINTER ROWS.
 *
 * The plate draws its own leader lines, each starting at a small lit dot in a
 * column on the left and ending at one on the right. Shown unshifted those
 * columns sit at x≈39.3% and ≈90.3%; the stage shifts this plate 2% right
 * (`plateX`), which puts the left column at ≈41.3% — where reference 01 has
 * it, 41.75% — so the longest label word clears its own dot. A
 * label "points at" a structure only if its name sits on the row of that dot.
 *
 * These positions were measured off the rendered page — labels hidden, motion
 * off, the lit dots located in the pixels — not estimated from the master,
 * because the arithmetic version was 2% out in x. They had been set when the
 * plate was still shown with a ~20% crop; showing it whole moved the artwork
 * and left every left-hand label 1.5–1.9% below its pointer.
 *
 * `y` is the baked dot's height; the callout is placed so the label's text row
 * is centred on it (see LABEL_ROW below).
 */
const PATH = [
  { y: 14.8, label: 'Edge', lines: ['Cloudflare', 'TLS, WAF, tunnel ingress'] },
  { y: 24.5, label: 'API Gateway', lines: ['Caddy 2', 'Reverse proxy, health checks'] },
  { y: 33.8, label: 'Services', lines: ['Fastify on Node.js', 'One image, API and worker'] },
  { y: 43.6, label: 'Event Stream', lines: ['WebSocket fanout', 'Presence and telemetry'] },
  { y: 54.5, label: 'Data Layer', lines: ['PostgreSQL 17', 'Row-level security, forced'] },
  { y: 65.4, label: 'Infrastructure', lines: ['Docker Compose', 'One VM, no inbound port'] },
] as const;

/** The supporting estate, down the right margin. */
const ESTATE = [
  { y: 16.7, label: 'AI', lines: ['Vertex AI', 'Budgeted per organisation'] },
  { y: 28.1, label: 'Monitoring', lines: ['OpenTelemetry', 'A span per demonstration'] },
  { y: 40.9, label: 'Database', lines: ['PostgreSQL 17', 'Tenant-scoped by policy'] },
  { y: 53.0, label: 'Cache', lines: ['Redis 7', 'Rate limits and presence'] },
  { y: 64.0, label: 'Storage', lines: ['Cloudflare R2', 'Object storage'] },
] as const;

/*
 * Half the label's line box, in percent of the frame's height: the callout's
 * top sits this far above the pointer row so the label's text is centred on
 * it. 12.5 reference pixels, and one reference pixel is 100 / 1685 % of the
 * frame's height.
 */
const LABEL_ROW = (12.5 * 100) / 1685;

/* Where the artwork's right-hand pointer lines end. */
const ESTATE_DOT_X = 92.3;

/*
 * On a phone, the same eleven names pinned to the same pointer dots — the left
 * column's at x 41.3%, the right column's at the line ends — so the opening
 * reads as reference 01 does: the estate, named on the artwork. The names are
 * PATH's and ESTATE's own; the detail lines stay in the wide composition.
 */
const PINS: Pin[] = [
  ...PATH.map((item) => ({ x: 41.3, y: item.y, label: item.label, side: 'l' as const })),
  ...ESTATE.map((item) => ({ x: ESTATE_DOT_X, y: item.y, label: item.label, side: 'l' as const })),
];

/*
 * THE INSTRUMENT PANEL, AND WHAT EACH SLOT IS ALLOWED TO CONTAIN.
 *
 * Reference 01's strip reads REQUESTS/MIN 2,487 · AVG LATENCY 32ms · UPTIME
 * 99.99% · ERROR RATE 0.02%, each with a trend line. Every one is invented, and
 * §3 rules on all four: rule 7 names uptime, tenant, user and throughput figures
 * as not existing in evidence, and rule 4 forbids estimating the rest.
 *
 * Deleting them is what left this corner of the frame empty. The four cards are
 * built instead, at the reference's density, and each carries one of the three
 * things a card here is allowed to hold:
 *
 *   measured   the reader's own round trip, and the real control-plane state
 *   counted    a build-time figure from this repository, CI-asserted
 *   stated     a sentence where the reference put a metric that does not exist
 *
 * The trend under each card is a Sparkline with no series, which draws its own
 * dashed "unmeasured" baseline. That is the honest shape of a trend this site
 * does not keep, and it is why the cards look finished rather than truncated.
 */

/** Real entries from this repository's own record — a true recent-additions feed. */
const RECORD: Entry[] = [
  {
    stamp: 'Sep 2026',
    text: 'Ten stations rebuilt as composed interfaces',
    meta: 'design',
    tone: 'record',
  },
  {
    stamp: 'Sep 2026',
    text: 'Dependency tree rebuilt — 0 advisories',
    meta: 'security',
    tone: 'signal',
  },
  {
    stamp: 'Aug 2026',
    text: 'Adversarial and load suites run against the stack',
    meta: 'proof',
    tone: 'record',
  },
  {
    stamp: 'Aug 2026',
    text: 'Tenant isolation proven by disabling RLS',
    meta: 'isolation',
    tone: 'isolation',
  },
];

/**
 * The trace's hops are labelled with what each hop IS, and carry no per-hop
 * timing, because no per-hop timing is measured anywhere a reader could check.
 * One real total beats seven invented splits.
 */
const HOPS: Hop[] = [
  { name: 'Browser', detail: 'your device', tone: 'structure' },
  { name: 'Edge', detail: 'Cloudflare', tone: 'structure' },
  { name: 'Tunnel', detail: 'no inbound port', tone: 'isolation' },
  { name: 'Caddy', detail: 'reverse proxy', tone: 'structure' },
  { name: 'Fastify', detail: '/health', tone: 'signal' },
  { name: 'Response', detail: 'back to you', tone: 'signal' },
];
---

<Stage
  id="enter"
  anchor="enter"
  priority="eager"
  depth={1.15}
  plate={0.92}
  plateX={2}
  labelledby="claim"
  class="enter"
  pins={PINS}
>
  {/* ── Left column ─────────────────────────────────────────────── */}
  <div class="enter__col">
    <p class="enter__eyebrow">Engineering complexity<br />into real systems.</p>

    {
      /*
        THE LINE BREAKS ARE VISUAL; THE SENTENCE IS NOT.

        Each display line is a block `<span>`, and adjacent tags carry no
        whitespace — so the heading's own text content read
        "I design,build,and operateproduction systems.", with the words welded
        together. Anything that takes an element's text rather than its rendered
        layout got that: search crawlers, text extraction, the reading mode in a
        browser, and screen readers whose name computation does not insert a
        space at a block boundary.

        A `visually-hidden` paragraph repeating the sentence used to paper over
        it, which meant the page stated its most important claim twice and a
        screen reader announced it twice — the heading, then the same words
        again as body text.

        An explicit space between the lines fixes the cause instead. The spans
        are blocks, so it changes nothing visually, and the heading now reads
        correctly on its own. The duplicate paragraph is gone with it.
      */
    }
    <h1 class="enter__claim" id="claim">
      {
        CLAIM_LINES.map((line) => (
          <>
            <span>{line}</span>{' '}
          </>
        ))
      }
      <span><em>{CLAIM_TAIL}</em></span>
    </h1>

    <p class="enter__lede">{SITE.subline}</p>

    {/* Locked §2 status chips. Wording untouched. */}
    <ul class="enter__chips">
      {STATUS_CHIPS.map((chip) => <li>{chip}</li>)}
    </ul>

    {
      /*
        THE PRIMARY ACTION IS THE LIVE SYSTEM.

        Reference 01 puts a single bordered CTA here reading "ENTER THE SYSTEM",
        and it is the one place on this page where the composition points a
        visitor at something to DO rather than something to read. That slot was
        being spent on "See the systems", a link to a static index, while the
        genuinely unusual thing this site has — a running multi-tenant system in
        a real 3D world that a visitor can attack — sat behind a link partway
        down the page.

        The wording says "live system" rather than the reference's bare "the
        system" because the destination is a demonstration plane and rule 11
        requires it be labelled one. The page it opens says DEMO PLANE in its
        first screen; this button does not need to oversell it, and the line
        beneath states plainly what it is before a visitor commits a click.
      */
    }
    <div class="enter__actions">
      <a class="enter__cta enter__cta--primary" href="/live/" data-live-cta>
        Enter the live system <span aria-hidden="true">→</span>
      </a>
      <a class="enter__cta enter__cta--quiet" href="/systems">See the systems</a>
      <a class="enter__cta enter__cta--quiet" href="/cv.pdf" download>Download CV</a>
    </div>
    <p class="enter__ctaNote">A real system, labelled a demonstration.</p>
  </div>

  {
    /*
      THE READOUT, DRAWN THE WAY REFERENCE 01 DRAWS IT.

      A status line with its dot, then one row of four readings separated by
      hairlines, standing on the artwork with no panel around it. It was a
      bordered 2x2 card grid with trend lines and a footnote — a component that
      made sense as a dashboard and read as a box parked in the corner of a
      cinematic frame, which the reference never is.

      The four readings are the true ones, not the reference's. Round trip and
      control plane are bound to the single measurement the page makes and show
      their unmeasured state until it lands; demonstrations and isolation layers
      are counted facts. Each unit is a sibling of its reading, never a child,
      because the liveness script fills a reading by replacing its text.
    */
  }
  <div class="enter__readout">
    <p class="enter__state">
      <span class="enter__state-dot" aria-hidden="true"></span>
      <span data-live-value="state-line">Live system — not yet checked</span>
    </p>

    <dl class="enter__stats">
      <div>
        <dt>Round trip</dt>
        <dd class="enter__stat--live">
          <span data-live-value="rtt">—</span><span class="unit">ms</span>
        </dd>
      </div>
      <div>
        <dt>Control plane</dt>
        <dd class="enter__stat--live"><span data-live-value="state">—</span></dd>
      </div>
      <div>
        <dt>Demonstrations</dt>
        <dd>5</dd>
      </div>
      <div>
        <dt>Isolation layers</dt>
        <dd>2</dd>
      </div>
    </dl>
  </div>

  {/* ── The two callout margins ─────────────────────────────────── */}
  {
    /*
      No lead stub: the artwork already draws each pointer line from its dot to
      the structure, so ours only added a stray hairline beside it.
    */
    PATH.map((item, i) => (
      <Callout
        class="enter__path"
        seq={i}
        x={32.2}
        y={item.y - LABEL_ROW}
        side="left"
        label={item.label}
        lines={[...item.lines]}
        lead={0}
        w={13}
      />
    ))
  }
  {
    /*
      THE RIGHT-HAND LABELS START AT THE POINTER, AS THE REFERENCE'S DO.

      They were right-aligned against the frame's edge, so each of the
      artwork's lines stopped at a dot in empty space and the label began
      somewhere to its right — or, for a long line, ran back over the dot.
      Reference 01 puts each label's own dot ON that line end with the text
      reading rightwards from it. The text block is the room left between the
      dot and the frame's margin, and the longer sub-lines wrap inside it.
    */
    ESTATE.map((item, i) => (
      <Callout
        class="enter__estate"
        seq={i + 1}
        x={ESTATE_DOT_X - 0.14}
        y={item.y - LABEL_ROW}
        side="left"
        label={item.label}
        lines={[...item.lines]}
        lead={0}
        w={6.5}
      />
    ))
  }

  {
    /*
      NO RECORD FEED ON THIS FRAME.

      One was built here and removed after rendering it. Reference 01 has no
      feed — its lower-left is a state line, a metric row and a scroll cue, and
      nothing else. Adding a feed pushed into the headline and solved a dead
      region by creating a collision.

      The feed is a real component and it belongs on 09, where reference 09
      actually draws RECENT ADDITIONS. This corner carries what the reference
      puts there: a state line and one row of readings.
    */
  }

  {/* ── The trace panel ─────────────────────────────────────────── */}
  <Panel x={39} y={76.2} w={37} title="Live request trace" note="measured here" band="full">
    <TraceRail hops={HOPS} request="GET /health" />
  </Panel>

  {/* ── The mobile composition ──────────────────────────────────── */}
  <div slot="mobile" class="enterM">
    <p class="enterM__eyebrow">01 / Enter</p>
    <h1 class="enterM__claim">{CLAIM_LINES.join(' ')} <em>{CLAIM_TAIL}</em></h1>
    <p class="enterM__lede">{SITE.subline}</p>
    <ul class="enterM__chips">
      {STATUS_CHIPS.map((chip) => <li>{chip}</li>)}
    </ul>
    <dl class="enterM__stats">
      {/* The unit is part of the reading; with no reading there is no unit. */}
      <div>
        <dt>Round trip</dt>
        <dd><span data-live-value="rtt">—</span><span class="unit">&nbsp;ms</span></dd>
      </div>
      <div><dt>Control plane</dt><dd data-live-value="state">—</dd></div>
      <div><dt>Demonstrations</dt><dd>5</dd></div>
      <div><dt>Isolation layers</dt><dd>2</dd></div>
    </dl>
    <p class="enterM__note">
      No uptime or throughput figure is published anywhere on this site. None is measured.
    </p>
    <div class="enterM__actions">
      <a class="enter__cta enter__cta--primary" href="/live/">
        Enter the live system <span aria-hidden="true">→</span>
      </a>
      <a class="enter__cta enter__cta--quiet" href="/systems">See the systems</a>
      <a class="enter__cta enter__cta--quiet" href="/cv.pdf" download>Download CV</a>
    </div>
    <p class="enterM__note">
      A real multi-tenant system, labelled a demonstration. It provisions you a tenant and invites
      you to attack it.
    </p>
    <p class="enterM__counts">
      {counts.systems} systems · {counts.decisions} decisions recorded · {counts.tests} integration tests
      · {counts.lessons} lessons published
    </p>
  </div>
</Stage>

<style>
  /* "— ms" claims a millisecond figure that is merely missing. Nothing was
     measured, so the unit waits for the reading it belongs to. */
  .unit {
    display: none;
  }

  :global(:root[data-liveness='live']) .unit {
    display: inline;
  }

  /* ── The stage composition ─────────────────────────────────────── */
  .enter__col {
    position: absolute;
    left: 4.8%;
    top: 11.5%;
    width: 26.5%;
  }

  /* Reference 01: larger, brighter, wider-tracked than a caption. */
  .enter__eyebrow {
    margin: 0 0 calc(40 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(22 * var(--u));
    line-height: 1.6;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text) 86%, transparent);
  }

  .enter__claim {
    margin: 0;
    font-size: calc(86 * var(--u));
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.032em;
    color: var(--text);
  }

  .enter__claim span {
    display: block;
  }

  /*
   * The reference gives its last line a cyan-through-orange gradient. Cyan is
   * locked to mean a tenancy boundary and nothing else (§12.1), and a decorative
   * gradient through it would be exactly the loosening CLAUDE.md forbids. The
   * emphasis is carried by the one register entry that IS true of this line —
   * these systems are running — so it is signal green, flat.
   */
  /*
   * THE REFERENCE'S GRADIENT, WITHOUT CYAN.
   *
   * The owner asked for this frame's colour to match reference 01 exactly, and
   * reference 01 sets its last line in a blue-violet-rose-ember ramp. The one
   * colour on this site that may never be decorative is cyan, which means a
   * tenancy boundary and nothing else — so the ramp starts at blue rather than
   * cyan, as the reference's own first letter does, and never passes through
   * it. Every stop clears 4.5:1 on the page background; display type needs 3.
   *
   * `box-decoration-break: clone` gives each wrapped line its own full ramp, so
   * "production" and "systems." both run blue to ember, as the reference's
   * single line does. In forced-colours mode a clipped background vanishes and
   * would take the text with it, so the system colour is restored there.
   */
  .enter__claim em,
  .enterM__claim em {
    font-style: normal;
    color: var(--hue-violet);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .enter__claim em,
    .enterM__claim em {
      background-image: var(--brand-ramp);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
  }

  @media (forced-colors: active) {
    .enter__claim em,
    .enterM__claim em {
      background: none;
      -webkit-text-fill-color: CanvasText;
      color: CanvasText;
    }
  }

  .enter__lede {
    margin: calc(30 * var(--u)) 0 0;
    font-size: calc(23 * var(--u));
    font-weight: 300;
    line-height: 1.5;
    /* The reference's paragraph is a cooler, quieter grey than its headline. */
    color: color-mix(in srgb, var(--text) 52%, var(--text-muted));
    text-shadow: 0 calc(1 * var(--u)) calc(8 * var(--u)) rgb(0 0 0 / 0.9);
  }

  .enter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(7 * var(--u));
    margin: calc(18 * var(--u)) 0 0;
    padding: 0;
    list-style: none;
  }

  /*
   * The four status chips are locked and gate-asserted, so they stay; the
   * reference has nothing in this position, so they are drawn as quietly as
   * they can be while still reading as the fixed facts they are — a hairline
   * outline on the artwork, no filled box.
   */
  .enter__chips li {
    padding: calc(7 * var(--u)) calc(13 * var(--u));
    border: 1px solid color-mix(in srgb, var(--text-faint) 70%, transparent);
    border-radius: calc(6 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(14 * var(--u));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /*
   * THE PRIMARY ACTION GETS ITS OWN LINE.
   *
   * Three controls in one row inside a 25%-wide column put every label on two
   * lines — "ENTER THE LIVE / SYSTEM", "SEE THE / SYSTEMS" — which reads as a
   * layout accident rather than a hierarchy. The primary now sits alone and the
   * two secondaries share the row beneath it, which is also the correct reading
   * order: one thing to do, two things to read.
   *
   * `white-space: nowrap` on the control itself is the other half: a button
   * whose label wraps has stopped being a button and become a paragraph with a
   * border.
   */
  .enter__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(16 * var(--u)) calc(24 * var(--u));
    margin-top: calc(24 * var(--u));
  }

  /*
   * Own row, so the two quiet links wrap beneath it — but sized to its label
   * the way the reference's is, not stretched across the column.
   */
  .enter__actions .enter__cta--primary {
    flex: 0 0 auto;
    margin-right: 100%;
  }

  .enter__cta {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    gap: calc(12 * var(--u));
    padding: calc(16 * var(--u)) calc(26 * var(--u));
    border: 1px solid var(--text-muted);
    border-radius: calc(3 * var(--u));
    background: var(--plate-scrim);
    font-family: var(--font-mono);
    font-size: calc(16 * var(--u));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
  }

  .enter__cta:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  /*
   * The one emphasised control on the page. It takes the signal border rather
   * than a filled background so it still reads as an instrument rather than a
   * marketing button, which is the register §3.2 binds this site to.
   */
  /*
   * REFERENCE 01'S BUTTON: neutral, rounded, generous, hugging its label.
   *
   * It was signal-green and full-width. Green on this site is a register — it
   * means "running in production, right now" — and a navigation control is
   * not a reading, so painting it green was borrowing a state it does not
   * have. The reference draws a pale outline with white type, and that is now
   * what ships. Green arrives on hover, which is the moment the control is
   * genuinely about to do something.
   */
  /* The reference's outline warms from blue on the left to ember on the
     right — the headline's ramp, drawn as a hairline and far quieter. */
  .enter__cta--primary {
    gap: calc(40 * var(--u));
    padding: calc(22 * var(--u)) calc(40 * var(--u));
    border-color: transparent;
    border-radius: calc(10 * var(--u));
    background:
      linear-gradient(rgb(8 10 17 / 0.94), rgb(8 10 17 / 0.94)) padding-box,
      linear-gradient(
          90deg,
          rgb(124 146 255 / 0.75),
          rgb(176 132 220 / 0.6) 55%,
          rgb(242 135 92 / 0.75)
        )
        border-box;
    font-family: var(--font-sans);
    font-size: calc(24 * var(--u));
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--text);
  }

  /* Hover: the outline brightens to the full ramp and the label goes white —
     the control lights up rather than changing colour family. */
  .enter__cta--primary:hover {
    color: #fff;
    background:
      linear-gradient(rgb(14 14 26 / 0.94), rgb(14 14 26 / 0.94)) padding-box,
      var(--brand-ramp) border-box;
    box-shadow: 0 0 calc(28 * var(--u)) rgb(139 108 246 / 0.28);
  }

  .enter__ctaNote {
    max-width: calc(430 * var(--u));
    margin: calc(16 * var(--u)) 0 0;
    font-size: calc(14 * var(--u));
    line-height: 1.55;
    color: var(--text-faint);
    text-shadow: 0 calc(1 * var(--u)) calc(6 * var(--u)) rgb(0 0 0 / 0.9);
  }

  .enter__cta--quiet {
    border-color: transparent;
    background: none;
    padding-inline: 0;
    text-decoration: underline;
