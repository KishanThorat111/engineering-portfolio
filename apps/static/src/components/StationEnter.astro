---
/**
 * 01 / ENTER — reconstructed on the fixed-ratio stage.
 *
 * REFERENCE 01'S COMPOSITION, MEASURED AND REBUILT
 * Positions below are read off the reference frame and expressed as percentages
 * of it, so the callout naming the API gateway tier sits on the API gateway
 * tier at every width the stage survives at:
 *
 *   left column   eyebrow, four-line display claim, lede, chips, two controls,
 *                 a state line, the stat strip, the scroll cue
 *   left margin   six callouts down the request path, leaders reaching right
 *   right margin  five callouts naming the supporting estate, reaching left
 *   bottom centre the LIVE REQUEST TRACE panel
 *
 * WHAT THE REFERENCE PUTS IN THE STRIP, AND WHAT SHIPS INSTEAD
 * Reference 01 reads REQUESTS/MIN 2,487 · AVG LATENCY 32ms · UPTIME 99.99% ·
 * ERROR RATE 0.02%, and the decomposition §3 table rules on every one: rule 7
 * names uptime, tenant, user and throughput figures as not existing in
 * evidence, and rule 4 forbids estimating the rest. The strip's geometry is
 * kept exactly. Its contents are four things this site can stand behind:
 *
 *   ROUND TRIP        measured in the reader's own browser, this second
 *   CONTROL PLANE     the real state of a real service, including "not answering"
 *   DEMONSTRATIONS    counted from the API's registry; CI asserts it is five
 *   ISOLATION LAYERS  architecture, true whether or not anything is running
 *
 * The first two render as em dashes from the server and are filled only by a
 * successful measurement. An unmeasured figure stays a dash — never a zero, and
 * never a plausible number.
 *
 * THE CALLOUTS NAME THIS SYSTEM, NOT A GENERIC ONE
 * Every label below is a component in `infra/compose.yml` or a dependency in a
 * `package.json` in this repository. The reference's own callouts read "23
 * Regions", "128 Services" and "2.4M Eventers" — inventions, and two of them
 * misspelled, which is the standing reminder that words baked into the artwork
 * are never a source of truth.
 */
import Stage from './stage/Stage.astro';
import Callout from './stage/Callout.astro';
import Panel from './stage/Panel.astro';
import StatRow, { type Stat } from './stage/StatRow.astro';
import TraceRail, { type Hop } from './stage/TraceRail.astro';
import { SITE, STATUS_CHIPS } from '../config/site';

interface Props {
  counts: { systems: number; decisions: number; tests: number; lessons: number };
}
const { counts } = Astro.props;

/*
 * The locked claim, broken for the reference's stacked display composition.
 * Read down it is exactly SITE.claim, which blueprint §1 locks and which the
 * unbroken copy below repeats for anything that reads rather than looks.
 */
const CLAIM_LINES = ['I design,', 'build,', 'and operate'] as const;
const CLAIM_TAIL = 'production systems.';

/**
 * The request path, down the left margin.
 *
 * Every entry is a real component of the running stack: `infra/compose.yml`
 * lines 47–171 and `services/api/package.json`. No version number is published
 * that the repository does not pin.
 */
const PATH = [
  { y: 15.6, label: 'Edge', lines: ['Cloudflare', 'TLS, WAF, tunnel ingress'] },
  { y: 25.3, label: 'API Gateway', lines: ['Caddy 2', 'Reverse proxy, health checks'] },
  { y: 35.0, label: 'Services', lines: ['Fastify on Node.js', 'One image, API and worker'] },
  { y: 44.7, label: 'Event Stream', lines: ['WebSocket fanout', 'Presence and telemetry'] },
  { y: 54.4, label: 'Data Layer', lines: ['PostgreSQL 17', 'Row-level security, forced'] },
  { y: 64.1, label: 'Infrastructure', lines: ['Docker Compose', 'One VM, no inbound port'] },
] as const;

/** The supporting estate, down the right margin. */
const ESTATE = [
  { y: 17.6, label: 'AI', lines: ['Vertex AI', 'Budgeted per organisation'] },
  { y: 28.6, label: 'Monitoring', lines: ['OpenTelemetry', 'A span per demonstration'] },
  { y: 41.0, label: 'Database', lines: ['PostgreSQL 17', 'Tenant-scoped by policy'] },
  { y: 52.6, label: 'Cache', lines: ['Redis 7', 'Rate limits and presence'] },
  { y: 63.0, label: 'Storage', lines: ['Cloudflare R2', 'Object storage'] },
] as const;

/*
 * The strip. `live` columns render the pending dash server-side; the liveness
 * script replaces them only on a real measurement.
 *
 * DEMONSTRATIONS is not a live column: five is a build-time fact this
 * repository can prove without a network call, and CI asserts it on every push
 * ("Assert all five demonstrations are still published"). Binding it to a fetch
 * would make a true figure disappear whenever the tunnel is down.
 */
const STATS: Stat[] = [
  { label: 'Round trip', value: null, unit: 'ms', live: 'rtt' },
  { label: 'Control plane', value: null, live: 'state' },
  { label: 'Demonstrations', value: '5' },
  { label: 'Isolation layers', value: '2' },
];

/**
 * The trace's hops are labelled with what each hop IS, and carry no per-hop
 * timing, because no per-hop timing is measured anywhere a reader could check.
 * One real total beats seven invented splits.
 */
const HOPS: Hop[] = [
  { name: 'Browser', detail: 'your device', tone: 'structure' },
  { name: 'Edge', detail: 'Cloudflare', tone: 'structure' },
  { name: 'Tunnel', detail: 'no inbound port', tone: 'isolation' },
  { name: 'Caddy', detail: 'reverse proxy', tone: 'structure' },
  { name: 'Fastify', detail: '/health', tone: 'signal' },
  { name: 'Response', detail: 'back to you', tone: 'signal' },
];
---

<Stage
  id="enter"
  anchor="enter"
  priority="eager"
  depth={1.15}
  plate={0.92}
  labelledby="claim"
  class="enter"
>
  {/* ── Left column ─────────────────────────────────────────────── */}
  <div class="enter__col">
    <p class="enter__eyebrow">Engineering complexity<br />into real systems.</p>

    {
      /*
        THE LINE BREAKS ARE VISUAL; THE SENTENCE IS NOT.

        Each display line is a block `<span>`, and adjacent tags carry no
        whitespace — so the heading's own text content read
        "I design,build,and operateproduction systems.", with the words welded
        together. Anything that takes an element's text rather than its rendered
        layout got that: search crawlers, text extraction, the reading mode in a
        browser, and screen readers whose name computation does not insert a
        space at a block boundary.

        A `visually-hidden` paragraph repeating the sentence used to paper over
        it, which meant the page stated its most important claim twice and a
        screen reader announced it twice — the heading, then the same words
        again as body text.

        An explicit space between the lines fixes the cause instead. The spans
        are blocks, so it changes nothing visually, and the heading now reads
        correctly on its own. The duplicate paragraph is gone with it.
      */
    }
    <h1 class="enter__claim" id="claim">
      {
        CLAIM_LINES.map((line) => (
          <>
            <span>{line}</span>{' '}
          </>
        ))
      }
      <span><em>{CLAIM_TAIL}</em></span>
    </h1>

    <p class="enter__lede">{SITE.subline}</p>

    {/* Locked §2 status chips. Wording untouched. */}
    <ul class="enter__chips">
      {STATUS_CHIPS.map((chip) => <li>{chip}</li>)}
    </ul>

    {
      /*
        THE PRIMARY ACTION IS THE LIVE SYSTEM.

        Reference 01 puts a single bordered CTA here reading "ENTER THE SYSTEM",
        and it is the one place on this page where the composition points a
        visitor at something to DO rather than something to read. That slot was
        being spent on "See the systems", a link to a static index, while the
        genuinely unusual thing this site has — a running multi-tenant system in
        a real 3D world that a visitor can attack — sat behind a link partway
        down the page.

        The wording says "live system" rather than the reference's bare "the
        system" because the destination is a demonstration plane and rule 11
        requires it be labelled one. The page it opens says DEMO PLANE in its
        first screen; this button does not need to oversell it, and the line
        beneath states plainly what it is before a visitor commits a click.
      */
    }
    <div class="enter__actions">
      <a class="enter__cta enter__cta--primary" href="/live/" data-live-cta>
        Enter the live system <span aria-hidden="true">→</span>
      </a>
      <a class="enter__cta enter__cta--quiet" href="/systems">See the systems</a>
      <a class="enter__cta enter__cta--quiet" href="/cv.pdf" download>Download CV</a>
    </div>
    <p class="enter__ctaNote">
      A real system, labelled a demonstration. It gives you a tenant and invites you to attack it.
    </p>
  </div>

  {/* ── The state line and the strip ────────────────────────────── */}
  <div class="enter__readout">
    <p class="enter__state">
      <span class="enter__state-dot" aria-hidden="true"></span>
      <span data-live-value="state-line">Control plane — not yet measured</span>
    </p>
    <StatRow items={STATS} />
    {
      /*
        The reference's fourth column is UPTIME 99.99%. There is no such
        measurement and rule 7 says there is not one to publish, so the honest
        statement takes the place a fabricated figure would have held. It is
        also a more interesting line for a hiring engineer than a number they
        could not check.
      */
    }
    <p class="enter__note">
      No uptime or throughput figure is published anywhere on this site. None is measured.
    </p>
  </div>

  {/* ── The two callout margins ─────────────────────────────────── */}
  {
    PATH.map((item) => (
      <Callout
        x={32.6}
        y={item.y}
        side="left"
        label={item.label}
        lines={[...item.lines]}
        lead={7}
        w={13}
      />
    ))
  }
  {
    ESTATE.map((item) => (
      <Callout
        x={97}
        y={item.y}
        side="right"
        label={item.label}
        lines={[...item.lines]}
        lead={6}
        w={14}
      />
    ))
  }

  {/* ── The trace panel ─────────────────────────────────────────── */}
  <Panel x={39} y={76.2} w={37} title="Live request trace" note="measured here">
    <TraceRail hops={HOPS} request="GET /health" />
  </Panel>

  {/* ── The scroll cue ──────────────────────────────────────────── */}
  <p class="enter__scroll">
    <span class="enter__scroll-icon" aria-hidden="true"></span>
    Scroll to explore
  </p>

  {/* ── The mobile composition ──────────────────────────────────── */}
  <div slot="mobile" class="enterM">
    <p class="enterM__eyebrow">01 / Enter</p>
    <h1 class="enterM__claim">{SITE.claim}</h1>
    <p class="enterM__lede">{SITE.subline}</p>
    <ul class="enterM__chips">
      {STATUS_CHIPS.map((chip) => <li>{chip}</li>)}
    </ul>
    <dl class="enterM__stats">
      <div><dt>Round trip</dt><dd><span data-live-value="rtt">—</span> ms</dd></div>
      <div><dt>Control plane</dt><dd data-live-value="state">—</dd></div>
      <div><dt>Demonstrations</dt><dd>5</dd></div>
      <div><dt>Isolation layers</dt><dd>2</dd></div>
    </dl>
    <p class="enterM__note">
      No uptime or throughput figure is published anywhere on this site. None is measured.
    </p>
    <div class="enterM__actions">
      <a class="enter__cta enter__cta--primary" href="/live/">
        Enter the live system <span aria-hidden="true">→</span>
      </a>
      <a class="enter__cta enter__cta--quiet" href="/systems">See the systems</a>
      <a class="enter__cta enter__cta--quiet" href="/cv.pdf" download>Download CV</a>
    </div>
    <p class="enterM__note">
      A real multi-tenant system, labelled a demonstration. It provisions you a tenant and invites
      you to attack it.
    </p>
    <p class="enterM__counts">
      {counts.systems} systems · {counts.decisions} decisions recorded · {counts.tests} integration tests
      · {counts.lessons} lessons published
    </p>
  </div>
</Stage>

<style>
  /* ── The stage composition ─────────────────────────────────────── */
  .enter__col {
    position: absolute;
    left: 4.8%;
    top: 12.5%;
    width: 25%;
  }

  .enter__eyebrow {
    margin: 0 0 calc(34 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(18 * var(--u));
    line-height: 1.55;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .enter__claim {
    margin: 0;
    font-size: calc(96 * var(--u));
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.028em;
    color: var(--text);
  }

  .enter__claim span {
    display: block;
  }

  /*
   * The reference gives its last line a cyan-through-orange gradient. Cyan is
   * locked to mean a tenancy boundary and nothing else (§12.1), and a decorative
   * gradient through it would be exactly the loosening CLAUDE.md forbids. The
   * emphasis is carried by the one register entry that IS true of this line —
   * these systems are running — so it is signal green, flat.
   */
  .enter__claim em {
    font-style: normal;
    color: var(--signal);
  }

  .enter__lede {
    margin: calc(30 * var(--u)) 0 0;
    font-size: calc(20 * var(--u));
    line-height: 1.6;
    color: var(--text-muted);
    text-shadow: 0 calc(1 * var(--u)) calc(8 * var(--u)) rgb(0 0 0 / 0.9);
  }

  .enter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(8 * var(--u));
    margin: calc(24 * var(--u)) 0 0;
    padding: 0;
    list-style: none;
  }

  .enter__chips li {
    padding: calc(7 * var(--u)) calc(13 * var(--u));
    border: 1px solid var(--plate-edge);
    border-radius: calc(4 * var(--u));
    background: var(--plate-scrim);
    font-family: var(--font-mono);
    font-size: calc(14 * var(--u));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }

  /*
   * THE PRIMARY ACTION GETS ITS OWN LINE.
   *
   * Three controls in one row inside a 25%-wide column put every label on two
   * lines — "ENTER THE LIVE / SYSTEM", "SEE THE / SYSTEMS" — which reads as a
   * layout accident rather than a hierarchy. The primary now sits alone and the
   * two secondaries share the row beneath it, which is also the correct reading
   * order: one thing to do, two things to read.
   *
   * `white-space: nowrap` on the control itself is the other half: a button
   * whose label wraps has stopped being a button and become a paragraph with a
   * border.
   */
  .enter__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(16 * var(--u)) calc(24 * var(--u));
    margin-top: calc(34 * var(--u));
  }

  .enter__actions .enter__cta--primary {
    /* Own row: the two quiet links wrap beneath it. */
    flex: 0 0 100%;
    justify-content: space-between;
  }

  .enter__cta {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    gap: calc(12 * var(--u));
    padding: calc(16 * var(--u)) calc(26 * var(--u));
    border: 1px solid var(--text-muted);
    border-radius: calc(3 * var(--u));
    background: var(--plate-scrim);
    font-family: var(--font-mono);
    font-size: calc(16 * var(--u));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
  }

  .enter__cta:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  /*
   * The one emphasised control on the page. It takes the signal border rather
   * than a filled background so it still reads as an instrument rather than a
   * marketing button, which is the register §3.2 binds this site to.
   */
  .enter__cta--primary {
    border-color: var(--signal);
    color: var(--signal);
  }

  .enter__cta--primary:hover {
    background: color-mix(in srgb, var(--signal) 14%, var(--plate-scrim));
  }

  .enter__ctaNote {
    max-width: calc(430 * var(--u));
    margin: calc(16 * var(--u)) 0 0;
    font-size: calc(14 * var(--u));
    line-height: 1.55;
    color: var(--text-faint);
    text-shadow: 0 calc(1 * var(--u)) calc(6 * var(--u)) rgb(0 0 0 / 0.9);
  }

  .enter__cta--quiet {
    border-color: transparent;
    background: none;
    padding-inline: 0;
    text-decoration: underline;
    text-underline-offset: calc(5 * var(--u));
    text-decoration-color: var(--text-faint);
  }

  /* ── The readout block ─────────────────────────────────────────── */
  /*
   * 73.5%, not 69%. At 69% the status line sat on top of the two controls above
   * it — the left column is taller than the reference's because the locked
   * claim is four lines where the reference's invented one is three, and the
   * locked sub-line is three lines where the reference's is two. The reference
   * position was measured correctly and then applied to a column carrying more
   * text; the composition moves rather than the words.
   */
  /*
   * 79%, not 73.5%.
   *
   * The left column grew when the live-system CTA took its own row and gained a
   * line of explanation beneath it, and the readout — positioned against the
   * reference frame, whose column is shorter — was overlapped by 33px at 1440.
   * Measured, not eyeballed. The reference position was right for the
   * reference's column; this one carries more, so the block beneath it moves
   * rather than the words being cut to fit.
   */
  .enter__readout {
    position: absolute;
    left: 4.8%;
    top: 79%;
    width: 29%;
  }

  .enter__state {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
    margin: 0 0 calc(18 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(16 * var(--u));
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /*
   * Unlit until something is measured — the glow rule. `:root[data-liveness]`
   * is set by the one measurement the page makes, so every instrument changes
   * together or not at all.
   */
  .enter__state-dot {
    width: calc(9 * var(--u));
    height: calc(9 * var(--u));
    border-radius: 50%;
    background: var(--text-faint);
  }

  :global(:root[data-liveness='live']) .enter__state-dot {
    background: var(--signal);
    box-shadow: 0 0 calc(12 * var(--u)) var(--signal);
  }

  :global(:root[data-liveness='live']) .enter__state {
    color: var(--signal);
  }

  :global(:root[data-liveness='down']) .enter__state-dot {
    background: var(--fault);
  }

  :global(:root[data-liveness='down']) .enter__state {
    color: var(--fault);
  }

  .enter__note {
    margin: calc(18 * var(--u)) 0 0;
    font-size: calc(14 * var(--u));
    line-height: 1.5;
    color: var(--text-faint);
    text-shadow: 0 calc(1 * var(--u)) calc(6 * var(--u)) rgb(0 0 0 / 0.9);
  }

  .enter__scroll {
    position: absolute;
    left: 4.8%;
    top: 94.2%;
    display: flex;
    align-items: center;
    gap: calc(16 * var(--u));
    margin: 0;
    font-family: var(--font-mono);
    font-size: calc(15 * var(--u));
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .enter__scroll-icon {
    width: calc(18 * var(--u));
    height: calc(29 * var(--u));
    border: 1px solid var(--text-faint);
    border-radius: calc(10 * var(--u));
  }

  /* ── The mobile composition ────────────────────────────────────── */
  .enterM__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .enterM__claim {
    margin: 0;
    font-size: clamp(2.1rem, 9vw, 3.1rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .enterM__lede {
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .enterM__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .enterM__chips li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--plate-edge);
    border-radius: 3px;
    background: var(--plate-scrim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .enterM__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.25rem;
    margin: 1.75rem 0 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--plate-edge);
    border-radius: 6px;
    background: var(--plate-scrim);
  }

  .enterM__stats dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .enterM__stats dd {
    margin: 0.3rem 0 0;
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .enterM__note,
  .enterM__counts {
    margin: 1rem 0 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-faint);
  }

  .enterM__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  /*
   * The mobile composition has no `--u`, so the shared CTA rule's container
   * units resolve to zero there. It gets ordinary lengths instead.
   */
  .enterM__actions .enter__cta {
    padding: 0.75rem 1.1rem;
    border-radius: 3px;
    font-size: 0.78rem;
    gap: 0.6rem;
  }

  .enterM__actions .enter__cta--quiet {
    padding-inline: 0;
    text-underline-offset: 4px;
  }
</style>
