---
/**
 * System card — blueprint §5: badge, title, one-line problem, 3 stack tags,
 * arrow link. Hover lifts 2px and turns the border accent.
 *
 * Accessibility: the whole card is a click target, but there is exactly one
 * link in the accessible tree — the heading link, stretched over the card with
 * a pseudo-element. Wrapping the entire card in an anchor would force screen
 * readers to announce the badge, problem, and every stack tag as part of the
 * link text.
 */
import type { Status } from '../schemas/constitution';
import { STATUS_LABELS } from '../schemas/constitution';
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  status: Status;
  statusDetail?: string;
  problem: string;
  stack: string[];
  href: string;
  /**
   * The heading level this card sits at.
   *
   * A card cannot know its own level — that is a property of where it is used,
   * not of what it is. Hardcoding `h3` was correct on Home, where the cards sit
   * under an `h2` section header, and wrong on `/systems/`, where they follow
   * the `h1` directly and left a skipped level. Lighthouse caught it on the
   * route once P8 extended the accessibility gate past the two pages the
   * blueprint originally named.
   */
  headingLevel?: 2 | 3;
}

const { title, status, statusDetail, problem, stack, href, headingLevel = 3 } = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';

/*
 * The card takes its colour from the system's own status.
 *
 * The tone was already defined in the constitution and already used by the
 * badge — it just never reached the card, so three systems in three genuinely
 * different states rendered as three identical grey rectangles. A platform
 * running in a hospital and one that has never had a user looked the same,
 * which is the one distinction this section exists to draw.
 *
 * This adds no colour to the palette and invents no meaning: green already
 * means in production, amber already means pre-launch. It just lets the card
 * say what the badge inside it was already saying.
 */
const { tone } = STATUS_LABELS[status];

/** Blueprint §5 fixes the card at three tags; the full stack lives on the case study. */
const shownStack = stack.slice(0, 3);
---

<article class="system-card" data-tone={tone}>
  <StatusBadge status={status} detail={statusDetail} />
  <Heading class="card-title"><a href={href}>{title}</a></Heading>
  <p class="problem">{problem}</p>
  <ul class="stack">
    {shownStack.map((tag) => <li>{tag}</li>)}
  </ul>
  <span class="arrow" aria-hidden="true">Read the engineering →</span>
</article>

<style>
  .system-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--bg-raised);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
    height: 100%;
    transition:
      border-color var(--duration-micro) var(--ease-out),
      transform var(--duration-micro) var(--ease-out);
  }

  /*
   * A status rail down the leading edge, in the status's own colour. It is the
   * first thing the eye resolves in a grid of three, so the state of each
   * system is legible before a single word is read — which is the ranking a
   * reader actually needs and the one the grid was failing to give.
   */
  .system-card::before {
    content: '';
    position: absolute;
    inset-block: -1px;
    inset-inline-start: -1px;
    width: 3px;
    border-start-start-radius: var(--radius);
    border-end-start-radius: var(--radius);
    background: var(--tone-colour, var(--border));
  }

  .system-card[data-tone='accent'] {
    --tone-colour: var(--accent);
  }

  .system-card[data-tone='warm'] {
    --tone-colour: var(--accent-warm);
  }

  .system-card[data-tone='muted'] {
    --tone-colour: var(--text-muted);
  }

  /* Hover answers in the card's own colour rather than a universal green, so
     the response confirms which system you are pointing at. */
  .system-card:hover {
    border-color: var(--tone-colour, var(--accent));
    transform: translateY(-2px);
  }

  /* The card must show focus when the heading link inside it is focused,
     otherwise keyboard users get a focus ring on invisible stretched text. */
  .system-card:focus-within {
    border-color: var(--accent);
  }

  /* Styled by class, not by tag: the heading level varies with where the card
     is used, and the card must look identical at either level. */
  .card-title {
    font-size: var(--text-md);
    margin: 0;
  }

  .card-title a {
    color: var(--text);
    text-decoration: none;
  }

  /* Stretched link: one anchor, whole-card hit area. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .problem {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .stack li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
  }

  .arrow {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .system-card:hover {
      transform: none;
    }
  }
</style>
