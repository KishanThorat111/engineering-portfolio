---
/**
 * THE TRACE RAIL — the horizontal request path on references 01, 02, 03 and 04.
 *
 * A connected row of nodes, each a dot with a name and a sub-label, reading
 * left to right from the browser to the response.
 *
 * WHAT IS REAL HERE, AND WHAT CANNOT BE
 * The references show `GET /api/bookings 200 32ms Mumbai` with seven per-hop
 * timings. This site cannot publish per-hop production timings — they are not
 * measured anywhere a visitor could verify, and rule 4 says an unknown fact is
 * unstated rather than estimated.
 *
 * What it CAN publish is the one request the visitor's own browser just made:
 * `GET /health` against this origin, its status, and its total round trip,
 * measured by `performance.now()` either side of the fetch. That is one real
 * number rather than seven invented ones, and it is a number the reader can
 * reproduce in their own devtools in about four seconds.
 *
 * So the rail's hops are labelled with what each hop IS — the architecture,
 * which is a published fact — and carry no per-hop timing at all. The total is
 * the measured one, shown once, at the end, where the reference puts it.
 *
 * WHEN THE CONTROL PLANE IS DOWN
 * Every node renders `idle`, the total reads `no answer`, and the caption says
 * so. It does not show a stale time, a cached time, or a zero. Rule 12: degraded
 * says so, on the same instrument.
 */
export interface Hop {
  /** The hop's name, e.g. `EDGE`. */
  name: string;
  /** What that hop is, in this system. Architecture, not telemetry. */
  detail: string;
  tone?: 'structure' | 'signal' | 'isolation' | 'record';
}

interface Props {
  hops: Hop[];
  /** The request line, e.g. `GET /health`. */
  request: string;
  class?: string;
}

const { hops, request, class: className } = Astro.props;
---

<div class:list={['trace', className]} data-trace style={`--hops:${hops.length}`}>
  <div class="trace__head">
    <p class="trace__request">{request}</p>
    <p class="trace__total">
      <span class="trace__total-label">TOTAL</span>
      <span data-trace-total>—</span>
    </p>
  </div>

  <ol class="trace__rail">
    {
      hops.map((hop) => (
        <li class="trace__hop">
          <span class={`trace__dot trace__dot--${hop.tone ?? 'structure'}`} aria-hidden="true" />
          <span class="trace__name">{hop.name}</span>
          <span class="trace__detail">{hop.detail}</span>
        </li>
      ))
    }
  </ol>

  <p class="trace__caption" data-trace-caption>
    Not yet measured. This line fills in when your browser completes a request to the control plane.
  </p>
</div>

<style>
  .trace {
    display: block;
  }

  .trace__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(16 * var(--u));
    margin-bottom: calc(16 * var(--u));
  }

  .trace__request {
    margin: 0;
    font-family: var(--font-mono);
    font-size: calc(19 * var(--u));
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .trace__total {
    display: flex;
    align-items: baseline;
    gap: calc(9 * var(--u));
    margin: 0;
    font-family: var(--font-mono);
    font-size: calc(19 * var(--u));
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .trace__total-label {
    font-size: calc(13 * var(--u));
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  .trace__rail {
    position: relative;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trace__hop {
    position: relative;
    flex: 1 1 0;
    padding-top: calc(32 * var(--u));
    text-align: center;
  }

  /*
    The connector. Drawn between hops rather than through them, so the line
    reads as the path and the dot reads as the stop — which is how a trace is
    drawn on paper and why the reference is legible at a glance.
  */
  .trace__hop::before {
    content: '';
    position: absolute;
    top: calc(8 * var(--u));
    left: calc(-50% + 14 * var(--u));
    width: calc(100% - 28 * var(--u));
    border-top: 1px solid color-mix(in srgb, var(--text-faint) 70%, transparent);
  }

  /* The arrowhead the reference draws on every leg: the path has a direction. */
  .trace__hop::after {
    content: '';
    position: absolute;
    top: calc(5 * var(--u));
    left: calc(50% - 20 * var(--u));
    width: calc(6 * var(--u));
    height: calc(6 * var(--u));
    border-top: 1px solid color-mix(in srgb, var(--text-faint) 80%, transparent);
    border-right: 1px solid color-mix(in srgb, var(--text-faint) 80%, transparent);
    transform: rotate(45deg);
  }

  .trace__hop:first-child::before,
  .trace__hop:first-child::after {
    display: none;
  }

  .trace__dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: calc(16 * var(--u));
    height: calc(16 * var(--u));
    border-radius: 50%;
    /*
      Each stop carries its own colour as a RING, as the reference's do. It is
      dark inside and gives off no light, and that is the glow rule: nothing
      emits light unless it is carrying a real measurement. They fill and glow
      together, once, when a round trip actually completes.
    */
    background: var(--bg-raised);
    border: 2px solid color-mix(in srgb, var(--dot, var(--structure)) 70%, var(--plate-edge));
  }

  .trace__dot--structure {
    --dot: var(--structure);
  }
  .trace__dot--signal {
    --dot: var(--signal);
  }
  .trace__dot--isolation {
    --dot: var(--isolation);
  }
  .trace__dot--record {
    --dot: var(--record);
  }

  [data-trace][data-state='live'] .trace__dot--structure {
    background: var(--structure);
    border-color: var(--structure);
  }
  [data-trace][data-state='live'] .trace__dot--signal {
    background: var(--signal);
    border-color: var(--signal);
    box-shadow: 0 0 calc(10 * var(--u)) var(--signal);
  }
  [data-trace][data-state='live'] .trace__dot--isolation {
    background: var(--isolation);
    border-color: var(--isolation);
    box-shadow: 0 0 calc(10 * var(--u)) var(--isolation);
  }
  [data-trace][data-state='live'] .trace__dot--record {
    background: var(--record);
    border-color: var(--record);
    box-shadow: 0 0 calc(10 * var(--u)) var(--record);
  }

  /* Down: the rings dim. What failed is stated in words beside them. */
  [data-trace][data-state='down'] .trace__dot {
    border-color: color-mix(in srgb, var(--dot, var(--structure)) 40%, var(--plate-edge));
  }

  /*
   * MOTION IS MEASUREMENT: THE PULSE CROSSES AT THE SPEED OF YOUR ROUND TRIP.
   *
   * When the liveness probe gets an answer it writes the measured round trip
   * to `--trace-ms`, and one point of light crosses the rail from the first
   * hop to the last in that time scaled by 25 — the real figure is a few tens
   * of milliseconds, too fast to see, so it is slowed by a fixed factor the
   * caption states. Linear, because the easing would otherwise be inventing a
   * shape the measurement does not have. One crossing per measurement, never a
   * loop: a repeating pulse would claim traffic that is not happening.
   *
   * It never runs when the plane did not answer, and never under reduced
   * motion, where the caption still states the time.
   */
  .trace__rail::after {
    content: '';
    position: absolute;
    top: calc(8 * var(--u) - 6px);
    left: calc(100% / var(--hops, 6) / 2 - 6px);
    width: calc(100% * (var(--hops, 6) - 1) / var(--hops, 6));
    height: 12px;
    background: radial-gradient(
      circle 6px at 6px 50%,
      #fff 0 2px,
      var(--hue-blue) 3px,
      transparent 6px
    );
    filter: drop-shadow(0 0 6px var(--hue-blue));
    opacity: 0;
    pointer-events: none;
  }

  @keyframes trace-pulse {
    0% {
      translate: 0 0;
      opacity: 1;
    }

    96% {
      opacity: 1;
    }

    100% {
      translate: 100% 0;
      opacity: 0;
    }
  }

  :global(.stage[data-in])
    [data-trace][data-state='live'][style*='--trace-ms']
    .trace__rail::after {
    animation: trace-pulse calc(var(--trace-ms) * 25ms) linear 0.4s 1 both;
  }

  @media (prefers-reduced-motion: reduce) {
    .trace__rail::after {
      display: none;
    }
  }

  .trace__name {
    display: block;
    font-family: var(--font-sans);
    font-size: calc(18 * var(--u));
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
  }

  .trace__detail {
    display: block;
    margin-top: calc(5 * var(--u));
    font-family: var(--font-sans);
    font-size: calc(14 * var(--u));
    color: var(--text-muted);
  }

  /* Child-qualified: inside a panel, the panel's own paragraph rule
     (`.pnl__body p`) outranked a single class and set this gap to zero, so
     the caption sat directly on the stops' details. */
  .trace > .trace__caption {
    margin: calc(22 * var(--u)) 0 0;
    font-family: var(--font-sans);
    font-size: calc(14 * var(--u));
    line-height: 1.55;
    color: var(--text-muted);
  }
</style>
