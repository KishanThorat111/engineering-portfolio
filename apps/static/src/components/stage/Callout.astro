---
/**
 * A CALLOUT — the thing that makes this a technical drawing rather than a
 * picture with writing next to it.
 *
 * A marker dot on a point of the plate, a leader line from that dot, and a
 * label with up to two supporting lines. The references use this object more
 * than any other, on nine of the ten frames.
 *
 * POSITIONED IN PERCENT, ON PURPOSE
 * `x` and `y` place the DOT, as a percentage of the stage. Because the stage is
 * locked to the plate's ratio, a percentage is a fixed point on the artwork — so
 * a dot placed on the API gateway tier stays on the API gateway tier at 1440px,
 * at 1200px and at 1025px. Pixels would not survive the first resize.
 *
 * THE LEADER IS A BORDER, NOT AN SVG
 * One absolutely-positioned element with a 1px edge. An SVG per callout would
 * be sixty extra elements across the page and a second coordinate system to
 * keep in sync with the first. The leader is decoration in the strictest sense —
 * it carries no information the dot and the label do not already carry — so it
 * is `aria-hidden` and costs the accessibility tree nothing.
 *
 * WHAT `side` ACTUALLY CONTROLS
 * Which way the text sits from the dot, and therefore which way the leader
 * runs: `left` means the callout lives in the left margin and reaches right
 * toward the subject; `right` is the mirror. It is not an alignment preference,
 * it is which side of the plate's subject this label belongs to.
 *
 * EVERY CALLOUT IS REAL TEXT
 * Label and detail lines are ordinary elements in the light DOM, selectable,
 * searchable, translatable, and read in source order. None of this is baked
 * into the image — the reference's own labels are AI-generated and several of
 * them are misspelled, which is a standing reminder of why they are never a
 * source of truth.
 */
interface Props {
  /** Dot position across the stage, in percent. */
  x: number;
  /** Dot position down the stage, in percent. */
  y: number;
  /** Which margin this callout belongs to, and therefore which way it reaches. */
  side?: 'left' | 'right';
  /** The thing being named. Rendered uppercase, in mono. */
  label: string;
  /** Up to two supporting lines. Real facts only — never invented detail. */
  lines?: string[];
  /**
   * Leader length as a percentage of stage width. 0 draws no leader, which is
   * correct when the dot is already touching the thing it names.
   */
  lead?: number;
  /**
   * The register entry this callout's dot carries. Colour means state, never
   * decoration (§3.4), so a callout that is not reporting a state stays neutral.
   */
  tone?: 'structure' | 'signal' | 'isolation' | 'record' | 'pending' | 'fault';
  /** Width of the text block, in percent of the stage. */
  w?: number;
  /**
   * Draws a hairline under the label running the full width of the block to
   * the dot — reference 03's treatment, where each layer's name sits on a rule
   * that leads into the slab it names.
   */
  rule?: boolean;
  /**
   * Position in a firing sequence. Station 01 lights its labels one after
   * another on arrival; the order is set here because that frame animates from
   * first paint, before any script has run to compute one.
   */
  seq?: number;
}

const {
  x,
  y,
  side = 'left',
  label,
  lines = [],
  lead = 0,
  tone = 'structure',
  w = 15,
  rule = false,
  seq,
} = Astro.props;
---

<div
  class:list={['cal', `cal--${side}`, rule && 'cal--rule']}
  style={`--x:${x}%; --y:${y}%; --lead:${lead}%; --w:${w}%; --tone:var(--${tone})${seq === undefined ? '' : `; --i:${seq}`}`}
>
  <span class="cal__dot" aria-hidden="true"></span>
  {lead > 0 && <span class="cal__lead" aria-hidden="true" />}
  <div class="cal__text">
    <p class="cal__label">{label}</p>
    {lines.map((line) => <p class="cal__line">{line}</p>)}
  </div>
</div>

<style>
  .cal {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
  }

  .cal--right {
    /* The anchor is the dot, so a right-hand callout grows leftward from it. */
    transform: translateX(-100%);
  }

  .cal__dot {
    position: absolute;
    top: calc(7 * var(--u));
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    border-radius: 50%;
    background: var(--tone);
    /*
      A faint halo so a 7px dot survives on a bright region of a plate. Sized in
      --u like everything else, so it scales with the frame rather than becoming
      a blob at small sizes.
    */
    box-shadow: 0 0 calc(10 * var(--u)) color-mix(in srgb, var(--tone) 70%, transparent);
  }

  .cal--left .cal__dot {
    left: 0;
  }

  .cal--right .cal__dot {
    right: 0;
  }

  .cal__lead {
    position: absolute;
    top: calc(10 * var(--u));
    width: var(--lead);
    border-top: 1px solid color-mix(in srgb, var(--tone) 42%, transparent);
  }

  .cal--left .cal__lead {
    left: calc(100% + 8 * var(--u));
  }

  .cal--right .cal__lead {
    right: calc(100% + 8 * var(--u));
  }

  /*
   * NO BOX. THE LABEL SITS ON THE ARTWORK, THE WAY THE REFERENCE DRAWS IT.
   *
   * The previous version darkened a rectangle behind each label with
   * `backdrop-filter`, feathered at the edges. Measured contrast was fine. It
   * also put a dark tab behind every one of the eleven labels on station 01,
   * and once the plate was restored to full strength those tabs were the most
   * visible thing on the right of the frame — a row of black patches over the
   * artwork the labels are there to explain. The reference has none.
   *
   * What legibility actually needs is the pixels immediately AROUND each glyph
   * to be dark, not a rectangle. That is what a layered halo does: a tight core
   * shadow for the stroke edges, a mid glow for the counters and gaps, and a
   * wide faint one to pull down the field between lines. It follows the shape
   * of the letters, so there is no edge to see.
   *
   * The contrast is re-measured with the halo IN PLACE and only the glyph fill
   * removed, because the halo is the background the text is read against.
   * Measuring with the shadow stripped would be testing a design that no longer
   * ships.
   */
  .cal__text {
    /* Clears the dot. */
    padding-inline-start: calc(18 * var(--u));
    position: relative;
    isolation: isolate;
  }

  .cal--right .cal__text {
    padding-inline-start: 0;
    padding-inline-end: calc(18 * var(--u));
    text-align: right;
  }

  /*
   * A POOL OF SHADOW, NOT A BOX.
   *
   * The halo handles most placements on its own. It cannot handle a neon edge
   * running straight through a line of text — measured at 1.76:1 where station
   * 04's Browser label crosses the laptop's lit frame — because the halo only
   * reaches as far as each glyph's own shadow radius and the gaps between words
   * stay bright.
   *
   * So each label also sits in a pool: a dark ellipse blurred by more than its
   * own size. A blurred ellipse has no edge to find, which is the whole
   * difference from the box this replaced — that one was a rectangle feathered
   * over twelve pixels, and its sides were plainly visible. On dark artwork the
   * pool is indistinguishable from the plate; on a bright edge it reads as the
   * kind of local shadow a lit object would cast.
   */
  .cal__text::before {
    content: '';
    position: absolute;
    inset: calc(-10 * var(--u)) calc(-16 * var(--u));
    z-index: -1;
    pointer-events: none;
    border-radius: 50%;
    background: rgb(3 5 10 / 0.72);
    filter: blur(calc(22 * var(--u)));
  }

  /*
   * Set the way the references set them: a medium-weight sans in capitals,
   * lightly tracked, a size up from the lines beneath it. It was mono at 0.1em,
   * which reads as a code annotation; the references read as a labelled
   * diagram, and the difference is mostly the face.
   */
  .cal__label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: calc(20 * var(--u));
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text);
    text-shadow:
      0 0 calc(2 * var(--u)) rgb(3 5 10 / 0.95),
      0 0 calc(7 * var(--u)) rgb(3 5 10 / 0.9),
      0 0 calc(16 * var(--u)) rgb(3 5 10 / 0.75),
      0 0 calc(30 * var(--u)) rgb(3 5 10 / 0.55);
  }

  .cal--rule .cal__label {
    display: block;
    padding-bottom: calc(8 * var(--u));
    margin-bottom: calc(4 * var(--u));
    border-bottom: 1px solid color-mix(in srgb, var(--structure) 42%, transparent);
  }

  .cal__line {
    margin: calc(6 * var(--u)) 0 0;
    font-family: var(--font-sans);
    font-size: calc(18.5 * var(--u));
    line-height: 1.45;
    /* Brighter than muted: the reference's sub-lines are a light grey, a
       step below the label rather than three. */
    color: color-mix(in srgb, var(--text) 68%, var(--text-muted));
    text-shadow:
      0 0 calc(2 * var(--u)) rgb(3 5 10 / 0.95),
      0 0 calc(7 * var(--u)) rgb(3 5 10 / 0.9),
      0 0 calc(16 * var(--u)) rgb(3 5 10 / 0.75),
      0 0 calc(30 * var(--u)) rgb(3 5 10 / 0.55);
  }
</style>
