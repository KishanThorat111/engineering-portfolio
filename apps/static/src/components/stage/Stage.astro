---
/**
 * THE STAGE — one fixed-ratio frame per station, and the reason the overlay
 * never drifts off the plate.
 *
 * WHAT PROBLEM THIS SOLVES
 * The previous treatment cropped each plate to `cover` behind a fluid column of
 * HTML. At 1440 the "API Gateway" label sat beside the tower; at 1100 the tower
 * had been cropped from the left and the label pointed at empty sky. A callout
 * that names a thing in a picture has to keep naming it at every width, and
 * there is exactly one way to guarantee that: the picture and the words must be
 * the same object, scaled together.
 *
 * So a station is a box locked to the plate's own 3:2 ratio, and everything
 * inside it is positioned in PERCENTAGES of that box and sized in units derived
 * from that box's width. Shrink the stage and the tower, the label, the leader
 * line and the type all shrink by the same factor, in lockstep, forever.
 *
 * `--u` IS ONE REFERENCE PIXEL
 * The design references are 2528×1685. `--u` is one of those pixels expressed in
 * container-query units, so a measurement taken off the reference goes straight
 * into the CSS:
 *
 *     a 48px heading in the reference   →   font-size: calc(48 * var(--u))
 *     a label 31% across the frame      →   left: 31%
 *
 * That turns "match the reference" from an eyeballing exercise into arithmetic.
 * `--u` is set on the layer rather than on `.stage` itself because an element
 * cannot query its own container.
 *
 * WHY NOT `transform: scale()` ON A FIXED-PIXEL LAYOUT
 * It would scale the type too, which sounds like the same thing and is not:
 * scaled text rasterises from a transformed layer and goes soft, it ignores the
 * reader's minimum font size, and it cannot reflow for the mobile composition.
 * Container units keep every glyph laid out and hinted at its real size.
 *
 * BELOW `--stage-min` THIS COMPOSITION IS ABANDONED, NOT SHRUNK
 * A 2528-wide cinematic frame reduced to a 390-wide phone is illegible however
 * carefully it scales — 10px type and a tower four thumbs wide. Under the
 * breakpoint the stage stops being a stage: the plate crops to its subject with
 * a per-station focal point and the overlay becomes an ordinary stacked
 * document. Two compositions, each correct for its width, is the honest answer;
 * one composition pretending to work at both is not.
 *
 * THE PLATE IS DECORATION AND THE OVERLAY IS THE PAGE
 * Everything readable is real HTML in the light DOM above the image. Remove the
 * plate and the station still says everything it says. That is the load-bearing
 * rule of this repository applied to layout: if the words needed the picture,
 * the picture would be content, and it would need alt text and a different set
 * of promises.
 */
import VisualWorld from '../VisualWorld.astro';
import { type StationId } from '../../config/visual-world';

interface Props {
  id: StationId;
  /** First stage on the page fetches its plate eagerly. */
  priority?: 'eager' | 'lazy';
  /**
   * How much of the plate's own brightness survives. 1 is untouched.
   *
   * The references are lit artwork and the previous treatment held every plate
   * at 0.55 with a scrim across the whole frame, which is why the world read as
   * wallpaper. Plates now run at or near full strength and legibility is bought
   * locally, under each text block, by the blocks themselves.
   */
  plate?: number;
  /**
   * Shifts the artwork sideways, in percent of the frame's width, within the
   * plate's 2% bleed (so never more than 2). Used where the artwork's own
   * pointer lines have to land under HTML labels at the reference's positions.
   */
  plateX?: number;
  /** Adds the fine technical grid over the plate. */
  grid?: boolean;
  /** Parallax depth; 0 disables drift for this station. */
  depth?: number;
  /** Accessible name for the section. */
  labelledby: string;
  /** Anchor for deep links. Defaults to the station id. */
  anchor?: string;
  class?: string;
  /**
   * What the artwork is on a phone or tablet. `card`: a framed picture at the
   * top of the section, at full strength. `backdrop`: full-bleed behind the
   * text (the opening frame). `none`: not drawn, because the section shows the
   * same plate as content of its own (07 and 08's portraits of the owner).
   */
  mobileArt?: 'card' | 'backdrop' | 'none';
  /**
   * Labels pinned to the artwork on a phone or tablet, as the references draw
   * them — a lit dot on the thing, a tag naming it. Positions are in the same
   * stage percentages as the wide composition's callouts, so the two can be
   * checked against each other; they are converted to the phone card below.
   * Only drawn in `card` mode. Every word must already be on the site.
   */
  pins?: readonly Pin[];
}

export interface Pin {
  /** Where the dot sits, in percent of the wide frame (the callouts' system). */
  x: number;
  y: number;
  label: string;
  /** Which side of the dot the tag sits: left, right, up or down. */
  side?: 'l' | 'r' | 'u' | 'd';
}

const {
  id,
  priority = 'lazy',
  plate = 1,
  plateX = 0,
  grid = true,
  depth = 1,
  labelledby,
  anchor,
  class: className,
  mobileArt = 'card',
  pins = [],
} = Astro.props;

/*
 * FROM THE WIDE FRAME TO THE PHONE CARD.
 *
 * Wide: the plate is 104% of the frame, offset -2% (its bleed), and moved
 * `plateX` to the right. Card: the plate is drawn 110% tall from -5% with
 * `object-fit: cover`, which at the card's 3:2 makes it 110% wide too, held at
 * `object-position: 62%` — 6.2% of the card off its left edge. A point on the
 * plate therefore lands at 1.1 × p − 0.062 across and 1.1 × p − 0.05 down.
 * The card is locked to 3:2 for exactly this reason.
 */
const toPlate = (s: number, shift = 0) => (s / 100 + 0.02 - shift / 100) / 1.04;
const pinned =
  mobileArt === 'card'
    ? pins.map((pin, i) => ({
        ...pin,
        i,
        left: ((1.1 * toPlate(pin.x, plateX) - 0.062) * 100).toFixed(2),
        top: ((1.1 * toPlate(pin.y) - 0.05) * 100).toFixed(2),
      }))
    : [];
---

<section
  class:list={[
    'stage',
    className,
    priority !== 'eager' && 'stage--deferred',
    `stage--m-${mobileArt}`,
  ]}
  id={anchor ?? id}
  aria-labelledby={labelledby}
  data-station={id}
  data-light=".vw"
  style={`--plate-strength:${plate}; --plate-x:${(Math.max(-2, Math.min(2, plateX)) / 1.04).toFixed(3)}%`}
>
  <VisualWorld id={id} priority={priority} depth={depth} grid={grid}>
    {
      pinned.length > 0 && (
        <div slot="pins" class="stage__pins" aria-hidden="true">
          {pinned.map((pin) => (
            <span
              class:list={['pin', `pin--${pin.side ?? 'r'}`]}
              style={`--l:${pin.left}%; --t:${pin.top}%; --i:${pin.i}`}
            >
              <span class="pin__dot" />
              <span class="pin__tag">{pin.label}</span>
            </span>
          ))}
        </div>
      )
    }
  </VisualWorld>

  {
    /*
      THE OVERLAY LAYER.

      Absolutely positioned over the whole frame, and the element that owns `--u`
      so every descendant inherits one reference pixel. `pointer-events: none`
      here with `auto` restored on interactive children, so the large empty
      regions of a station never swallow a click meant for the page.
    */
  }
  <div class="stage__layer">
    <slot />
  </div>

  {
    /*
      THE MOBILE COMPOSITION.

      A separate slot rather than a restyling of the one above. Under the
      breakpoint the two swap, and only one is in the accessibility tree at a
      time — `display: none` removes the other from it entirely, so a screen
      reader never meets both copies of the same sentence.
    */
  }
  <div class="stage__mobile">
    <slot name="mobile" />
  </div>
</section>

<style>
  .stage {
    position: relative;
    isolation: isolate;
    /*
      The plate's own ratio, so the frame never letterboxes and never crops the
      composition the callouts were positioned against.
    */
    aspect-ratio: 2528 / 1685;
    width: 100%;
    overflow: hidden;
    container-type: inline-size;
    background: var(--bg);
  }

  /*
   * OFFSCREEN STATIONS ARE NOT LAID OUT UNTIL THEY ARE NEEDED.
   *
   * Nine of the ten stations are below the fold and each carries a full overlay
   * — panels, callouts, stat strips, a trace rail. Styling and laying all of
   * that out before first paint is work the reader cannot see, and it lands
   * squarely in the window LCP is measured in: the homepage went from 0.97 to
   * 0.87 when stations 02–10 arrived.
   *
   * `content-visibility: auto` lets the browser skip layout and paint for a
   * section that is off screen and do it when the section approaches. It is
   * applied only to deferred stations; the eager one is never skipped, because
   * it contains the LCP element.
   *
   * NO `contain-intrinsic-size` IS NEEDED, and that is why this is safe rather
   * than a CLS risk. A skipped element normally collapses to zero height and the
   * scrollbar jumps when it is realised — but these sections already declare
   * their own height without reference to their contents: `aspect-ratio` on the
   * stage, and `min-height: 100svh` in the narrow composition. The box is the
   * same size skipped or not. Verified by measurement, not by argument: CLS is
   * 0.000 across zero layout-shift entries after this change.
   */
  .stage--deferred {
    content-visibility: auto;
  }

  .stage__layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    /* One reference pixel. Everything inside measures in multiples of this. */
    --u: calc(100cqw / 2528);
    pointer-events: none;
  }

  .stage__layer :global(a),
  .stage__layer :global(button),
  .stage__layer :global(.stage-interactive),
  .stage__layer :global(.pnl) {
    pointer-events: auto;
  }

  .stage__mobile {
    display: none;
  }

  /*
    THE SWAP.

    1024px is where the reference composition stops being readable rather than
    where a device boundary sits: below it the frame is under 1024/2528 = 40% of
    the size the type was designed at, which puts the reference's 28px body copy
    under 11px. Chosen by that arithmetic, not by a breakpoint convention.
  */
  @media (max-width: 1024px) {
    .stage {
      /*
        Ratio is released. The station becomes as tall as its content needs,
        with a minimum so the cropped plate still reads as a place.
      */
      aspect-ratio: auto;
      min-height: 100svh;
      display: grid;
      align-items: end;
    }

    .stage__layer {
      display: none;
    }

    .stage__mobile {
      display: block;
      position: relative;
      z-index: 2;
      /*
       * The same inline padding as the site header's container, so the text
       * lines up under the wordmark. It used --gutter, the 72px desktop margin
       * the station rail used to occupy — on a 390px phone that spent over a
       * third of the width on empty margin once the rail was gone.
       */
      padding: clamp(3rem, 10vw, 6rem) var(--space-4) clamp(3rem, 9vw, 5rem);
      width: 100%;
      /*
       * A grid item's minimum width defaults to its content's, so one
       * unbreakable line anywhere in a station could widen this whole column
       * past the screen — and the stage clips, so the page never reported it.
       * Zero lets the column hold the viewport and makes its contents wrap.
       */
      min-width: 0;
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .stage__mobile {
      padding-inline: var(--space-6);
    }
  }

  /*
   * THE ARTWORK AS A PICTURE, NOT A BACKDROP.
   *
   * On a phone the plate sat behind the stacked text under a scrim dark enough
   * to read paragraphs over — so every section opened on a dim, empty band
   * and the scenes that carry the wide composition were mostly lost. Stations
   * 07 and 08 already showed theirs as a framed picture above the text, and
   * read best. Every station after the opening one now does: the same plate
   * file (no extra download), at full strength, framed, with the text below
   * it on the page's own ground. The plate keeps a few pixels of bleed inside
   * the frame so its scroll drift moves the scene within the frame.
   */
  @media (max-width: 1024px) {
    .stage--m-card,
    .stage--m-none {
      display: block;
      min-height: 0;
    }

    .stage--m-card {
      padding-top: clamp(3rem, 12vw, 5rem);
    }

    .stage.stage--m-card > :global(.vw) {
      position: relative;
      inset: auto;
      /*
       * Always the plate's own 3:2, so the pins land on what they name at
       * every width. A short landscape screen gets a smaller card, centred,
       * rather than a different crop of the scene.
       */
      width: min(calc(100% - 2 * var(--space-4)), calc(72svh * 1.5));
      margin-inline: auto;
      aspect-ratio: 3 / 2;
      container-type: inline-size;
      border: 1px solid rgb(255 255 255 / 0.09);
      border-radius: 14px;
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 30px 60px -34px rgb(0 0 0 / 0.95),
        0 0 0 1px rgb(124 146 255 / 0.05);
    }

    .stage.stage--m-card > :global(.vw) :global(.vw__plate) {
      top: -5%;
      height: 110%;
      opacity: var(--plate-strength, 1);
    }

    /* Nothing is read over the picture, so it needs no floor — only a soft
       fall-off at its foot. */
    .stage.stage--m-card > :global(.vw) :global(.vw__scrim) {
      background: linear-gradient(to bottom, transparent 62%, rgb(8 10 16 / 0.38));
    }

    .stage--m-card > .stage__mobile {
      padding-top: var(--space-6);
    }

    .stage.stage--m-none > :global(.vw) {
      display: none;
    }

    .stage--m-none > .stage__mobile {
      padding-top: clamp(3rem, 12vw, 5rem);
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .stage.stage--m-card > :global(.vw) {
      width: min(calc(100% - 2 * var(--space-6)), calc(72svh * 1.5));
    }
  }

  /*
   * A phone on its side is 320–430px tall. The top padding is sized from the
   * width, so there it spent a quarter of the screen above the eyebrow.
   */
  @media (max-width: 1024px) and (max-height: 500px) {
    .stage__mobile {
      padding-top: var(--space-8);
    }
  }

  /*
   * THE PINS. A dot on the thing, a short rule, and a tag on its own dark
   * backing so it reads over any part of the scene. They ride the plate's
   * scroll drift (`--vw-plate-y`, set on the frame by visual-world.ts), so a
   * dot stays on its subject while the scene moves, and they are never drawn
   * on the wide composition, which has its own callouts.
   */
  .stage__pins {
    display: none;
  }

  @media (max-width: 1024px) {
    .stage__pins {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      translate: 0 var(--vw-plate-y, 0px);
      font-family: var(--font-mono);
      font-size: clamp(10.5px, 3.05cqw, 13px);
      line-height: 1;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }

  .pin {
    position: absolute;
    left: var(--l);
    top: var(--t);
  }

  .pin__dot {
    position: absolute;
    left: -4px;
    top: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 2px rgb(124 146 255 / 0.55),
      0 0 12px 2px rgb(139 108 246 / 0.75);
  }

  .pin__tag {
    position: absolute;
    white-space: nowrap;
    padding: 0.32em 0.55em 0.3em;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 5px;
    background: rgb(8 10 16 / 0.82);
    color: var(--text);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* The rule from the dot to its tag. */
  .pin__tag::before {
    content: '';
    position: absolute;
    background: rgb(255 255 255 / 0.45);
  }

  .pin--r .pin__tag {
    left: 12px;
    top: 0;
    translate: 0 -50%;
  }

  .pin--l .pin__tag {
    right: 12px;
    top: 0;
    translate: 0 -50%;
  }

  .pin--r .pin__tag::before,
  .pin--l .pin__tag::before {
    top: 50%;
    width: 8px;
    height: 1px;
  }

  .pin--r .pin__tag::before {
    right: 100%;
  }

  .pin--l .pin__tag::before {
    left: 100%;
  }

  .pin--u .pin__tag {
    bottom: 12px;
    left: 0;
    translate: -50% 0;
  }

  .pin--d .pin__tag {
    top: 12px;
    left: 0;
    translate: -50% 0;
  }

  .pin--u .pin__tag::before,
  .pin--d .pin__tag::before {
    left: 50%;
    width: 1px;
    height: 8px;
  }

  .pin--u .pin__tag::before {
    top: 100%;
  }

  .pin--d .pin__tag::before {
    bottom: 100%;
  }

  /* (After the base rules, which they override.) The smallest phones (a card under 340px): the same words, set tighter,
     so neighbouring tags keep their gap and the left column clears the edge. */
  @container (max-width: 340px) {
    .stage__pins {
      font-size: 10px;
      letter-spacing: 0.02em;
    }

    .pin__tag {
      padding: 0.24em 0.4em 0.22em;
    }
  }

  /* 320px phones: a shorter rule and a slimmer tag, the words unchanged. */
  @container (max-width: 300px) {
    .pin__tag {
      padding: 0.16em 0.34em 0.14em;
    }

    .pin--r .pin__tag {
      left: 9px;
    }

    .pin--l .pin__tag {
      right: 9px;
    }

    .pin--r .pin__tag::before,
    .pin--l .pin__tag::before {
      width: 5px;
    }
  }

  /*
   * They light in turn as the picture arrives: stage-motion.ts holds them and
   * shows them in reading order (stations.css, "pins"). Without script, and
   * under reduced motion, they are simply there.
   */
</style>
