---
/**
 * AN ACTIVITY FEED — reference 06's LIVE EVENT STREAM and 09's RECENT ADDITIONS.
 *
 * The references fill these with invented traffic: `20:23:11 POST /api/bookings
 * 800 30ms`, `Load Test Results — R2, 3m ago`, `Tenant Migration Log, 15m ago`.
 * There is no event stream to read while the control plane is offline, and the
 * repository's own recent activity is commits, not requests.
 *
 * Two honest sources fill it instead:
 *
 *   build-time   real entries from the repository's own collections — the
 *                decisions, lessons and evidence that were actually written,
 *                with the dates they carry. This is a true "recent additions"
 *                feed and it needs no network.
 *   live         when a row is bound to the liveness measurement it renders its
 *                unmeasured state until a reading lands.
 *
 * WHEN THERE IS NOTHING TO SHOW, IT SAYS SO IN THE FEED'S OWN SHAPE
 * An empty feed draws its rule and a single row explaining why it is empty,
 * rather than disappearing. A panel that vanishes when its source is down is
 * how a frame ends up with a hole in it, and the reader learns nothing.
 */
export interface Entry {
  /** Left column — a timestamp, a date, a short kind. */
  stamp: string;
  /** The event itself. */
  text: string;
  /** Right column — a status, a count, a source. */
  meta?: string;
  tone?: 'signal' | 'pending' | 'isolation' | 'record' | 'fault' | 'structure';
  href?: string;
}

interface Props {
  entries: Entry[];
  /** Sentence shown when there are no entries. */
  emptyNote?: string;
  /** Caps the rendered rows so a long collection cannot blow the panel. */
  limit?: number;
  /**
   * Lets the text run to as many lines as it needs, and stacks the row instead
   * of keeping three columns on one line.
   *
   * A feed is scanned, so one line per event is right for events. It is wrong
   * for a row whose text is a published STATEMENT: station 02 prints each
   * system's disclosed limitation here, and a limitation cut off at the panel
   * edge with an ellipsis is a limitation softened — the precise failure the
   * register exists to avoid. Where the row carries a claim rather than an
   * event, the claim wins and the panel grows.
   */
  wrap?: boolean;
  /**
   * Lays the rows out in this many columns on a wide stage.
   *
   * Four wrapped statements stacked down a band 64% of the frame wide ran off
   * the bottom of the stage. Cutting one to fit would have been the easy answer
   * and the wrong one — the count is the point, and a record dropped for layout
   * is a record hidden. Two columns halve the height and use the width the band
   * already has.
   *
   * Columns collapse to one below the stage breakpoint, where the narrow
   * composition takes over and there is no width to divide.
   */
  cols?: 1 | 2;
  class?: string;
}

const {
  entries,
  emptyNote = 'Nothing to report. This feed fills from the repository’s own record.',
  limit = 6,
  wrap = false,
  cols = 1,
  class: className,
} = Astro.props;

const rows = entries.slice(0, limit);
---

<ol class:list={['feed', wrap && 'feed--wrap', cols === 2 && 'feed--cols', className]}>
  {
    rows.length === 0 ? (
      <li class="feed__empty">{emptyNote}</li>
    ) : (
      rows.map((e) => (
        <li class="feed__row">
          {/*
            WHICH PART OF THE ROW IS THE LINK DEPENDS ON WHAT THE ROW IS.

            An event is one line, so the line itself is the link. A statement
            runs to three or four lines, and underlining all of them turns a
            published claim into a slab of rule — the underline stops reading as
            "this is a link" and starts reading as emphasis on the claim. So in
            the wrapped variant the SOURCE carries the link, which is also the
            truer target: the reader is being sent to the system, not to the
            sentence.
          */}
          {wrap && e.href ? (
            <a class="feed__stamp feed__stamp--link" href={e.href}>
              {e.stamp}
            </a>
          ) : (
            <span class="feed__stamp">{e.stamp}</span>
          )}
          {e.meta && (
            <span class:list={['feed__meta', `feed__meta--${e.tone ?? 'structure'}`]}>
              {e.meta}
            </span>
          )}
          {!wrap && e.href ? (
            <a class="feed__text" href={e.href}>
              {e.text}
            </a>
          ) : (
            <span class="feed__text">{e.text}</span>
          )}
        </li>
      ))
    )
  }
</ol>

<style>
  .feed {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feed__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: calc(12 * var(--u, 1px));
    padding: calc(8 * var(--u, 1px)) 0;
    border-bottom: 1px solid var(--plate-edge, #2b3345);
  }

  .feed__row:last-child {
    border-bottom: 0;
  }

  .feed__stamp {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u, 1px));
    letter-spacing: 0.06em;
    color: var(--text-faint);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .feed__text {
    font-size: calc(13 * var(--u, 1px));
    line-height: 1.4;
    color: var(--text);
    min-width: 0;
    /* One line per event: a feed is scanned, not read. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /*
   * The statement variant. The row becomes two bands — the source line above,
   * the claim below at full length — because a claim set in a 1fr middle column
   * beside a stamp and a status has nowhere near the measure it needs, and
   * squeezing it there is what produced the ellipsis in the first place.
   */
  .feed--cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: calc(28 * var(--u, 1px));
  }

  /* In two columns the rule between rows would draw a grid; the columns
     already separate the records, so only the vertical rule is kept. */
  .feed--cols .feed__row {
    border-bottom: 0;
    border-top: 1px solid var(--plate-edge, #2b3345);
  }

  .feed--wrap .feed__row {
    grid-template-columns: 1fr auto;
    align-items: baseline;
    row-gap: calc(5 * var(--u, 1px));
    padding: calc(10 * var(--u, 1px)) 0;
  }

  .feed--wrap .feed__text {
    grid-column: 1 / -1;
    grid-row: 2;
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    color: var(--text-muted);
  }

  /*
   * SC 2.5.8's inline-in-sentence exception does not apply — this is a
   * standalone control on its own line — so the link clears 24px without
   * changing where the row sits.
   */
  .feed__stamp--link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--text-faint);
  }

  .feed__stamp--link:hover {
    color: var(--signal);
    text-decoration-color: var(--signal);
  }

  a.feed__text {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--text-faint);
  }

  a.feed__text:hover {
    color: var(--signal);
    text-decoration-color: var(--signal);
  }

  .feed__meta {
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u, 1px));
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--text-muted);
  }

  .feed__meta--signal {
    color: var(--signal);
  }
  .feed__meta--pending {
    color: var(--pending);
  }
  .feed__meta--fault {
    color: var(--fault);
  }
  .feed__meta--record {
    color: var(--record);
  }
  .feed__meta--isolation {
    color: var(--isolation);
  }

  .feed__empty {
    font-size: calc(12 * var(--u, 1px));
    line-height: 1.55;
    color: var(--text-faint);
    padding: calc(12 * var(--u, 1px)) 0;
    border-top: 1px dashed var(--plate-edge, #2b3345);
    border-bottom: 1px dashed var(--plate-edge, #2b3345);
  }
</style>
