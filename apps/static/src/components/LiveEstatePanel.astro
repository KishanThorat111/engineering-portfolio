---
/**
 * The live estate panel — the homepage's proof that this site is a system.
 *
 * WHY THIS EXISTS
 * Every portfolio claims to build production systems. This one runs one, and
 * until now said so in a text link in the middle of a paragraph. A visitor had
 * to take the claim on trust for the whole homepage and then discover, by
 * reading, that they could go and break something. The most unusual asset here
 * was the least visible.
 *
 * WHAT IS REAL HERE
 * Everything. The latency is measured in the visitor's own browser against the
 * deployed control plane. The demonstration count is read from
 * /v1/demonstrations, which the API generates from the same registry the live
 * surface uses. Nothing is animated to look busy and no number is invented.
 *
 * IT WORKS WITH NO JAVASCRIPT
 * The panel renders complete and correct from the server: heading, description,
 * the two architectural facts that do not need a network call, and the CTA. The
 * script below only ADDS the two figures that require asking the API. With JS
 * off, or the control plane down, the panel is honest and the route in still
 * works — it simply does not claim liveness it has not verified.
 *
 * WHY THE STATIC SURFACE NOW MAKES A NETWORK CALL
 * It previously had `connect-src 'none'` because it had nothing to talk to.
 * It now legitimately does: its own API, on its own origin. `connect-src 'self'`
 * is the correct policy for that rather than a loosening — it is still
 * same-origin only, and the page still ships no bundled JavaScript.
 */
import Button from './Button.astro';

/*
 * Two facts that are architecture, not telemetry, so they are true whether or
 * not the control plane answers and are rendered server-side.
 *
 * "2 isolation layers" is the ADR-0003 server-derived org scope plus PostgreSQL
 * row-level security — the two the isolation inspector reports separately, and
 * the pair the P8 audit proved independent by disabling RLS and watching the
 * app layer still refuse.
 */
const ARCHITECTURAL = [
  { value: '2', label: 'isolation layers', qualifier: 'org scope + RLS' },
  { value: '0', label: 'inbound ports', qualifier: 'tunnel only' },
];
---

<section class="live-panel" aria-labelledby="live-panel-heading" data-field-node="3">
  <div class="container section-inner">
    <span class="section-index" aria-hidden="true">01</span>
    <div class="panel-frame" data-live-panel>
      <header class="panel-head">
        <p class="panel-status" data-live-status>
          <span class="dot" aria-hidden="true"></span>
          <span data-live-status-text>A real control plane</span>
        </p>
        <h2 id="live-panel-heading">You can attack this one.</h2>
      </header>

      <dl class="metrics">
        {
          /* Filled by the script when the control plane answers. Rendered as
            unmeasured rather than zero, because unknown is not none. */
        }
        <div class="metric" data-metric="latency" hidden>
          <dt>round trip</dt>
          <dd><span data-metric-value>—</span><span class="unit">ms</span></dd>
        </div>
        <div class="metric" data-metric="demos" hidden>
          <dt>demonstrations</dt>
          <dd><span data-metric-value>—</span></dd>
        </div>
        {
          /*
           * The qualifier lives INSIDE the <dd>, not beside it. A <div> within
           * a <dl> may contain only <dt> and <dd>; a sibling <p> is invalid
           * grouping and axe flags it, which cost the homepage its perfect
           * accessibility score the first time this shipped.
           */
          ARCHITECTURAL.map((item) => (
            <div class="metric">
              <dt>{item.label}</dt>
              <dd>
                {item.value}
                <span class="qualifier">{item.qualifier}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      {
        /*
        THE TRACE IS THE SITE'S SIGNATURE, AND IT IS A REAL INSTRUMENT.

        Every portfolio can draw a chart. This one draws the round trip to its
        own control plane, sampled from the visitor's browser while they read,
        so the line is their latency to a system that is genuinely running. It
        cannot be faked by a site that has no backend, which is exactly why it
        belongs here rather than a decorative animation that any template could
        carry.

        It samples a bounded number of times and then stops. A page that pinged
        a production service forever to keep a graph moving would be spending
        someone else's resources on ornament.

        aria-hidden because it is a second rendering of numbers the DOM already
        states in text — the figure above it is the accessible one.
      */
      }
      <figure class="trace" data-trace hidden>
        <canvas data-trace-canvas width="1200" height="120" aria-hidden="true"></canvas>
        <figcaption data-trace-caption>
          Round trip to the control plane, sampled from your browser.
        </figcaption>
      </figure>

      <p class="panel-copy">
        A multi-tenant control plane on a demo plane, built to be attacked. It provisions you your
        own tenant, refuses your attempt to read another one, and shows you the exact database
        policy that stopped you.
      </p>

      <div class="panel-actions">
        <Button href="/live/">Enter the live system</Button>
        <p class="panel-note">
          Runs in your browser · no sign-up · your tenant is destroyed on a timer
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * THE ONE RECESSED SECTION ON THE PAGE.
   *
   * This was a rounded card in a container — the same object as everything
   * else, holding the only genuinely live thing on the site. It is now a well
   * cut edge-to-edge into the page: the inset material, ruled top and bottom,
   * running the full width. Nothing else on the homepage is full-bleed, so
   * arriving here is a change of place rather than another block of content,
   * which is the point. The site's one running system should be the moment the
   * page opens out.
   */
  .live-panel {
    background: var(--bg-inset);
    border-block: var(--border-width) solid var(--border);
    padding-block: var(--space-16);
  }

  @media (min-width: 1000px) {
    .live-panel {
      padding-block: var(--space-24);
    }
  }

  .panel-frame {
    position: relative;
  }

  /*
   * Two columns on a wide screen: the argument on the left, the instrument
   * reading on the right. Laid out by area rather than by reordering the DOM,
   * because the document order — what this is, what it measures, what it means,
   * how to enter — is the order it should be read and announced in.
   */
  @media (min-width: 900px) {
    .panel-frame {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'head readout'
        'copy readout'
        'actions readout';
      column-gap: var(--space-16);
      align-content: start;
    }

    .panel-head {
      grid-area: head;
    }

    .metrics {
      grid-area: readout;
      align-self: start;
    }

    .trace {
      grid-area: readout;
      align-self: end;
    }

    .panel-copy {
      margin-block-start: var(--space-6);
      grid-area: copy;
    }

    .panel-actions {
      grid-area: actions;
    }
  }

  .panel-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin: 0;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--text-muted);
    flex-shrink: 0;
  }

  /* Green only once the control plane has actually answered. */
  .panel-frame[data-state='live'] .dot {
    background: var(--accent);
  }

  .panel-frame[data-state='live'] .panel-status {
    color: var(--accent);
  }

  .panel-frame[data-state='down'] .dot {
    background: var(--accent-warm);
  }

  .panel-frame[data-state='down'] .panel-status {
    color: var(--accent-warm);
  }

  h2 {
    font-size: var(--text-mega);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-4) 0;
    max-width: 14ch;
  }

  /*
   * Two columns, and two columns at every width. It was four across on desktop,
   * which worked while the panel was full-width and broke the moment the panel
   * became two columns: four metric labels crushed into half a page wrapped
   * mid-phrase. Two also degrades honestly — when the control plane does not
   * answer, the two measured figures are withheld and the two architectural
   * ones still fill the block rather than leaving a gap where numbers should be.
   */
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    margin-block: var(--space-8) var(--space-6);
  }

  @media (min-width: 900px) {
    .metrics {
      margin-block-start: var(--space-2);
    }
  }

  .metric dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-block-end: var(--space-2);
  }

  /* The metric tier: mono, tabular so a changing figure does not reflow. */
  .metric dd {
    font-family: var(--font-mono);
    font-size: var(--text-metric);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin: 0;
    color: var(--text);
  }

  .unit {
    font-size: 0.45em;
    color: var(--text-muted);
    margin-inline-start: 0.15em;
  }

  /* Inside the <dd>, so it needs to become its own line. */
  .qualifier {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-block-start: var(--space-2);
  }

  /*
   * The trace sits between the figures and the prose, so the panel reads
   * top-to-bottom as: what this is, what it measures, what it looks like, what
   * it means. The canvas is fluid and short — a signal strip, not a chart with
   * axes and furniture it does not need.
   */
  .trace {
    margin: 0 0 var(--space-6);
  }

  .trace canvas {
    display: block;
    width: 100%;
    height: 60px;
    /* The line is drawn at 1200x120 and scaled, so it stays crisp on any
       display without measuring the element or handling resize. */
  }

  @media (min-width: 768px) {
    .trace canvas {
      height: 76px;
    }
  }

  .trace figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-block-start: var(--space-3);
  }

  .panel-copy {
    color: var(--text-muted);
    max-width: 62ch;
    margin-block-end: var(--space-8);
  }

  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .panel-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
  }
</style>

<script>
  /*
   * Progressive enhancement, and nothing more.
   *
   * Two GET requests, both same-origin. Deliberately NOT a provisioning call:
   * POST /v1/tenants is rate limited to ten an hour per address by design, and
   * spending that budget on everyone who loads the homepage would exhaust the
   * demonstration for the people who actually came to use it.
   *
   * If either call fails the panel says the plane is not answering. It never
   * shows a stale or invented figure, and the route into /live/ keeps working
   * either way — the live surface has its own degraded mode and will explain
   * itself far better than a homepage tile could.
   */
  const frame = document.querySelector<HTMLElement>('[data-live-panel]');
  if (frame) {
    const statusText = frame.querySelector<HTMLElement>('[data-live-status-text]');
    const show = (name: string, value: string) => {
      const box = frame.querySelector<HTMLElement>(`[data-metric="${name}"]`);
      const slot = box?.querySelector<HTMLElement>('[data-metric-value]');
      if (!box || !slot) return;
      slot.textContent = value;
      box.hidden = false;
    };

    /* ---- the trace ------------------------------------------------- */

    const samples: number[] = [];
    const figure = frame.querySelector<HTMLElement>('[data-trace]');
    const canvas = frame.querySelector<HTMLCanvasElement>('[data-trace-canvas]');
    const caption = frame.querySelector<HTMLElement>('[data-trace-caption]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /*
     * BARS, NOT A LINE, AND THAT IS A CORRECTNESS DECISION.
     *
     * These are discrete samples taken seconds apart. A connected curve would
     * assert that the latency travelled continuously between them, which is
     * not something anybody measured — the same objection this project raises
     * against drawing an unmeasured packet as a fast one. Bars state exactly
     * what is known: twelve measurements, each its own height, nothing implied
     * in between.
     *
     * It also reads better, because the honest shape of a real connection is a
     * tall cold first request followed by a steady run, and that story is
     * invisible in a flat line.
     */
    const draw = () => {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const { width: w, height: h } = canvas;
      ctx.clearRect(0, 0, w, h);
      if (samples.length === 0) return;

      const pad = 8;
      const peak = Math.max(...samples, 1);
      const slots = 12;
      const slot = (w - pad * 2) / slots;
      const barWidth = Math.max(4, slot * 0.42);
      const floor = h - pad;
      // A minimum height so the smallest sample is still a mark rather than
      // nothing: a measurement that happened should be visible.
      const heightFor = (v: number) => Math.max(3, (v / peak) * (h - pad * 2));

      samples.forEach((v, i) => {
        const x = pad + slot * i + (slot - barWidth) / 2;
        const barHeight = heightFor(v);
        const isLast = i === samples.length - 1;

        /*
         * The most recent sample is the accent; the history behind it recedes.
         * One hue, two weights — no new colour is introduced.
         *
         * 0.48, not the 0.34 this started at: every bar is a measurement a
         * reader is meant to compare, which makes them meaningful graphics
         * under WCAG 1.4.11 and puts a 3:1 floor on them. 0.34 measured 2.26:1
         * against this panel and failed it; 0.48 clears it with margin.
         */
        ctx.fillStyle = isLast ? '#4ade80' : 'rgba(74, 222, 128, 0.48)';
        ctx.beginPath();
        ctx.roundRect(x, floor - barHeight, barWidth, barHeight, 2);
        ctx.fill();
      });

      // A baseline, so the bars sit on something and the strip reads as an
      // instrument rather than as floating marks.
      // 0.58 for the same 3:1 reason: the baseline is what the bar heights are
      // read against, so it is part of the information, not decoration.
      ctx.strokeStyle = 'rgba(154, 163, 178, 0.58)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(pad, floor + 0.5);
      ctx.lineTo(w - pad, floor + 0.5);
      ctx.stroke();
    };

    /** One honest measurement: the full round trip, as the browser saw it. */
    const sample = async (): Promise<number> => {
      const started = performance.now();
      const response = await fetch('/health', { cache: 'no-store' });
      const rtt = Math.round(performance.now() - started);
      if (!response.ok) throw new Error('health');
      return rtt;
    };

    void (async () => {
      try {
        const first = await sample();

        frame.dataset.state = 'live';
        if (statusText) statusText.textContent = 'Live · control plane responding';
        show('latency', String(first));
        samples.push(first);
        if (figure) figure.hidden = false;
        draw();

        const catalogue = await fetch('/v1/demonstrations', { cache: 'no-store' });
        if (catalogue.ok) {
          const body = (await catalogue.json()) as { demonstrations?: unknown[] };
          if (Array.isArray(body.demonstrations)) {
            show('demos', String(body.demonstrations.length));
          }
        }

        /*
         * A BOUNDED number of further samples, and then it stops for good.
         * Twelve is enough for the shape of the connection to appear and few
         * enough that a page left open costs the control plane nothing. Under
         * reduced motion the trace is not animated into being at all — the
         * first measurement is drawn and left alone.
         */
        if (still) {
          if (caption) {
            caption.textContent = `Round trip to the control plane: ${first}ms, measured from your browser.`;
          }
          return;
        }

        const target = 12;
        while (samples.length < target) {
          await new Promise((resolve) => setTimeout(resolve, 1400));
          try {
            const next = await sample();
            samples.push(next);
            show('latency', String(next));
            draw();
          } catch {
            // A failed sample is real information: stop, and let the caption
            // say how many were taken rather than silently padding the line.
            break;
          }
        }

        if (caption) {
          const best = Math.min(...samples);
          const worst = Math.max(...samples);
          caption.textContent =
            `${samples.length} round trips to the control plane, measured from your browser — ` +
            `${best}ms best, ${worst}ms worst. Sampling stopped.`;
        }
      } catch {
        // Principle 12: degraded says so. The panel does not pretend.
        frame.dataset.state = 'down';
        if (statusText) statusText.textContent = 'Control plane not answering right now';
      }
    })();
  }
</script>
