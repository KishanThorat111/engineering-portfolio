---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, STATUS_CHIPS } from '../config/site';

// Home in Phase 1 is the hero only — claim, sub-line, status chips
// (blueprint §1 locked wording). The remaining five Home sections ship in
// Phase 3 from content collections.
const title = `${SITE.name} — ${SITE.claim}`;
---

<BaseLayout title={title} description={SITE.subline}>
  <section class="hero">
    <div class="container">
      <p class="kicker">{SITE.role}</p>
      <h1>{SITE.claim}</h1>
      <p class="subline">{SITE.subline}</p>
      <ul class="status-chips">
        {STATUS_CHIPS.map((chip) => <li>{chip}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-12);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-24) var(--space-16);
    }
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-block-end: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
    max-width: 22ch;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: var(--text-3xl);
    }
  }

  .subline {
    margin-block-start: var(--space-6);
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--text-md);
  }

  .status-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0 0;
    padding: 0;
  }

  .status-chips li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    background: var(--bg-raised);
    border: var(--border-width) solid var(--border);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
  }
</style>
