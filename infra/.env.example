# Template for infra/.env on the VM. COPY IT, FILL IT, NEVER COMMIT IT.
#
# infra/.env is gitignored. Secrets reach the VM through the deploy workflow's
# GitHub Actions secrets, which write this file at release time — see
# .github/workflows/deploy-api.yml. Nothing here is ever in git history.
#
# Generate each secret with:  openssl rand -base64 36

# --- Postgres -----------------------------------------------------------
# The ADMIN identity. Owns the schema, runs migrations, never serves traffic.
POSTGRES_USER=cpadmin
POSTGRES_PASSWORD=
POSTGRES_DB=control_plane

# The APPLICATION identity's password. This is the role the API and worker
# connect as: no BYPASSRLS, not the table owner, subject to every policy.
APP_DB_PASSWORD=

# --- Application --------------------------------------------------------
# Salts client addresses before they reach an audit row. Without it the API
# refuses to boot in production, because an unsalted address hash is personal
# data wearing a disguise.
IP_HASH_PEPPER=

# Guards the administrative purge trigger. That endpoint is a debugging aid;
# the scheduled worker is what actually runs the lifecycle.
ADMIN_TOKEN=

# --- P2, the proof engine ----------------------------------------------
# HMAC secret for the payments demonstration. Real signature verification with
# timingSafeEqual; a demonstration of payment security that skipped it would be
# demonstrating its absence.
PAYMENT_WEBHOOK_SECRET=

# Signs the session-receipt permalink (A14). Stateless, so a receipt keeps
# rendering after the tenant's data is purged — which is the point.
RECEIPT_SIGNING_KEY=

# The model plane. Leave BLANK and the AI station reports honestly that no
# provider is configured; the routing decision, token accounting, span, and
# audit record are real either way. It never invents an answer.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=unconfigured
# The estate-wide daily ceiling. Per-tenant budgets stop one visitor exhausting
# the estate; this stops the estate exhausting the wallet.
MODEL_DAILY_TOKEN_CEILING=200000

# --- P3, the live spine -------------------------------------------------
# Bounded because every visitor can open a socket and this is one VM. When a
# ceiling is reached the gateway says so rather than accepting a connection it
# cannot serve.
LIVE_MAX_CONNECTIONS=200
LIVE_MAX_CONNECTIONS_PER_ADDRESS=4

LOG_LEVEL=info
TENANT_TTL_SECONDS=1800
PURGE_INTERVAL_MS=15000
OTEL_ENABLED=true

# --- Cloudflare ---------------------------------------------------------
# From the Zero Trust dashboard: Networks → Tunnels → your tunnel → token.
# This is what lets the VM be reachable with no inbound port open.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Release ------------------------------------------------------------
# Written by the deploy workflow. Pinning a digest rather than a tag is what
# makes rollback exact: `latest` is not a version.
API_IMAGE=ghcr.io/kishanthorat111/control-plane-api:sha-0000000
APP_VERSION=0.0.0-dev
