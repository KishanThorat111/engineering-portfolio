# Dependencies and build output
node_modules/
dist/
.astro/

# Wrangler's local working directory — deployment CONFIG is committed
# (wrangler.jsonc); this is scratch state and must never be.
.wrangler/

# Logs
npm-debug.log*

# Environment. infra/.env holds the VM's real secrets and is written by the
# deploy workflow at release time; infra/.env.example is the committed template.
.env
.env.*
!.env.example
!infra/.env.example
infra/.previous-image
infra/.current-image

# OS noise
.DS_Store
Thumbs.db

# Test output, captured every run so an intermittent failure is diagnosable.
services/api/test-output.log
